WorldConfig.IslandById = {}
WorldConfig.IslandsByRealm = {}
for _, isl in ipairs(WorldConfig.Islands) do
    WorldConfig.IslandById[isl.Id] = isl
    WorldConfig.IslandsByRealm[isl.RealmId] = WorldConfig.IslandsByRealm[isl.RealmId] or {}
    table.insert(WorldConfig.IslandsByRealm[isl.RealmId], isl)
end

