	CelestialGold = Color3.fromHex("#D7B979"),
	TextPrimary = Color3.fromHex("#F5F7FB"),
	TextMuted = Color3.fromHex("#A9B5C7"),
	HPRed = Color3.fromHex("#D45760"),
	EnergyBlue = Color3.fromHex("#3798D8"),
	Success = Color3.fromHex("#44C98A"),
	Warning = Color3.fromHex("#F0B347"),
	Danger = Color3.fromHex("#F26A70"),
	EpicPurple = Color3.fromHex("#A778E4"),
}

return ThemeTokens
</ProtectedString></Properties></Item><Item class="Folder" referent="RBXFA69EEF1EA83467C9F75079EB3664F59"><Properties><string name="Name">Types</string></Properties><Item class="ModuleScript" referent="RBX5781F0A124F44E01A293BE9052D75D7B"><Properties><string name="Name">UIState</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — UI Data Contracts &amp; State Normalization
-- Location: ReplicatedStorage/SkybreakShared/Types/UIState.lua
-- Enforces strict separation between Server-Authoritative PlayerSnapshot and Local Client ViewState.

local RarityConfig = require(script.Parent.Parent.Config.RarityConfig)
local WorldConfig = require(script.Parent.Parent.Config.WorldConfig)

local UIState = {}

UIState.Screens = {
    MainMenu = "MainMenu",
    HUD = "HUD",
    Inventory = "Inventory",
    Skills = "Skills",
    Fruits = "Fruits",
    WorldMap = "WorldMap",
    QuestJournal = "QuestJournal",
    Forge = "Forge",
    Raid = "Raid",
    Dialogue = "Dialogue",
    Settings = "Settings",
}

-- Map legacy Interface.lua page names to canonical ScreenRouter screen IDs
UIState.LegacyPageMap = {
    Menu = "MainMenu",
    HOME = "MainMenu",
    MainMenu = "MainMenu",
    HUD = "HUD",
    Inventory = "Inventory",
    INVENTORY = "Inventory",
    Classes = "Skills",
    Skills = "Skills",
    Fruits = "Fruits",
    SKILLS = "Skills",
    Fruits = "Fruits",
    FRUITS = "Fruits",
    Map = "WorldMap",
    ["WORLD MAP"] = "WorldMap",
    WorldMap = "WorldMap",
    Quests = "QuestJournal",
    QUESTS = "QuestJournal",
    QuestJournal = "QuestJournal",
    Forge = "Forge",
    FORGE = "Forge",
    Raid = "Raid",
    RAID = "Raid",
    Settings = "Settings",
    SETTINGS = "Settings",
}

function UIState.CreateDefaultSnapshot(isDemoMode)
    local demo = isDemoMode ~= false
    return {
        isDemoMode = demo,
        saveStatus = demo and "DEMO MODE • Client Preview (Server syncs on Play)" or "Connecting to server...",
        player = {
            level = demo and 24 or 1,
            exp = demo and 12450 or 0,
            expToNext = demo and 20000 or 115,
            classId = "SkyGuardian",
            gender = "Male",
            outfitStage = "SkyGuardian",
        },
        vitals = {
            hp = demo and 320 or 150,
            maxHp = demo and 320 or 150,
            energy = demo and 85 or 0,
            maxEnergy = 100,
            stamina = 100,
            maxStamina = 100,
            shieldRemaining = 0,
        },
        currency = {
            gold = demo and 4520 or 300,
