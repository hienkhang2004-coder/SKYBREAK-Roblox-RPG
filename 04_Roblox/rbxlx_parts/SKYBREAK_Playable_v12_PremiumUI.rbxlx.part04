    ZiolesGachaShrine=true,AetherShrinesAndRaidConsole=true,
    KaelWorkstation=true,AncientAetherFruitTrees=true,
    CelestialAetherGalleon=true,CyberEnforcerShip=true,LeviathanHunterShip=true,
