      </Item>
    <Item class="Folder" referent="RBX5DBF5C704FB64F029AC3CA295CE7553B"><Properties><string name="Name">SkybreakClient</string></Properties><Item class="LocalScript" referent="RBX68CB62D34B084347802D2014E8156CC9"><Properties><string name="Name">Main</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Modular Client UI Bootstrap
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/Main.client.lua
-- Initializes the modular SkybreakUI system and connects to server remotes when present.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIFolder = script.Parent:WaitForChild("UI")
local App = require(UIFolder:WaitForChild("App"))
local Store = require(UIFolder:WaitForChild("Store"))

-- Initialize the ScreenGui &amp; modular router (Idempotent if already initialized by ClientBootstrap)
App.Init()

-- Listen for optional SkybreakShared Remotes (UIStateUpdated / GetPlayerSnapshot)
task.spawn(function()
    local shared = ReplicatedStorage:WaitForChild("SkybreakShared", 5)
    local sharedRemotes = shared and shared:FindFirstChild("Remotes")
    if sharedRemotes then
        local stateUpdated = sharedRemotes:FindFirstChild("UIStateUpdated")
        if stateUpdated and stateUpdated:IsA("RemoteEvent") then
            stateUpdated.OnClientEvent:Connect(function(payload)
                if type(payload) == "table" then
                    if payload.State then
                        App.SetState(payload.State)
                    end
                    if payload.Toast then
                        Store.ShowToast(payload.Toast.message or payload.Toast, payload.Toast.kind or "info")
                    end
                end
            end)
        end

        local getSnapshot = sharedRemotes:FindFirstChild("GetPlayerSnapshot")
        if getSnapshot and getSnapshot:IsA("RemoteFunction") then
            local ok, snapshot = pcall(function()
                return getSnapshot:InvokeServer()
            end)
            if ok and type(snapshot) == "table" then
                App.SetState(snapshot)
            end
        end
    end

    -- Also listen to legacy ReplicatedStorage.Remotes.StateUpdate if ClientBootstrap hasn't already
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes then
        local stateUpdate = remotes:FindFirstChild("StateUpdate")
        if stateUpdate and stateUpdate:IsA("RemoteEvent") then
            stateUpdate.OnClientEvent:Connect(function(payload)
                if type(payload) == "table" and payload.State and not App.State then
                    App.SetState(payload.State)
                end
            end)
        end
    end

    local player = Players.LocalPlayer
    if player then
        player:GetAttributeChangedSignal("CurrentRealm"):Connect(function()
            local realm = player:GetAttribute("CurrentRealm")
            if realm then
                local snap = Store.GetSnapshot()
                snap.world.current = realm
                App.Render()
            end
        end)
    end
end)
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX6131311390BF4D28A4B92E902DFBC424"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX4128A6D1F0094A98ABCDA1505EF072A5"><Properties><string name="Name">Animations</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Motion &amp; Micro-Interaction Controller
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Animations.lua
-- Respects Reduced Motion accessibility setting and prevents tween leaks when closing screens.

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))
local UIAnimator = require(Shared:WaitForChild("UIAnimator"))
local SpritePlayer = require(Shared:WaitForChild("SpritePlayer"))

local Animations = {
    ReducedMotion = false,
    ActiveTweens = {},
}

function Animations.SetReducedMotion(enabled)
    Animations.ReducedMotion = enabled == true
    UIAnimator.ReducedMotion = enabled == true
    if Animations.ReducedMotion then
        Animations.CleanupScope("Ambient")
        SpritePlayer.StopAll()
    end
end

function Animations.Play(instance, duration, goal, easingStyle, easingDirection, scope)
    if not instance then
        return nil
    end
    if Animations.ReducedMotion or (duration or 0) &lt;= 0 then
        for prop, val in pairs(goal) do
            pcall(function()
                instance[prop] = val
            end)
        end
        return nil
    end

    local info = TweenInfo.new(
        duration or Theme.Motion.Hover,
        easingStyle or Enum.EasingStyle.Quad,
        easingDirection or Enum.EasingDirection.Out
    )
    local ok, tween = pcall(function()
        return TweenService:Create(instance, info, goal)
    end)
    if not ok or not tween then
        for prop, val in pairs(goal) do
            pcall(function()
                instance[prop] = val
            end)
        end
        return nil
    end

    if scope then
        Animations.ActiveTweens[scope] = Animations.ActiveTweens[scope] or {}
        table.insert(Animations.ActiveTweens[scope], tween)
    end

    tween:Play()
    return tween
end

function Animations.TweenBar(fillFrame, ratio, duration, scope)
    local clamped = math.clamp(tonumber(ratio) or 0, 0, 1)
    return Animations.Play(
        fillFrame,
        duration or Theme.Motion.HP,
        { Size = UDim2.fromScale(clamped, 1) },
        Enum.EasingStyle.Quint,
        Enum.EasingDirection.Out,
        scope
    )
end

function Animations.FadeInPanel(frame, targetPos, duration, scope)
    if not frame then
        return
    end
    targetPos = targetPos or frame.Position
    if Animations.ReducedMotion then
        frame.Position = targetPos
        return
    end
    frame.Position = UDim2.new(
        targetPos.X.Scale,
        targetPos.X.Offset,
        targetPos.Y.Scale,
        targetPos.Y.Offset + 14
    )
    Animations.Play(
        frame,
        duration or Theme.Motion.Open,
        { Position = targetPos },
        Enum.EasingStyle.Quart,
        Enum.EasingDirection.Out,
        scope
    )
end

function Animations.Tween(instance, presetOrDuration, goal, scope)
    local dur = type(presetOrDuration) == "number" and presetOrDuration or Theme.Motion.Hover
    return Animations.Play(instance, dur, goal, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, scope)
end

function Animations.PulseGlow(instance, scope, propName, minVal, maxVal)
    if not instance or Animations.ReducedMotion then
        return nil
    end
    propName = propName or "BackgroundTransparency"
    local info = TweenInfo.new(2.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
    local ok, tween = pcall(function()
        return TweenService:Create(instance, info, { [propName] = maxVal or 0.5 })
    end)
    if ok and tween then
        local targetScope = scope or "Ambient"
        Animations.ActiveTweens[targetScope] = Animations.ActiveTweens[targetScope] or {}
        table.insert(Animations.ActiveTweens[targetScope], tween)
        tween:Play()
        return tween
    end
    return nil
end

function Animations.CleanupScope(scope)
    local list = Animations.ActiveTweens[scope]
    if not list then
        return
    end
    for _, tween in ipairs(list) do
        pcall(function()
            tween:Cancel()
        end)
    end
    Animations.ActiveTweens[scope] = nil
end

function Animations.CleanupAll()
    for scope in pairs(Animations.ActiveTweens) do
        Animations.CleanupScope(scope)
    end
end

return Animations
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX722FA7337EE646649B55BB862FD4D920"><Properties><string name="Name">App</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Unified Modular UI Application Orchestrator
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/App.lua
-- Creates the canonical StarterGui/PlayerGui hierarchy:
-- SkybreakUI (ScreenGui) -&gt; BackgroundLayer, HUDLayer, MenuLayer, ModalLayer, NotificationLayer (Section 05).

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))
local UIState = require(Shared:WaitForChild("Types"):WaitForChild("UIState"))
local PanelMotion = require(Shared:WaitForChild("PanelMotion"))

local UIFactory = require(script.Parent:WaitForChild("UIFactory"))
local Responsive = require(script.Parent:WaitForChild("Responsive"))
local Animations = require(script.Parent:WaitForChild("Animations"))
local Store = require(script.Parent:WaitForChild("Store"))
local ScreenRouter = require(script.Parent:WaitForChild("ScreenRouter"))

local Toast = require(script.Parent:WaitForChild("Components"):WaitForChild("Toast"))
local Modal = require(script.Parent:WaitForChild("Components"):WaitForChild("Modal"))

local MainMenu = require(script.Parent:WaitForChild("Screens"):WaitForChild("MainMenu"))
local HUD = require(script.Parent:WaitForChild("Screens"):WaitForChild("HUD"))
local Inventory = require(script.Parent:WaitForChild("Screens"):WaitForChild("Inventory"))
local Skills = require(script.Parent:WaitForChild("Screens"):WaitForChild("Skills"))
local Fruits = require(script.Parent:WaitForChild("Screens"):WaitForChild("Fruits"))
local WorldMap = require(script.Parent:WaitForChild("Screens"):WaitForChild("WorldMap"))
local QuestJournal = require(script.Parent:WaitForChild("Screens"):WaitForChild("QuestJournal"))
local Forge = require(script.Parent:WaitForChild("Screens"):WaitForChild("Forge"))
local Raid = require(script.Parent:WaitForChild("Screens"):WaitForChild("Raid"))
local Dialogue = require(script.Parent:WaitForChild("Screens"):WaitForChild("Dialogue"))
local Settings = require(script.Parent:WaitForChild("Screens"):WaitForChild("Settings"))

local HUDController = require(script.Parent:WaitForChild("Controllers"):WaitForChild("HUDController"))
local QuestController = require(script.Parent:WaitForChild("Controllers"):WaitForChild("QuestController"))

local App = {
    Initialized = false,
    Page = "HUD",
    Current = "HUD",
    LowFX = false,
    State = nil,
    ScreenGui = nil,
    Layers = {},
    ToastApi = nil,
    ModalApi = nil,
    DialogueApi = nil,
    Connections = {},
}

local SCREEN_MODULES = {
    [UIState.Screens.MainMenu] = MainMenu,
    [UIState.Screens.HUD] = HUD,
    [UIState.Screens.Inventory] = Inventory,
    [UIState.Screens.Skills] = Skills,
    [UIState.Screens.Fruits] = Fruits,
    [UIState.Screens.WorldMap] = WorldMap,
    [UIState.Screens.QuestJournal] = QuestJournal,
    [UIState.Screens.Forge] = Forge,
    [UIState.Screens.Raid] = Raid,
    [UIState.Screens.Settings] = Settings,
}

for id, mod in pairs(SCREEN_MODULES) do
    ScreenRouter.RegisterScreen(id, mod)
end

function App.GetResponsiveState()
    local gui = App.ScreenGui
    local absSize = (gui and gui.AbsoluteSize.X &gt; 0) and gui.AbsoluteSize or Vector2.new(1366, 768)
    local view = Store.GetView()
    local s = view.settings or {}
    return Responsive.GetState(absSize, s.layoutMode or "Auto", s.textScale or 1.0)
end

function App.RebuildActiveScreen()
    if not App.ScreenGui then
        return
    end
    local resp = App.GetResponsiveState()
    local activeRoute = ScreenRouter.CurrentScreen

    local bgTint = App.Layers.BackgroundTint
    if bgTint then
        bgTint.BackgroundTransparency = (activeRoute == UIState.Screens.HUD) and 1
            or (activeRoute == UIState.Screens.MainMenu and 0.14 or 0.08)
    end

    local blur = Lighting:FindFirstChild("SkybreakMenuBlur")
        or UIFactory.Create("BlurEffect", Lighting, { Name = "SkybreakMenuBlur", Size = 0 })
    blur.Size = (activeRoute == UIState.Screens.HUD) and 0 or 12

    local hudCanvas = App.Layers.HUDCanvas
    local menuCanvas = App.Layers.MenuCanvas
    if hudCanvas and menuCanvas then
        hudCanvas.Size = resp.CanvasSize
        menuCanvas.Size = resp.CanvasSize
        if App.Layers.HUDScale then
            App.Layers.HUDScale.Scale = resp.UIScale
        end
        if App.Layers.MenuScale then
            App.Layers.MenuScale.Scale = resp.UIScale
        end
    end

    -- Clear previous menu screen children
    if menuCanvas then
        for _, child in ipairs(menuCanvas:GetChildren()) do
            if child:IsA("GuiObject") then
                child:Destroy()
            end
        end
    end
    if hudCanvas then
        for _, child in ipairs(hudCanvas:GetChildren()) do
            if child:IsA("GuiObject") then
                child:Destroy()
            end
        end
    end

    if activeRoute == UIState.Screens.HUD then
        App.Layers.HUDLayer.Visible = true
        App.Layers.MenuLayer.Visible = false
        HUD.Build(hudCanvas, resp)
    else
        App.Layers.HUDLayer.Visible = false
        App.Layers.MenuLayer.Visible = true
        local mod = SCREEN_MODULES[activeRoute] or MainMenu
        local builtFrame = mod.Build(menuCanvas, resp)
        if activeRoute == UIState.Screens.MainMenu or activeRoute == UIState.Screens.Forge or activeRoute == UIState.Screens.Settings then
            local closeBtn = UIFactory.Create("TextButton", menuCanvas, {
                Name = "FloatingResumeBtn",
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -12, 0, 8),
                Size = UDim2.fromOffset(146, 34),
                BackgroundColor3 = Theme.Colors.BG_800,
                BorderSizePixel = 0,
                Text = "✕ RESUME [ESC]",
                Font = Theme.Fonts.Bold,
                TextSize = 12,
                TextColor3 = Theme.Colors.ACCENT_GOLD,
                ZIndex = 40,
            })
            UIFactory.Corner(closeBtn, Theme.Radius.Small)
            UIFactory.Stroke(closeBtn, Theme.Colors.ACCENT_GOLD, 1.4, 0.15)
            closeBtn.Activated:Connect(function()
                ScreenRouter.CloseAllToHUD()
            end)
        end
        PanelMotion.Open(App.Layers.MenuLayer)
        Animations.FadeInPanel(builtFrame, builtFrame.Position, Theme.Motion.Open, "Screen_" .. tostring(activeRoute))
    end
end

function App.Init(onAction, onAttack)
    HUDController.SetCombatCallbacks(onAction, onAttack)
    if App.Initialized and App.ScreenGui and App.ScreenGui.Parent then
        return App
    end
    App.Initialized = true

    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")

    -- Prevent duplicate ScreenGuis on respawn or reload (Section 15 Rule 3)
    for _, existingName in ipairs({ "SkybreakUI", "SKYBREAK", "SkybreakPremiumUI" }) do
        local old = playerGui:FindFirstChild(existingName)
        if old then
            old:Destroy()
        end
    end

    local gui = UIFactory.Create("ScreenGui", playerGui, {
        Name = "SkybreakUI",
        ResetOnSpawn = false,
        DisplayOrder = 25,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
    })
    App.ScreenGui = gui

    -- 5 Canonical Layers (Section 05)
    local bgLayer = UIFactory.Create("Frame", gui, {
        Name = "BackgroundLayer",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ZIndex = 1,
    })
    local bgTint = UIFactory.Create("Frame", bgLayer, {
        Name = "Backdrop",
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Theme.Colors.BG_900,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    })
    UIFactory.Gradient(bgTint, Color3.fromRGB(16, 32, 56), Theme.Colors.BG_900, 70)

    local hudLayer = UIFactory.Create("Frame", gui, {
        Name = "HUDLayer",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Visible = false,
        ZIndex = 5,
    })
    local hudCanvas = UIFactory.Create("Frame", hudLayer, {
        Name = "Canvas",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(1366, 768),
        BackgroundTransparency = 1,
    })
    local hudScale = UIFactory.Create("UIScale", hudCanvas, { Scale = 1 })

    local menuLayer = UIFactory.Create("CanvasGroup", gui, {
        Name = "MenuLayer",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        GroupTransparency = 0,
        Visible = true,
        ZIndex = 10,
    })
    local menuCanvas = UIFactory.Create("Frame", menuLayer, {
        Name = "Canvas",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(1366, 768),
        BackgroundTransparency = 1,
    })
    local menuScale = UIFactory.Create("UIScale", menuCanvas, { Scale = 1 })

    local modalLayer = UIFactory.Create("Frame", gui, {
        Name = "ModalLayer",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ZIndex = 30,
    })

    local notificationLayer = UIFactory.Create("Frame", gui, {
        Name = "NotificationLayer",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ZIndex = 50,
    })

    local _, dialogueApi = Dialogue.CreateOverlay(modalLayer)
    local _, modalApi = Modal.Create(modalLayer, { name = "ConfirmModal", visible = false })
    local _, toastApi = Toast.Create(notificationLayer, { name = "Toast" })

    App.Layers = {
        BackgroundLayer = bgLayer,
        BackgroundTint = bgTint,
        HUDLayer = hudLayer,
        HUDCanvas = hudCanvas,
        HUDScale = hudScale,
        MenuLayer = menuLayer,
        MenuCanvas = menuCanvas,
        MenuScale = menuScale,
        ModalLayer = modalLayer,
        NotificationLayer = notificationLayer,
    }
    App.DialogueApi = dialogueApi
    App.ModalApi = modalApi
    App.ToastApi = toastApi

    Settings.OnLowFXChanged = function(val)
        App.LowFX = val
    end

    ScreenRouter.OnRouteChanged = function(newRoute)
        App.Page = (newRoute == UIState.Screens.MainMenu and "Menu")
            or (newRoute == UIState.Screens.WorldMap and "Map")
            or (newRoute == UIState.Screens.QuestJournal and "Quests")
            or newRoute
        App.Current = App.Page
        App.RebuildActiveScreen()
    end

    Store.SubscribeSnapshot(function(snap)
        local activeRoute = ScreenRouter.CurrentScreen
        if activeRoute == UIState.Screens.HUD then
            HUD.Update(snap, Store.GetView())
        elseif activeRoute == UIState.Screens.MainMenu then
            MainMenu.Update(snap)
        elseif activeRoute == UIState.Screens.Inventory then
            Inventory.Update(snap)
        elseif activeRoute == UIState.Screens.Fruits then
            Fruits.Update()
        end
    end)

    Store.SubscribeView(function(view)
        if App.ModalApi then
            App.ModalApi:Update(view.modal)
        end
        if App.DialogueApi then
            App.DialogueApi:Update(view.dialogue)
        end
        if ScreenRouter.CurrentScreen == UIState.Screens.HUD then
            HUD.Update(Store.GetSnapshot(), view)
        elseif ScreenRouter.CurrentScreen == UIState.Screens.Forge then
            Forge.Update()
        elseif ScreenRouter.CurrentScreen == UIState.Screens.Settings then
            App.RebuildActiveScreen()
        end
    end)

    Store.SubscribeToast(function(toastPayload)
        if App.ToastApi then
            App.ToastApi:Show(toastPayload.message, toastPayload.kind, toastPayload.duration)
        end
    end)

    -- Viewport resize listener (debounced)
    local resizePending = false
    table.insert(App.Connections, gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        if resizePending then
            return
        end
        resizePending = true
        task.delay(0.15, function()
            resizePending = false
            App.RebuildActiveScreen()
        end)
    end))

    -- External deterministic screen request bridge (used by tutorials, prompts, and automated tests)
    table.insert(App.Connections, gui:GetAttributeChangedSignal("RequestScreen"):Connect(function()
        local req = gui:GetAttribute("RequestScreen")
        if type(req) == "string" and #req &gt; 0 then
            gui:SetAttribute("RequestScreen", "")
            if req == "HUD" or req == "Close" then
                ScreenRouter.CloseAllToHUD()
            else
                ScreenRouter.Navigate(req)
            end
        end
    end))

    -- Keyboard &amp; Gamepad Navigation Shortcuts (Escape, G, I, K, M, J, O, F, P)
    table.insert(App.Connections, UserInputService.InputBegan:Connect(function(input, processed)
        if UserInputService:GetFocusedTextBox() then
            return
        end
        if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
            ScreenRouter.Back()
            return
        end
        local shiftDown = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
        local ctrlDown = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
        if input.KeyCode == Enum.KeyCode.G then
            ScreenRouter.ToggleScreen(UIState.Screens.Fruits)
            return
        elseif input.KeyCode == Enum.KeyCode.K then
            ScreenRouter.ToggleScreen(UIState.Screens.Skills)
            return
        elseif input.KeyCode == Enum.KeyCode.I then
            ScreenRouter.ToggleScreen(UIState.Screens.Inventory)
            return
        elseif input.KeyCode == Enum.KeyCode.M then
            ScreenRouter.ToggleScreen(UIState.Screens.WorldMap)
            return
        elseif (input.KeyCode == Enum.KeyCode.J and not ctrlDown) or input.KeyCode == Enum.KeyCode.L then
            ScreenRouter.ToggleScreen(UIState.Screens.QuestJournal)
            return
        elseif input.KeyCode == Enum.KeyCode.O then
            ScreenRouter.ToggleScreen(UIState.Screens.Settings)
            return
        elseif input.KeyCode == Enum.KeyCode.F and not shiftDown then
            ScreenRouter.ToggleScreen(UIState.Screens.Forge)
            return
        elseif input.KeyCode == Enum.KeyCode.P then
            ScreenRouter.ToggleScreen(UIState.Screens.Raid)
            return
        end
        if processed then
            return
        end
        if input.KeyCode == Enum.KeyCode.Space then
            local v = Store.GetView()
            if v.dialogue and v.dialogue.visible then
                local cmd = v.dialogue.actionCommand
                QuestController.CloseDialogue()
                if type(cmd) == "string" and cmd:sub(1, 11) == "OpenScreen:" then
                    ScreenRouter.Navigate(cmd:sub(12))
                end
            end
        end
    end))

    -- Periodic cooldown &amp; shield ticker for HUD
    task.spawn(function()
        while gui and gui.Parent do
            task.wait(0.1)
            if ScreenRouter.CurrentScreen == UIState.Screens.HUD then
                HUD.Update(Store.GetSnapshot(), Store.GetView())
            end
        end
    end)

    App.RebuildActiveScreen()
    return App
end

-- Backward-compatible methods used by ClientBootstrap.client.lua
function App.Show(page)
    ScreenRouter.Navigate(page)
end

function App.Build()
    App.RebuildActiveScreen()
end

function App.Render()
    local snap = Store.GetSnapshot()
    if ScreenRouter.CurrentScreen == UIState.Screens.HUD then
        HUD.Update(snap, Store.GetView())
    elseif ScreenRouter.CurrentScreen == UIState.Screens.MainMenu then
        MainMenu.Update(snap)
    elseif ScreenRouter.CurrentScreen == UIState.Screens.Inventory then
        Inventory.Update(snap)
    end
end

function App.SetInteract(text)
    Store.SetView({ interactPrompt = text })
end

function App.SetLockTarget(targetName)
    Store.SetView({ lockTarget = targetName })
end

function App.Toast(message, kind)
    if type(message) == "string" and #message &gt; 0 then
        Store.ShowToast(message, kind or "info", 2.8)
    end
end

function App.CyclePartySize()
    ScreenRouter.ToggleScreen(UIState.Screens.Raid)
end

function App.BlocksCombat()
    return ScreenRouter.BlocksCombat()
end

function App.OpenDialogue(d)
    if type(d) == "table" then
        QuestController.OpenDialogue(d.speaker, d.text, d.role, d.questId, d.actionLabel, d.actionCommand)
    end
end

function App.Message(message)
    if type(message) ~= "string" then
        return
    end
    if string.sub(message, 1, 5) == "Lyra:" or string.sub(message, 1, 5) == "Kael:" then
        local speaker = string.sub(message, 1, 5) == "Kael:" and "KAEL • CELESTIAL FORGE" or "LYRA • SKY HUB"
        local role = string.sub(message, 1, 5) == "Kael:" and "Master Blacksmith" or "Lorekeeper of the Core"
        QuestController.OpenDialogue(speaker, message, role)
    else
        Store.ShowToast(message, "info", 3.5)
    end
end

function App.SetState(rawState)
    local previous = App.State
    App.State = rawState
    local player = Players.LocalPlayer
    local realmAttr = player and player:GetAttribute("CurrentRealm") or "GoldenSky"
    Store.SetServerSnapshot(rawState, realmAttr)

    if previous and (previous.ClassId ~= rawState.ClassId or previous.Gender ~= rawState.Gender) then
        App.RebuildActiveScreen()
    end
end

return App
</ProtectedString></Properties></Item><Item class="Folder" referent="RBXEB7CC0217279438CA24D2698FF03B12C"><Properties><string name="Name">Components</string></Properties><Item class="ModuleScript" referent="RBXF9EC341198094292A437DE7C25ECADD0"><Properties><string name="Name">ItemSlot</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Inventory &amp; Equipment Item Slot Component
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Components/ItemSlot.lua

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))
local RarityConfig = require(Shared:WaitForChild("Config"):WaitForChild("RarityConfig"))

local UIFactory = require(script.Parent.Parent:WaitForChild("UIFactory"))
local Animations = require(script.Parent.Parent:WaitForChild("Animations"))

local ItemSlot = {}

function ItemSlot.Create(parent, props)
    props = props or {}
    local itemId = props.itemId
    local itemCfg = itemId and RarityConfig.GetItem(itemId) or nil
    local rarityId = props.rarity or (itemCfg and itemCfg.Rarity) or "Common"
    local rarity = RarityConfig.GetRarity(rarityId)
    local isSelected = props.selected == true
    local isEquipped = props.equipped == true
    local count = tonumber(props.count) or 0
    local upgrade = tonumber(props.upgrade) or 0

    local slotBtn = UIFactory.Create("TextButton", parent, {
        Name = props.name or ("ItemSlot_" .. tostring(itemId or "Empty")),
        Position = props.position or UDim2.fromOffset(0, 0),
        Size = props.size or UDim2.fromOffset(86, 86),
        Text = "",
        BackgroundColor3 = itemCfg and rarity.BackgroundTint or Theme.Colors.BG_900,
        BackgroundTransparency = itemCfg and 0.08 or 0.25,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        LayoutOrder = props.layoutOrder or 0,
        ZIndex = props.zIndex or 5,
    })

    UIFactory.Corner(slotBtn, Theme.Radius.Slot)
    local stroke = UIFactory.Stroke(
        slotBtn,
        itemCfg and (isSelected and Theme.Colors.ACCENT_GOLD or rarity.Color) or Theme.Colors.STROKE_STEEL,
        isSelected and 2.4 or (itemCfg and 1.6 or 1),
        itemCfg and (isSelected and 0.02 or 0.18) or 0.52
    )

    if itemCfg then
        UIFactory.Icon(
            slotBtn,
            itemCfg.Icon or "Sword",
            UDim2.new(0.5, -18, 0.42, -18),
            36,
            rarity.Color
        )

        UIFactory.Label(slotBtn, {
            Name = "ItemName",
            Text = itemCfg.Name,
            Position = UDim2.new(0, 4, 1, -22),
            Size = UDim2.new(1, -8, 0, 18),
            TextSize = 11,
            TextColor = Theme.Colors.TEXT_PRIMARY,
            Bold = true,
            XAlign = Enum.TextXAlignment.Center,
            Truncate = Enum.TextTruncate.AtEnd,
            Wrapped = false,
            ZIndex = slotBtn.ZIndex + 2,
        })

        if count &gt; 1 then
            UIFactory.Label(slotBtn, {
                Name = "StackCount",
                Text = "x" .. tostring(count),
                Position = UDim2.new(0, 4, 0, 4),
                Size = UDim2.new(1, -8, 0, 16),
                TextSize = 12,
                TextColor = Theme.Colors.TEXT_PRIMARY,
                Bold = true,
                XAlign = Enum.TextXAlignment.Right,
                Wrapped = false,
                ZIndex = slotBtn.ZIndex + 3,
            })
        end

        if upgrade &gt; 0 then
            UIFactory.Label(slotBtn, {
                Name = "UpgradeTier",
                Text = "+" .. tostring(upgrade),
                Position = UDim2.fromOffset(6, 4),
                Size = UDim2.fromOffset(32, 16),
                TextSize = 11,
                TextColor = Theme.Colors.ACCENT_GOLD,
                Bold = true,
                XAlign = Enum.TextXAlignment.Left,
                Wrapped = false,
                ZIndex = slotBtn.ZIndex + 3,
            })
        end

        if isEquipped then
            UIFactory.Badge(
                slotBtn,
                "EQ",
                UDim2.new(1, -30, 0, 4),
                UDim2.fromOffset(26, 16),
                Theme.Colors.ACCENT_GOLD,
                Theme.Colors.ACCENT_GOLD
            )
        end
    else
        UIFactory.Label(slotBtn, {
            Name = "EmptySlotLabel",
            Text = props.slotLabel or "+",
            Size = UDim2.fromScale(1, 1),
            TextSize = props.slotLabel and 10 or 24,
            TextColor = Theme.Colors.STROKE_STEEL,
            Bold = true,
            XAlign = Enum.TextXAlignment.Center,
            ZIndex = slotBtn.ZIndex + 1,
        })
    end

    local connections = {}
    table.insert(connections, slotBtn.MouseEnter:Connect(function()
        Animations.Play(slotBtn, Theme.Motion.Hover, { BackgroundTransparency = 0 })
        stroke.Color = Theme.Colors.ACCENT_GOLD
    end))
    table.insert(connections, slotBtn.MouseLeave:Connect(function()
        Animations.Play(slotBtn, Theme.Motion.Hover, { BackgroundTransparency = itemCfg and 0.08 or 0.25 })
        stroke.Color = itemCfg and (isSelected and Theme.Colors.ACCENT_GOLD or rarity.Color) or Theme.Colors.STROKE_STEEL
    end))
    table.insert(connections, slotBtn.Activated:Connect(function()
        if type(props.onSelect) == "function" then
            props.onSelect(itemId, itemCfg)
        end
    end))

    local api = {
        Instance = slotBtn,
        Stroke = stroke,
        ItemId = itemId,
    }

    function api:Update(newState)
        newState = newState or {}
        if newState.selected ~= nil then
            isSelected = newState.selected == true
            stroke.Thickness = isSelected and 2.4 or 1.6
            stroke.Color = isSelected and Theme.Colors.ACCENT_GOLD or rarity.Color
        end
    end

    function api:Destroy()
        for _, c in ipairs(connections) do
            c:Disconnect()
        end
        table.clear(connections)
        if slotBtn and slotBtn.Parent then
            slotBtn:Destroy()
        end
    end

    return slotBtn, api
end

ItemSlot.create = ItemSlot.Create

return ItemSlot
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX416F4DCA568E43509C934F9CE29D7DAC"><Properties><string name="Name">Modal</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Confirmation &amp; Alert Modal Overlay
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Components/Modal.lua

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))

local UIFactory = require(script.Parent.Parent:WaitForChild("UIFactory"))
local PremiumButton = require(script.Parent:WaitForChild("PremiumButton"))

local Modal = {}

function Modal.Create(parent, props)
    props = props or {}
    local colors = Theme.Colors

    local overlay = UIFactory.Create("TextButton", parent, {
        Name = props.name or "ConfirmModalOverlay",
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = colors.BG_900,
        BackgroundTransparency = Theme.Transparency.ModalBackdrop,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Visible = props.visible == true,
        ZIndex = props.zIndex or 40,
    })

    local dialog = UIFactory.Create("Frame", overlay, {
        Name = "ModalDialog",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = props.size or UDim2.fromOffset(440, 230),
        BackgroundColor3 = colors.BG_800,
        BackgroundTransparency = 0.03,
        BorderSizePixel = 0,
        ZIndex = overlay.ZIndex + 1,
    })
    UIFactory.Corner(dialog, Theme.Radius.Large)
    UIFactory.Stroke(dialog, colors.ACCENT_GOLD, 1.8, 0.12)
    UIFactory.Gradient(dialog, colors.BG_700, colors.BG_900, 90)

    local titleLabel = UIFactory.Label(dialog, {
        Name = "ModalTitle",
        Text = props.title or "CONFIRM ACTION",
        Position = UDim2.fromOffset(22, 18),
        Size = UDim2.new(1, -44, 0, 26),
        TextSize = 19,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
        ZIndex = dialog.ZIndex + 2,
    })

    UIFactory.Divider(dialog, UDim2.fromOffset(22, 50), UDim2.new(1, -44, 0, 1), true)

    local contentLabel = UIFactory.Label(dialog, {
        Name = "ModalContent",
        Text = props.content or "",
        Position = UDim2.fromOffset(22, 62),
        Size = UDim2.new(1, -44, 1, -132),
        TextSize = 15,
        TextColor = colors.TEXT_PRIMARY,
        YAlign = Enum.TextYAlignment.Top,
        ZIndex = dialog.ZIndex + 2,
    })

    local currentOnConfirm = props.onConfirm
    local currentOnCancel = props.onCancel

    local _, cancelApi = PremiumButton.Create(dialog, {
        name = "CancelButton",
        label = props.cancelLabel or "CANCEL",
        variant = "secondary",
        position = UDim2.new(0, 22, 1, -58),
        size = UDim2.fromOffset(186, 42),
        zIndex = dialog.ZIndex + 3,
        onActivated = function()
            overlay.Visible = false
            if type(currentOnCancel) == "function" then
                currentOnCancel()
            end
        end,
    })

    local _, confirmApi = PremiumButton.Create(dialog, {
        name = "ConfirmButton",
        label = props.confirmLabel or "CONFIRM",
        variant = props.variant or "primary",
        position = UDim2.new(1, -208, 1, -58),
        size = UDim2.fromOffset(186, 42),
        zIndex = dialog.ZIndex + 3,
        onActivated = function()
            overlay.Visible = false
            if type(currentOnConfirm) == "function" then
                currentOnConfirm()
            end
        end,
    })

    local api = {
        Instance = overlay,
        Dialog = dialog,
    }

    function api:Update(state)
        state = state or {}
        overlay.Visible = state.visible == true
        if state.title then
            titleLabel.Text = state.title
        end
        if state.content then
            contentLabel.Text = state.content
        end
        if state.confirmLabel or state.variant then
            confirmApi:Update({
                label = state.confirmLabel or "CONFIRM",
                variant = state.variant or "primary",
            })
        end
        if state.cancelLabel then
            cancelApi:Update({ label = state.cancelLabel })
        end
        currentOnConfirm = state.onConfirm
        currentOnCancel = state.onCancel
    end

    function api:Destroy()
        cancelApi:Destroy()
        confirmApi:Destroy()
        if overlay and overlay.Parent then
            overlay:Destroy()
        end
    end

    return overlay, api
end

Modal.create = Modal.Create

return Modal
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX1642562827CF403ABC021B7218E3F59B"><Properties><string name="Name">PremiumButton</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Reusable Premium Button Component
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Components/PremiumButton.lua
-- Supports 4 variants ("primary" | "secondary" | "gold" | "danger"), 5 interactive states
-- (Idle, Hover, Pressed,Selected, Disabled), UIScale + UIStroke micro-interactions (Section 07),
-- optional 9-slice ImageButton skinning, and automatic fallback to crisp UIGradient + UIStroke styling.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))
local UIAssets = require(Shared:WaitForChild("Config"):WaitForChild("UIAssets"))
local UIAnimator = require(Shared:WaitForChild("UIAnimator"))
local MotionTokens = require(Shared:WaitForChild("MotionTokens"))

local UIFactory = require(script.Parent.Parent:WaitForChild("UIFactory"))
local Animations = require(script.Parent.Parent:WaitForChild("Animations"))

local PremiumButton = {}

local VARIANT_STYLES = {
    primary = function(colors)
        return {
            bgTop = colors.ACCENT_SAPPHIRE,
            bgBottom = colors.ACCENT_DEEP_BLUE,
            hoverColor = Color3.fromRGB(76, 174, 250),
            pressColor = Color3.fromRGB(34, 96, 158),
            strokeColor = colors.ACCENT_ICE,
            textColor = colors.TEXT_PRIMARY,
            assetKey = "ButtonPrimary",
        }
    end,
    gold = function(colors)
        return {
            bgTop = colors.ACCENT_GOLD,
            bgBottom = Color3.fromRGB(168, 132, 68),
            hoverColor = colors.ACCENT_GOLD_BRIGHT,
            pressColor = Color3.fromRGB(145, 112, 54),
            strokeColor = colors.ACCENT_GOLD_BRIGHT,
            textColor = colors.BG_900,
            assetKey = "ButtonPrimary",
        }
    end,
    secondary = function(colors)
        return {
            bgTop = colors.BG_700,
            bgBottom = colors.BG_800,
            hoverColor = Color3.fromRGB(36, 58, 86),
            pressColor = colors.BG_900,
            strokeColor = colors.STROKE_STEEL,
            textColor = colors.TEXT_PRIMARY,
            assetKey = "ButtonSecondary",
        }
    end,
    danger = function(colors)
        return {
            bgTop = colors.HP_RED,
            bgBottom = Color3.fromRGB(148, 46, 54),
            hoverColor = colors.DANGER,
            pressColor = Color3.fromRGB(124, 36, 44),
            strokeColor = colors.DANGER,
            textColor = colors.TEXT_PRIMARY,
            assetKey = "ButtonDanger",
        }
    end,
}

function PremiumButton.Create(parent, props)
    props = props or {}
    local colors = Theme.Colors
    local variantName = props.variant or "primary"
    local styleBuilder = VARIANT_STYLES[variantName] or VARIANT_STYLES.primary
    local style = styleBuilder(colors)

    local disabled = props.disabled == true
    local selected = props.selected == true
    local scope = props.scope or "Global"

    local btn = UIFactory.Create("TextButton", parent, {
        Name = props.name or "PremiumButton",
        Position = props.position or UDim2.fromOffset(0, 0),
        Size = props.size or UDim2.fromOffset(160, 42),
        AnchorPoint = props.anchorPoint or Vector2.zero,
        BackgroundColor3 = disabled and colors.BG_800 or (selected and style.hoverColor or style.bgTop),
        BackgroundTransparency = disabled and 0.35 or (props.transparency or 0.04),
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        LayoutOrder = props.layoutOrder or 0,
        ZIndex = props.zIndex or 3,
        Visible = props.visible ~= false,
    })

    -- Section 07: Child UIScale for hover (1.04), press (0.96), and Back Out rebound (1.0)
    local uiScale = Instance.new("UIScale")
    uiScale.Name = "UIScale"
    uiScale.Scale = 1.0
    uiScale.Parent = btn

    UIFactory.Corner(btn, props.cornerRadius or Theme.Radius.Medium)
    local stroke = UIFactory.Stroke(
        btn,
        selected and colors.ACCENT_GOLD or (disabled and colors.TEXT_MUTED or style.strokeColor),
        selected and 1.8 or 1.2,
        disabled and 0.65 or 0.35
    )

    local grad = UIFactory.Gradient(
        btn,
        disabled and colors.BG_800 or style.bgTop,
        disabled and colors.BG_900 or style.bgBottom,
        90
    )

    -- Optional 9-Slice Image Layer if custom asset ID is uploaded in UIAssets
    local assetId = UIAssets.ButtonNineSlice
    if UIAssets.IsValidAssetId and UIAssets.IsValidAssetId(assetId) then
        local sliceRect = (UIAssets.NineSliceRects and UIAssets.NineSliceRects.Button) or Rect.new(12, 12, 52, 52)
        UIFactory.Create("ImageLabel", btn, {
            Name = "NineSliceSkin",
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Image = assetId,
            ScaleType = Enum.ScaleType.Slice,
            SliceCenter = sliceRect,
            SliceScale = 1,
            ZIndex = btn.ZIndex,
        })
    end

    local textOffsetLeft = props.icon and 34 or 10
    if props.icon then
        UIFactory.Icon(
            btn,
            props.icon,
            UDim2.new(0, 10, 0.5, -10),
            20,
            disabled and colors.TEXT_MUTED or style.textColor
        )
    end

    local label = UIFactory.Label(btn, {
        Name = "Label",
        Text = props.label or props.text or "BUTTON",
        Position = UDim2.fromOffset(textOffsetLeft, 0),
        Size = UDim2.new(1, -(textOffsetLeft + 10), 1, 0),
        TextSize = props.textSize or Theme.TextSize.Body,
        TextColor = disabled and colors.TEXT_MUTED or style.textColor,
        Font = Theme.Fonts.Heading,
        Bold = true,
        XAlign = props.icon and Enum.TextXAlignment.Left or (props.xAlign or Enum.TextXAlignment.Center),
        YAlign = Enum.TextYAlignment.Center,
        Truncate = Enum.TextTruncate.AtEnd,
        Wrapped = false,
        ZIndex = btn.ZIndex + 2,
    })

    local isHovered = false
    local isDisabled = disabled
    local isSelected = selected

    local function syncVisuals(stateName)
        if isDisabled then
            btn.BackgroundColor3 = colors.BG_800
            label.TextColor3 = colors.TEXT_MUTED
            stroke.Color = colors.TEXT_MUTED
            stroke.Transparency = 0.65
            uiScale.Scale = 1.0
            return
        end

        local targetBg = isSelected and style.hoverColor or style.bgTop
        local targetStroke = isSelected and colors.ACCENT_GOLD or style.strokeColor
        local targetStrokeTrans = isSelected and 0.08 or 0.35

        if stateName == "Hover" then
            targetBg = style.hoverColor
            targetStroke = colors.ACCENT_GOLD_BRIGHT
            targetStrokeTrans = 0.05
            UIAnimator.Tween(
                uiScale,
                { Scale = 1.04 },
                MotionTokens.hoverFast.duration,
                MotionTokens.hoverFast.style,
                MotionTokens.hoverFast.direction
            )
        elseif stateName == "Pressed" then
            targetBg = style.pressColor
            targetStrokeTrans = 0.0
            UIAnimator.Tween(
                uiScale,
                { Scale = 0.96 },
                MotionTokens.press.duration,
                MotionTokens.press.style,
                MotionTokens.press.direction
            )
        elseif stateName == "Rebound" then
            UIAnimator.Tween(
                uiScale,
                { Scale = isHovered and 1.04 or 1.0 },
                MotionTokens.rebound.duration,
                MotionTokens.rebound.style,
                MotionTokens.rebound.direction
            )
        else
            UIAnimator.Tween(
                uiScale,
                { Scale = 1.0 },
                MotionTokens.hoverFast.duration,
                MotionTokens.hoverFast.style,
                MotionTokens.hoverFast.direction
            )
        end

        UIAnimator.Tween(btn, { BackgroundColor3 = targetBg }, MotionTokens.hoverFast.duration)
        UIAnimator.Tween(stroke, {
            Color = targetStroke,
            Transparency = targetStrokeTrans,
        }, MotionTokens.hoverFast.duration)
        label.TextColor3 = style.textColor
    end

    btn.MouseEnter:Connect(function()
        isHovered = true
        if not isDisabled then
            syncVisuals("Hover")
        end
        if type(props.onHover) == "function" then
            props.onHover(true, btn)
        end
    end)

    btn.MouseLeave:Connect(function()
        isHovered = false
        if not isDisabled then
            syncVisuals("Idle")
        end
        if type(props.onHover) == "function" then
            props.onHover(false, btn)
        end
    end)

    btn.InputBegan:Connect(function(input)
        if isDisabled then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            syncVisuals("Pressed")
        end
    end)

    btn.InputEnded:Connect(function(input)
        if isDisabled then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            syncVisuals("Rebound")
        end
    end)

    btn.Activated:Connect(function()
        if isDisabled then
            return
        end
        syncVisuals("Rebound")
        if type(props.onActivated) == "function" then
            props.onActivated()
        elseif type(props.onClick) == "function" then
            props.onClick()
        end
    end)

    local api = {
        Instance = btn,
        Label = label,
        Stroke = stroke,
        Gradient = grad,
        Scale = uiScale,
    }

    function api:SetLabel(newText)
        label.Text = tostring(newText or "")
    end

    function api:SetDisabled(flag)
        isDisabled = flag == true
        syncVisuals("Idle")
    end

    function api:SetSelected(flag)
        isSelected = flag == true
        syncVisuals(isHovered and "Hover" or "Idle")
    end

    function api:Update(newProps)
        if not newProps then
            return
        end
        if newProps.label ~= nil or newProps.text ~= nil then
            api:SetLabel(newProps.label or newProps.text)
        end
        if newProps.disabled ~= nil then
            api:SetDisabled(newProps.disabled)
        end
        if newProps.selected ~= nil then
            api:SetSelected(newProps.selected)
        end
        if newProps.visible ~= nil then
            btn.Visible = newProps.visible == true
        end
    end

    function api:Destroy()
        if btn and btn.Parent then
            btn:Destroy()
        end
    end

    return btn, api
end

PremiumButton.create = PremiumButton.Create

return PremiumButton
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXF6666DBC69224615B2A080BCC357AAD4"><Properties><string name="Name">PremiumPanel</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Reusable Obsidian Glass Panel Component
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Components/PremiumPanel.lua

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))
local UIAssets = require(Shared:WaitForChild("Config"):WaitForChild("UIAssets"))

local UIFactory = require(script.Parent.Parent:WaitForChild("UIFactory"))

local PremiumPanel = {}

function PremiumPanel.Create(parent, props)
    props = props or {}
    local colors = Theme.Colors
    local isGold = props.variant == "gold" or props.gold == true
    local isElevated = props.variant == "elevated" or props.elevated == true
    local accentColor = props.accentColor and Theme.GetColor(props.accentColor)
        or (isGold and colors.ACCENT_GOLD or colors.STROKE_STEEL)

    local frame = UIFactory.Create("Frame", parent, {
        Name = props.name or "PremiumPanel",
        Position = props.position or UDim2.fromScale(0, 0),
        Size = props.size or UDim2.fromOffset(320, 220),
        AnchorPoint = props.anchorPoint or Vector2.new(0, 0),
        BackgroundColor3 = isElevated and colors.BG_700 or colors.BG_800,
        BackgroundTransparency = props.transparency or Theme.Transparency.Panel,
        BorderSizePixel = 0,
        ClipsDescendants = props.clipsDescendants == true,
        LayoutOrder = props.layoutOrder or 0,
        Visible = props.visible ~= false,
        ZIndex = props.zIndex or 2,
    })

    UIFactory.Corner(frame, props.cornerRadius or Theme.Radius.Large)
    local stroke = UIFactory.Stroke(
        frame,
        accentColor,
        isGold and Theme.Stroke.Default or Theme.Stroke.Thin,
        isGold and Theme.Stroke.AlphaGold or Theme.Stroke.AlphaDefault
    )
    UIFactory.Gradient(
        frame,
        isElevated and colors.SURFACE_GLASS or colors.BG_700,
        colors.BG_900,
        props.gradientRotation or 90
    )

    -- Optional 9-Slice Decorative Frame if uploaded in UIAssets
    if UIAssets.IsValidAssetId(UIAssets.PanelNineSlice) then
        UIFactory.Create("ImageLabel", frame, {
            Name = "NineSliceOverlay",
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Image = UIAssets.PanelNineSlice,
            ImageTransparency = 0.25,
            ScaleType = Enum.ScaleType.Slice,
            SliceCenter = UIAssets.NineSliceRects.Panel,
            ZIndex = frame.ZIndex + 1,
        })
    end

    local titleLabel
    local subtitleLabel
    local closeButton

    if props.title then
        titleLabel = UIFactory.Label(frame, {
            Name = "PanelTitle",
            Text = props.title,
            Position = UDim2.fromOffset(16, 12),
            Size = UDim2.new(1, props.onClose and -68 or -32, 0, 24),
            TextSize = props.titleSize or Theme.Typography.PanelHeading.Size,
            TextColor = isGold and colors.ACCENT_GOLD or (props.titleColor or colors.TEXT_PRIMARY),
            Bold = true,
            ZIndex = frame.ZIndex + 2,
        })

        if props.subtitle then
            subtitleLabel = UIFactory.Label(frame, {
                Name = "PanelSubtitle",
                Text = props.subtitle,
                Position = UDim2.fromOffset(16, 36),
                Size = UDim2.new(1, -32, 0, 18),
                TextSize = Theme.Typography.Label.Size,
                TextColor = colors.TEXT_SECONDARY,
                Weight = "Medium",
                ZIndex = frame.ZIndex + 2,
            })
        end

        UIFactory.Divider(
            frame,
            UDim2.fromOffset(16, props.subtitle and 58 or 42),
            UDim2.new(1, -32, 0, 1),
            isGold
        )
    end

    if type(props.onClose) == "function" then
        closeButton = UIFactory.Create("TextButton", frame, {
            Name = "CloseButton",
            Text = "×",
            Position = UDim2.new(1, -46, 0, 10),
            Size = UDim2.fromOffset(34, 34),
            BackgroundColor3 = colors.BG_700,
            BorderSizePixel = 0,
            Font = Theme.Fonts.Bold,
            TextSize = 22,
            TextColor3 = colors.TEXT_PRIMARY,
            AutoButtonColor = false,
            ZIndex = frame.ZIndex + 4,
        })
        UIFactory.Corner(closeButton, Theme.Radius.Small)
        UIFactory.Stroke(closeButton, colors.STROKE_STEEL, 1, 0.35)
        closeButton.Activated:Connect(function()
            props.onClose()
        end)
    end

    local api = {
        Instance = frame,
        Stroke = stroke,
        TitleLabel = titleLabel,
        SubtitleLabel = subtitleLabel,
        CloseButton = closeButton,
    }

    function api:Update(newProps)
        newProps = newProps or {}
        if newProps.title and titleLabel then
            titleLabel.Text = newProps.title
        end
        if newProps.subtitle and subtitleLabel then
            subtitleLabel.Text = newProps.subtitle
        end
        if newProps.accentColor then
            stroke.Color = Theme.GetColor(newProps.accentColor)
        end
        if newProps.visible ~= nil then
            frame.Visible = newProps.visible
        end
    end

    function api:Destroy()
        if frame and frame.Parent then
            frame:Destroy()
        end
    end

    return frame, api
end

PremiumPanel.create = PremiumPanel.Create

return PremiumPanel
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX1F437CA14AE640A68C1D009134F6E148"><Properties><string name="Name">QuestTracker</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Collapsible HUD Quest Tracker Component
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Components/QuestTracker.lua

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))

local UIFactory = require(script.Parent.Parent:WaitForChild("UIFactory"))

local QuestTracker = {}

function QuestTracker.Create(parent, props)
    props = props or {}
    local colors = Theme.Colors
    local collapsed = props.collapsed == true

    local card = UIFactory.Create("Frame", parent, {
        Name = props.name or "QuestTracker",
        Position = props.position or UDim2.fromOffset(18, 172),
        Size = props.size or UDim2.fromOffset(310, 178),
        BackgroundColor3 = colors.BG_800,
        BackgroundTransparency = Theme.Transparency.HUDCard,
        BorderSizePixel = 0,
        ZIndex = props.zIndex or 4,
    })
    UIFactory.Corner(card, Theme.Radius.Medium)
    UIFactory.Stroke(card, colors.STROKE_STEEL, 1.2, 0.32)
    UIFactory.Gradient(card, colors.BG_700, colors.BG_900, 90)

    local headerBar = UIFactory.Create("Frame", card, {
        Name = "Header",
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundTransparency = 1,
        ZIndex = card.ZIndex + 1,
    })

    UIFactory.Icon(headerBar, "Quest", UDim2.fromOffset(10, 6), 22, colors.ACCENT_GOLD)

    UIFactory.Label(headerBar, {
        Name = "HeaderTitle",
        Text = "ACTIVE QUEST",
        Position = UDim2.fromOffset(36, 0),
        Size = UDim2.new(1, -110, 1, 0),
        TextSize = 12,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
        ZIndex = card.ZIndex + 2,
    })

    local journalBtn = UIFactory.Create("TextButton", headerBar, {
        Name = "OpenJournalButton",
        Text = "[J]",
        Position = UDim2.new(1, -68, 0, 5),
        Size = UDim2.fromOffset(30, 24),
        BackgroundColor3 = colors.BG_700,
        BorderSizePixel = 0,
        Font = Theme.Fonts.Bold,
        TextSize = 11,
        TextColor3 = colors.ACCENT_SAPPHIRE,
        AutoButtonColor = false,
        ZIndex = card.ZIndex + 3,
    })
    UIFactory.Corner(journalBtn, 4)

    local collapseBtn = UIFactory.Create("TextButton", headerBar, {
        Name = "CollapseButton",
        Text = collapsed and "+" or "−",
        Position = UDim2.new(1, -32, 0, 5),
        Size = UDim2.fromOffset(24, 24),
        BackgroundColor3 = colors.BG_700,
        BorderSizePixel = 0,
        Font = Theme.Fonts.Bold,
        TextSize = 15,
        TextColor3 = colors.TEXT_PRIMARY,
        AutoButtonColor = false,
        ZIndex = card.ZIndex + 3,
    })
    UIFactory.Corner(collapseBtn, 4)

    local body = UIFactory.Create("Frame", card, {
        Name = "Body",
        Position = UDim2.fromOffset(12, 36),
        Size = UDim2.new(1, -24, 1, -44),
        BackgroundTransparency = 1,
        Visible = not collapsed,
        ZIndex = card.ZIndex + 1,
    })

    local questTitle = UIFactory.Label(body, {
        Name = "Name",
        Text = "Q01 • Lời gọi Skyborn",
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.new(1, 0, 0, 24),
        TextSize = 15,
        TextColor = colors.TEXT_PRIMARY,
        Bold = true,
        ZIndex = card.ZIndex + 2,
    })

    local objectivesLabel = UIFactory.Label(body, {
        Name = "Objectives",
        Text = "",
        Position = UDim2.fromOffset(0, 28),
        Size = UDim2.new(1, 0, 1, -28),
        TextSize = 13,
        TextColor = colors.TEXT_SECONDARY,
        YAlign = Enum.TextYAlignment.Top,
        RichText = true,
        ZIndex = card.ZIndex + 2,
    })

    local function applyCollapse()
        body.Visible = not collapsed
        collapseBtn.Text = collapsed and "+" or "−"
        local baseW = (props.size and props.size.X.Offset) or 310
        local baseH = (props.size and props.size.Y.Offset) or 178
        card.Size = UDim2.fromOffset(baseW, collapsed and 36 or baseH)
    end

    collapseBtn.Activated:Connect(function()
        collapsed = not collapsed
        applyCollapse()
        if type(props.onToggleCollapse) == "function" then
            props.onToggleCollapse(collapsed)
        end
    end)

    journalBtn.Activated:Connect(function()
        if type(props.onOpenJournal) == "function" then
            props.onOpenJournal()
        end
    end)

    local api = {
        Instance = card,
        QuestTitle = questTitle,
        ObjectivesLabel = objectivesLabel,
    }

    function api:Update(questState)
        questState = questState or {}
        if questState.collapsed ~= nil then
            collapsed = questState.collapsed == true
            applyCollapse()
        end

        local q = questState.activeQuest or questState
        if not q or not q.name then
            questTitle.Text = "Chapter I Complete"
            objectivesLabel.Text = "Core of Light recovered. Proceed to the Frozen Cyber portal."
            return
        end

        questTitle.Text = (q.activeId and (q.activeId .. " • ") or "") .. tostring(q.name)
        if q.accepted == false then
            objectivesLabel.Text = "&lt;font color='#E4B863'&gt;Speak with Lyra at the Sky Hub to accept this quest.&lt;/font&gt;"
            return
        end

        local lines = {}
        for _, obj in ipairs(q.objectives or {}) do
            local cur = tonumber(obj.current or obj.Count) or 0
            local tgt = math.max(1, tonumber(obj.target or obj.Goal) or 1)
            local done = cur &gt;= tgt
            local prefix = done and "&lt;font color='#5ED79E'&gt;✓&lt;/font&gt; " or "&lt;font color='#40AAFF'&gt;○&lt;/font&gt; "
            table.insert(lines, string.format("%s%s  &lt;b&gt;%d / %d&lt;/b&gt;", prefix, obj.label or obj.Label or "Objective", cur, tgt))
        end
        objectivesLabel.Text = #lines &gt; 0 and table.concat(lines, "\n") or (q.text or "")
    end

    function api:Destroy()
        if card and card.Parent then
            card:Destroy()
        end
    end

    applyCollapse()
    return card, api
end

QuestTracker.create = QuestTracker.Create

return QuestTracker
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX1F123DD31A674EF88F3E909ADEBAAF82"><Properties><string name="Name">RaidPhase</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Boss &amp; Raid Phase Indicator Component
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Components/RaidPhase.lua
-- Supports Aureon (3 phases + Pylon shield), Noxar (3 combat phases + Purification), and Veyr (4 phases + 4 Anchors).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))

local UIFactory = require(script.Parent.Parent:WaitForChild("UIFactory"))
local StatBar = require(script.Parent:WaitForChild("StatBar"))

local RaidPhase = {}

function RaidPhase.Create(parent, props)
    props = props or {}
    local colors = Theme.Colors

    local container = UIFactory.Create("Frame", parent, {
        Name = props.name or "BossHUD",
        AnchorPoint = props.anchorPoint or Vector2.new(0.5, 0),
        Position = props.position or UDim2.new(0.5, 0, 0, 16),
        Size = props.size or UDim2.fromOffset(580, 112),
        BackgroundColor3 = colors.BG_800,
        BackgroundTransparency = 0.08,
        BorderSizePixel = 0,
        Visible = props.visible ~= false,
        ZIndex = props.zIndex or 8,
    })

    UIFactory.Corner(container, Theme.Radius.Large)
    local stroke = UIFactory.Stroke(container, colors.HP_RED, 1.6, 0.16)
    UIFactory.Gradient(container, colors.BG_700, colors.BG_900, 90)

    local nameLabel = UIFactory.Label(container, {
        Name = "Name",
        Text = props.bossName or "AUREON SENTINEL",
        Position = UDim2.fromOffset(16, 8),
        Size = UDim2.new(0.62, -16, 0, 22),
        TextSize = 18,
        TextColor = colors.TEXT_PRIMARY,
        Bold = true,
        ZIndex = container.ZIndex + 2,
    })

    local phaseLabel = UIFactory.Label(container, {
        Name = "BossPhase",
        Text = "PHASE 1 / 3  •  SOLAR VIGIL",
        Position = UDim2.new(0.62, 0, 0, 8),
        Size = UDim2.new(0.38, -16, 0, 22),
        TextSize = 13,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
        XAlign = Enum.TextXAlignment.Right,
        ZIndex = container.ZIndex + 2,
    })

    local _, hpBarApi = StatBar.Create(container, {
        name = "HP",
        type = "BossHP",
        current = props.bossHp or 2200,
        max = props.bossMaxHp or 2200,
        position = UDim2.fromOffset(16, 36),
        size = UDim2.new(1, -32, 0, 26),
        zIndex = container.ZIndex + 2,
    })

    local _, breakBarApi = StatBar.Create(container, {
        name = "Break",
        type = "Break",
        current = props.breakGauge or 0,
        max = 100,
        customText = "BREAK GAUGE",
        position = UDim2.fromOffset(16, 68),
        size = UDim2.new(0.66, -16, 0, 16),
        textSize = 10,
        zIndex = container.ZIndex + 2,
    })

    local pipsHolder = UIFactory.Create("Frame", container, {
        Name = "PhasePips",
        Position = UDim2.new(0.68, 4, 0, 68),
        Size = UDim2.new(0.32, -20, 0, 16),
        BackgroundTransparency = 1,
        ZIndex = container.ZIndex + 2,
    })
    UIFactory.ListLayout(pipsHolder, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)

    local pips = {}
    for i = 1, 4 do
        local pip = UIFactory.Create("Frame", pipsHolder, {
            Name = "PhasePip_" .. i,
            Size = UDim2.fromOffset(26, 12),
            BackgroundColor3 = i == 1 and colors.ACCENT_GOLD or colors.BG_900,
            BorderSizePixel = 0,
            LayoutOrder = i,
            ZIndex = container.ZIndex + 3,
        })
        UIFactory.Corner(pip, 4)
        UIFactory.Stroke(pip, colors.ACCENT_GOLD, 1, 0.25)
        pips[i] = pip
    end

    local warningBanner = UIFactory.Create("Frame", container, {
        Name = "BossWarning",
        Position = UDim2.fromOffset(16, 88),
        Size = UDim2.new(1, -32, 0, 20),
        BackgroundColor3 = colors.HP_RED:Lerp(colors.BG_900, 0.65),
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = container.ZIndex + 3,
    })
    UIFactory.Corner(warningBanner, 4)
    local warningText = UIFactory.Label(warningBanner, {
        Name = "Text",
        Text = "ENERGY SHIELD ACTIVE — DESTROY BOTH ENERGY PYLONS!",
        Size = UDim2.fromScale(1, 1),
        TextSize = 12,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
        XAlign = Enum.TextXAlignment.Center,
        ZIndex = container.ZIndex + 4,
    })

    local api = {
        Instance = container,
        NameLabel = nameLabel,
        PhaseLabel = phaseLabel,
        HPBar = hpBarApi,
        BreakBar = breakBarApi,
        WarningBanner = warningBanner,
        WarningText = warningText,
    }

    function api:Update(state)
        state = state or {}
        if state.active ~= nil then
            container.Visible = state.active == true
        end
        if not container.Visible then
            return
        end

        local phase = tonumber(state.phase) or 1
        local maxPhases = tonumber(state.maxPhases) or 3
        nameLabel.Text = state.bossName or "AUREON SENTINEL"

        local statusNote = state.phaseTitle or "COMBAT"
        if state.purificationReady then
            statusNote = "FINAL PURIFICATION RITUAL!"
            stroke.Color = colors.VOID_PURPLE
        elseif state.stunned then
            statusNote = "POSTURE BROKEN — STRIKE NOW!"
            stroke.Color = colors.SUCCESS
        elseif state.shield then
            statusNote = "AEGIS SHIELD ACTIVE"
            stroke.Color = colors.ACCENT_GOLD
        else
            stroke.Color = colors.HP_RED
        end

        phaseLabel.Text = string.format("PHASE %d / %d  •  %s", phase, maxPhases, statusNote)

        hpBarApi:Update({
            current = state.bossHp or state.HP or 0,
            max = state.bossMaxHp or state.MaxHP or 2200,
        })
        breakBarApi:Update({
            current = state.breakGauge or state.Break or 0,
            max = 100,
            customText = string.format("BREAK %d%%", math.floor(state.breakGauge or state.Break or 0)),
        })

        for i = 1, 4 do
            local pip = pips[i]
            pip.Visible = i &lt;= maxPhases
            pip.BackgroundColor3 = i &lt;= phase and colors.ACCENT_GOLD or colors.BG_900
        end

        warningBanner.Visible = (state.shield == true) or (state.purificationReady == true) or (state.warningText ~= nil)
        if state.purificationReady then
            warningText.Text = "NOXAR POSTURE COLLAPSED — CHANNEL CORE PURIFICATION!"
        elseif state.shield then
            warningText.Text = "PHÁ HAI TRỤ NĂNG LƯỢNG ĐỂ PHÁ KHIÊN BOSS!"
        elseif state.warningText then
            warningText.Text = state.warningText
        end
    end

    function api:Destroy()
        hpBarApi:Destroy()
        breakBarApi:Destroy()
        if container and container.Parent then
            container:Destroy()
        end
    end

    return container, api
end

RaidPhase.create = RaidPhase.Create

return RaidPhase
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXA3B0D80950CA4A04B085E1EBB9712956"><Properties><string name="Name">SkillButton</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Combat Ability Hotbar Slot Component
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Components/SkillButton.lua
-- States: Ready, Cooldown, OutOfEnergy, Locked, UltimateReady (Section 07, Section 09, Section 11).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))
local AssetManifest = require(Shared:WaitForChild("AssetManifest"))
local SpritePlayer = require(Shared:WaitForChild("SpritePlayer"))
local UIAnimator = require(Shared:WaitForChild("UIAnimator"))
local MotionTokens = require(Shared:WaitForChild("MotionTokens"))

local UIFactory = require(script.Parent.Parent:WaitForChild("UIFactory"))

local SkillButton = {}

function SkillButton.Create(parent, props)
    props = props or {}
    local colors = Theme.Colors
    local isUltimate = props.isUltimate == true
    local accent = props.accentColor and Theme.GetColor(props.accentColor)
        or (isUltimate and colors.ACCENT_GOLD or colors.ACCENT_SAPPHIRE)

    local btn = UIFactory.Create("TextButton", parent, {
        Name = props.name or ("Skill_" .. tostring(props.skillId or "Slot")),
        Position = props.position or UDim2.fromOffset(0, 0),
        Size = props.size or UDim2.fromOffset(82, 76),
        BackgroundColor3 = colors.BG_800,
        BackgroundTransparency = 0.06,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        LayoutOrder = props.layoutOrder or 0,
        ZIndex = props.zIndex or 6,
    })

    local uiScale = Instance.new("UIScale")
    uiScale.Name = "UIScale"
    uiScale.Scale = 1.0
    uiScale.Parent = btn

    UIFactory.Corner(btn, Theme.Radius.Medium)
    local stroke = UIFactory.Stroke(btn, accent, isUltimate and 2.0 or 1.5, 0.15)
    UIFactory.Gradient(btn, colors.BG_700, colors.BG_900, 90)

    -- Section 09 &amp; Section 11: 4x4 Sprite Sheet Ultimate Ring FX when Ultimate is Ready
    local ultRing = nil
    if isUltimate then
        ultRing = UIFactory.Create("ImageLabel", btn, {
            Name = "UltimateRing",
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.42, 0),
            Size = UDim2.fromOffset(58, 58),
            BackgroundTransparency = 1,
            Visible = true,
            ZIndex = btn.ZIndex + 1,
        })
    end

    UIFactory.Icon(
        btn,
        props.icon or "Sword",
        UDim2.new(0.5, -16, 0, 12),
        32,
        accent
    )

    -- Keybind pill top-left
    local keyLabel = UIFactory.Label(btn, {
        Name = "Key",
        Text = props.keybind or "1",
        Position = UDim2.fromOffset(6, 4),
        Size = UDim2.fromOffset(32, 16),
        TextSize = 11,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
        Wrapped = false,
        ZIndex = btn.ZIndex + 3,
    })

    -- Energy / Stamina cost top-right
    local costValue = tonumber(props.energyCost) or 0
    UIFactory.Label(btn, {
        Name = "Cost",
        Text = costValue &gt; 0 and tostring(costValue) or "",
        Position = UDim2.new(1, -34, 0, 4),
        Size = UDim2.fromOffset(28, 16),
        TextSize = 11,
        TextColor = colors.ACCENT_SAPPHIRE,
        Bold = true,
        XAlign = Enum.TextXAlignment.Right,
        Wrapped = false,
        ZIndex = btn.ZIndex + 3,
    })

    -- Caption at bottom
    local captionLabel = UIFactory.Label(btn, {
        Name = "Caption",
        Text = props.label or props.skillId or "Skill",
        Position = UDim2.new(0, 4, 1, -20),
        Size = UDim2.new(1, -8, 0, 18),
        TextSize = 11,
        TextColor = colors.TEXT_PRIMARY,
        Bold = true,
        XAlign = Enum.TextXAlignment.Center,
        Truncate = Enum.TextTruncate.AtEnd,
        Wrapped = false,
        ZIndex = btn.ZIndex + 3,
    })

    -- Cooldown Dark Curtain Overlay
    local cdOverlay = UIFactory.Create("Frame", btn, {
        Name = "CooldownOverlay",
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.fromScale(0, 1),
        Size = UDim2.fromScale(1, 0),
        BackgroundColor3 = colors.BG_900,
        BackgroundTransparency = 0.22,
        BorderSizePixel = 0,
        ZIndex = btn.ZIndex + 4,
    })
    UIFactory.Corner(cdOverlay, Theme.Radius.Medium)

    -- Cooldown / Lock Center Text
    local cdText = UIFactory.Label(btn, {
        Name = "Cooldown",
        Text = "",
        Position = UDim2.fromOffset(0, 8),
        Size = UDim2.new(1, 0, 0, 44),
        TextSize = 18,
        TextColor = colors.TEXT_PRIMARY,
        Bold = true,
        XAlign = Enum.TextXAlignment.Center,
        Wrapped = false,
        ZIndex = btn.ZIndex + 5,
    })

    local state = {
        locked = props.locked == true,
        cooldown = 0,
        maxCooldown = math.max(0.1, tonumber(props.maxCooldown) or 6),
        outOfEnergy = false,
        ultAnimPlaying = false,
    }

    btn.MouseEnter:Connect(function()
        if not state.locked then
            UIAnimator.Tween(uiScale, { Scale = 1.05 }, MotionTokens.hoverFast.duration)
        end
    end)

    btn.MouseLeave:Connect(function()
        UIAnimator.Tween(uiScale, { Scale = 1.0 }, MotionTokens.hoverFast.duration)
    end)

    btn.InputBegan:Connect(function(input)
        if not state.locked and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            UIAnimator.Tween(uiScale, { Scale = 0.94 }, MotionTokens.press.duration)
        end
    end)

    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            UIAnimator.Tween(uiScale, { Scale = 1.0 }, MotionTokens.rebound.duration, MotionTokens.rebound.style, MotionTokens.rebound.direction)
        end
    end)

    btn.Activated:Connect(function()
        if state.locked or state.cooldown &gt; 0 then
            return
        end
        if type(props.onActivated) == "function" then
            props.onActivated(props.skillId)
        end
    end)

    local api = {
        Instance = btn,
        CooldownLabel = cdText,
        CaptionLabel = captionLabel,
        KeyLabel = keyLabel,
        UltimateRing = ultRing,
    }

    function api:Update(newState)
        newState = newState or {}
        if newState.label ~= nil then
            captionLabel.Text = newState.label
        end
        if newState.locked ~= nil then
            state.locked = newState.locked == true
        end
        if newState.cooldown ~= nil then
            state.cooldown = math.max(0, tonumber(newState.cooldown) or 0)
        end
        if newState.maxCooldown ~= nil then
            state.maxCooldown = math.max(0.1, tonumber(newState.maxCooldown) or 6)
        end
        if newState.outOfEnergy ~= nil then
            state.outOfEnergy = newState.outOfEnergy == true
        end

        local ultReady = isUltimate and (not state.locked) and (state.cooldown &lt;= 0) and (not state.outOfEnergy)
        if ultRing then
            ultRing.Visible = ultReady
            if ultReady and not state.ultAnimPlaying then
                state.ultAnimPlaying = true
                SpritePlayer.Play(ultRing, AssetManifest.UltimateAtlas, 4, 4, 256, 256, 16, 16)
            elseif not ultReady and state.ultAnimPlaying then
                state.ultAnimPlaying = false
                SpritePlayer.Stop(ultRing)
            end
        end

        if state.locked then
            cdOverlay.Size = UDim2.fromScale(1, 1)
            cdText.Text = newState.lockLabel or "🔒"
            cdText.TextColor3 = colors.TEXT_SECONDARY
            stroke.Color = colors.STROKE_STEEL
        elseif state.cooldown &gt; 0 then
            local ratio = math.clamp(state.cooldown / state.maxCooldown, 0, 1)
            cdOverlay.Size = UDim2.fromScale(1, ratio)
            cdText.Text = string.format("%.1f", state.cooldown)
            cdText.TextColor3 = colors.TEXT_PRIMARY
            stroke.Color = colors.STROKE_STEEL
        elseif state.outOfEnergy then
            cdOverlay.Size = UDim2.fromScale(1, 0.35)
            cdText.Text = "LOW EN"
            cdText.TextColor3 = colors.HP_RED
            stroke.Color = colors.HP_RED
        else
            cdOverlay.Size = UDim2.fromScale(1, 0)
            cdText.Text = ""
            stroke.Color = isUltimate and colors.ACCENT_GOLD or accent
        end
    end

    function api:Destroy()
        if ultRing then
            SpritePlayer.Stop(ultRing)
        end
        if btn and btn.Parent then
            btn:Destroy()
        end
    end

    api:Update(props)
    return btn, api
end

SkillButton.create = SkillButton.Create

return SkillButton
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXBEE60902ED334AD495706BAA8DBBC703"><Properties><string name="Name">StatBar</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Tweened Vitals &amp; Progress Bar Component
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Components/StatBar.lua
-- Supports HP, Energy, Stamina, EXP, BossHP, Break Gauge with smooth width tweening.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))

local UIFactory = require(script.Parent.Parent:WaitForChild("UIFactory"))
local Animations = require(script.Parent.Parent:WaitForChild("Animations"))

local StatBar = {}

local TYPE_COLORS = {
    HP = Theme.Colors.HP_RED,
    BossHP = Theme.Colors.HP_RED,
    Energy = Theme.Colors.ACCENT_SAPPHIRE,
    Stamina = Theme.Colors.ACCENT_SAPPHIRE,
    EXP = Theme.Colors.ACCENT_GOLD,
    Break = Theme.Colors.VOID_PURPLE,
    Success = Theme.Colors.SUCCESS,
}

function StatBar.Create(parent, props)
    props = props or {}
    local barType = props.type or "HP"
    local fillColor = props.color and Theme.GetColor(props.color)
        or TYPE_COLORS[barType]
        or Theme.Colors.ACCENT_SAPPHIRE

    local current = tonumber(props.current) or 100
    local maxVal = math.max(1, tonumber(props.max) or 100)
    local ratio = math.clamp(current / maxVal, 0, 1)

    local container = UIFactory.Create("Frame", parent, {
        Name = props.name or (barType .. "Bar"),
        Position = props.position or UDim2.fromOffset(0, 0),
        Size = props.size or UDim2.fromOffset(240, 26),
        BackgroundColor3 = Theme.Colors.BG_900,
        BackgroundTransparency = 0.08,
        BorderSizePixel = 0,
        LayoutOrder = props.layoutOrder or 0,
        ZIndex = props.zIndex or 4,
    })

    UIFactory.Corner(container, props.cornerRadius or Theme.Radius.Small)
    UIFactory.Stroke(container, props.strokeColor or Theme.Colors.STROKE_STEEL, 1, 0.35)

    local inner = UIFactory.Create("Frame", container, {
        Name = "Track",
        Position = UDim2.fromOffset(2, 2),
        Size = UDim2.new(1, -4, 1, -4),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex = container.ZIndex + 1,
    })
    UIFactory.Corner(inner, math.max(3, (props.cornerRadius or Theme.Radius.Small) - 2))

    -- Delayed Trail Fill (gives AAA RPG impact feedback when HP drops)
    local trailFill = UIFactory.Create("Frame", inner, {
        Name = "TrailFill",
        Size = UDim2.fromScale(ratio, 1),
        BackgroundColor3 = Theme.Colors.ACCENT_GOLD:Lerp(Theme.Colors.TEXT_PRIMARY, 0.35),
        BackgroundTransparency = 0.35,
        BorderSizePixel = 0,
        ZIndex = container.ZIndex + 1,
    })
    UIFactory.Corner(trailFill, 4)

    -- Primary Fill (named "Fill" to match Section 10.3 Humanoid binding specification)
    local fill = UIFactory.Create("Frame", inner, {
        Name = "Fill",
        Size = UDim2.fromScale(ratio, 1),
        BackgroundColor3 = fillColor,
        BorderSizePixel = 0,
        ZIndex = container.ZIndex + 2,
    })
    UIFactory.Corner(fill, 4)
    UIFactory.Gradient(fill, fillColor:Lerp(Color3.new(1, 1, 1), 0.14), fillColor:Lerp(Color3.new(0, 0, 0), 0.28), 90)

    local function formatLabel(c, m, customText)
        if customText then
            return customText
        end
        local prefix = props.label and (props.label .. "  ") or ""
        return prefix .. UIFactory.FormatNumber(math.ceil(c)) .. " / " .. UIFactory.FormatNumber(math.ceil(m))
    end

    local valueLabel = UIFactory.Label(container, {
        Name = "Value",
        Text = formatLabel(current, maxVal, props.customText),
        Position = UDim2.fromOffset(8, 0),
        Size = UDim2.new(1, -16, 1, 0),
        TextSize = props.textSize or 13,
        TextColor = Theme.Colors.TEXT_PRIMARY,
        Bold = true,
        XAlign = props.textAlign or Enum.TextXAlignment.Center,
        Wrapped = false,
        ZIndex = container.ZIndex + 4,
    })

    local api = {
        Instance = container,
        Fill = fill,
        Trail = trailFill,
        Text = valueLabel,
        Current = current,
        Max = maxVal,
    }

    function api:Update(state)
        state = state or {}
        local newCurrent = tonumber(state.current or state.value) or api.Current
        local newMax = math.max(1, tonumber(state.max) or api.Max)
        api.Current = newCurrent
        api.Max = newMax

        local newRatio = math.clamp(newCurrent / newMax, 0, 1)
        Animations.TweenBar(fill, newRatio, Theme.Motion.HP, props.scope)
        Animations.TweenBar(trailFill, newRatio, Theme.Motion.HP * 1.65, props.scope)
        valueLabel.Text = formatLabel(newCurrent, newMax, state.customText or state.label)
    end

    function api:Destroy()
        if container and container.Parent then
            container:Destroy()
        end
    end

    return container, api
end

StatBar.create = StatBar.Create

return StatBar
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXAD05A1F8E9F7473D80AAEDEDD4FED164"><Properties><string name="Name">Toast</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Non-Blocking Notification &amp; Reward Toast
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Components/Toast.lua

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))

local UIFactory = require(script.Parent.Parent:WaitForChild("UIFactory"))
local Animations = require(script.Parent.Parent:WaitForChild("Animations"))

local Toast = {}

local KIND_COLORS = {
    info = Theme.Colors.ACCENT_SAPPHIRE,
    success = Theme.Colors.SUCCESS,
    warning = Theme.Colors.ACCENT_GOLD,
    error = Theme.Colors.HP_RED,
    reward = Theme.Colors.ACCENT_GOLD,
}

function Toast.Create(parent, props)
    props = props or {}
    local colors = Theme.Colors

    local holder = UIFactory.Create("Frame", parent, {
        Name = props.name or "ToastBanner",
        AnchorPoint = Vector2.new(0.5, 0),
        Position = props.position or UDim2.new(0.5, 0, 0, 18),
        Size = props.size or UDim2.fromOffset(480, 48),
        BackgroundColor3 = colors.BG_800,
        BackgroundTransparency = 0.04,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = props.zIndex or 50,
    })

    UIFactory.Corner(holder, Theme.Radius.Medium)
    local stroke = UIFactory.Stroke(holder, colors.ACCENT_GOLD, 1.5, 0.12)
    UIFactory.Gradient(holder, colors.BG_700, colors.BG_900, 90)

    local accentBar = UIFactory.Create("Frame", holder, {
        Name = "AccentStripe",
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.new(0, 5, 1, 0),
        BackgroundColor3 = colors.ACCENT_SAPPHIRE,
        BorderSizePixel = 0,
        ZIndex = holder.ZIndex + 1,
    })
    UIFactory.Corner(accentBar, 4)

    local textLabel = UIFactory.Label(holder, {
        Name = "ToastMessage",
        Text = "",
        Position = UDim2.fromOffset(18, 4),
        Size = UDim2.new(1, -30, 1, -8),
        TextSize = 14,
        TextColor = colors.TEXT_PRIMARY,
        Bold = true,
        XAlign = Enum.TextXAlignment.Center,
        ZIndex = holder.ZIndex + 2,
    })

    local latestToken = 0

    local api = {
        Instance = holder,
        TextLabel = textLabel,
    }

    function api:Show(message, kind, duration)
        latestToken += 1
        local myToken = latestToken
        local accent = KIND_COLORS[kind or "info"] or colors.ACCENT_SAPPHIRE

        stroke.Color = accent
        accentBar.BackgroundColor3 = accent
        textLabel.Text = tostring(message or "")
        holder.Visible = true

        local basePos = props.position or UDim2.new(0.5, 0, 0, 18)
        Animations.FadeInPanel(holder, basePos, Theme.Motion.Reward, "Toast")

        task.delay(duration or 2.8, function()
            if latestToken == myToken and holder and holder.Parent then
                holder.Visible = false
            end
        end)
    end

    function api:Update(state)
        if state and state.message then
            api:Show(state.message, state.kind, state.duration)
        end
    end

    function api:Destroy()
        Animations.CleanupScope("Toast")
        if holder and holder.Parent then
            holder:Destroy()
        end
    end

    return holder, api
end

Toast.create = Toast.Create

return Toast
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXE8C785A7B7234574842A0DC1FFC8AA6C"><Properties><string name="Name">Tooltip</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Boundary-Safe Item &amp; Stat Comparison Tooltip
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Components/Tooltip.lua

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))
local RarityConfig = require(Shared:WaitForChild("Config"):WaitForChild("RarityConfig"))
local WorldConfig = require(Shared:WaitForChild("Config"):WaitForChild("WorldConfig"))

local UIFactory = require(script.Parent.Parent:WaitForChild("UIFactory"))
local Responsive = require(script.Parent.Parent:WaitForChild("Responsive"))
local PremiumButton = require(script.Parent:WaitForChild("PremiumButton"))

local Tooltip = {}

function Tooltip.Create(parent, props)
    props = props or {}
    local colors = Theme.Colors

    local card = UIFactory.Create("Frame", parent, {
        Name = props.name or "ItemTooltip",
        Position = props.position or UDim2.fromOffset(0, 0),
        Size = props.size or UDim2.fromScale(1, 1),
        BackgroundColor3 = colors.BG_800,
        BackgroundTransparency = 0.04,
        BorderSizePixel = 0,
        ZIndex = props.zIndex or 8,
    })
    UIFactory.Corner(card, Theme.Radius.Large)
    local stroke = UIFactory.Stroke(card, colors.STROKE_STEEL, 1.5, 0.2)
    UIFactory.Gradient(card, colors.BG_700, colors.BG_900, 90)

    local titleLabel = UIFactory.Label(card, {
        Name = "Title",
        Text = "Select an Item",
        Position = UDim2.fromOffset(16, 12),
        Size = UDim2.new(1, -130, 0, 24),
        TextSize = 18,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
        ZIndex = card.ZIndex + 2,
    })

    local rarityBadge = UIFactory.Badge(
        card,
        "COMMON",
        UDim2.new(1, -110, 0, 12),
        UDim2.fromOffset(94, 22),
        colors.STROKE_STEEL,
        colors.TEXT_PRIMARY
    )

    local metaLabel = UIFactory.Label(card, {
        Name = "Meta",
        Text = "Click any slot in the grid to inspect stats and actions.",
        Position = UDim2.fromOffset(16, 38),
        Size = UDim2.new(1, -32, 0, 18),
        TextSize = 12,
        TextColor = colors.TEXT_SECONDARY,
        Weight = "Medium",
        ZIndex = card.ZIndex + 2,
    })

    local statsLabel = UIFactory.Label(card, {
        Name = "StatsText",
        Text = "",
        Position = UDim2.fromOffset(16, 60),
        Size = UDim2.new(1, -180, 1, -72),
        TextSize = 13,
        TextColor = colors.TEXT_PRIMARY,
        YAlign = Enum.TextYAlignment.Top,
        RichText = true,
        ZIndex = card.ZIndex + 2,
    })

    local currentItemId = nil
    local isEquipped = false

    local equipBtn, equipApi = PremiumButton.Create(card, {
        name = "EquipActionButton",
        label = "EQUIP",
        variant = "primary",
        position = UDim2.new(1, -156, 1, -96),
        size = UDim2.fromOffset(140, 38),
        zIndex = card.ZIndex + 3,
        onActivated = function()
            if currentItemId and type(props.onEquipToggle) == "function" then
                props.onEquipToggle(currentItemId, isEquipped)
            end
        end,
    })

    local compareBtn, compareApi = PremiumButton.Create(card, {
        name = "CompareActionButton",
        label = "COMPARE",
        variant = "secondary",
        position = UDim2.new(1, -156, 1, -50),
        size = UDim2.fromOffset(140, 36),
        zIndex = card.ZIndex + 3,
        onActivated = function()
            if currentItemId and type(props.onCompareToggle) == "function" then
                props.onCompareToggle(currentItemId)
            end
        end,
    })

    local api = {
        Instance = card,
        EquipButton = equipBtn,
        CompareButton = compareBtn,
    }

    function api:ClampToScreen(anchorPosition, viewportSize)
        local absSize = card.AbsoluteSize
        local clamped = Responsive.ClampTooltipPosition(anchorPosition, absSize, viewportSize, 12)
        card.Position = UDim2.fromOffset(clamped.X, clamped.Y)
    end

    function api:Update(data)
        data = data or {}
        currentItemId = data.itemId
        local item = currentItemId and RarityConfig.GetItem(currentItemId) or nil
        if not item then
            titleLabel.Text = "SELECT AN ITEM"
            titleLabel.TextColor3 = colors.TEXT_PRIMARY
            metaLabel.Text = "Select an item slot to inspect stats, passive effects, and equipment requirements."
            statsLabel.Text = ""
            equipBtn.Visible = false
            compareBtn.Visible = false
            return
        end

        local rarity = RarityConfig.GetRarity(item.Rarity)
        local upgrade = tonumber(data.upgrade) or 0
        local count = tonumber(data.count) or 0
        isEquipped = data.equipped == true

        titleLabel.Text = item.Name .. (upgrade &gt; 0 and (" +" .. upgrade) or "")
        titleLabel.TextColor3 = rarity.Color
        stroke.Color = rarity.Color

        local badgeText = rarityBadge:FindFirstChild("BadgeText")
        if badgeText then
            badgeText.Text = string.upper(rarity.DisplayName)
            badgeText.TextColor3 = rarity.Color
        end

        local classReqText = "All Classes"
        if item.ClassId and WorldConfig.Classes[item.ClassId] then
            classReqText = WorldConfig.Classes[item.ClassId].Name
        end
        metaLabel.Text = string.format(
            "%s  •  Lv. %d+  •  %s  •  Owned: %d",
            item.Slot or item.Category or "Item",
            item.LevelReq or 1,
            classReqText,
            count
        )

        local lines = {}
        if item.Stats and next(item.Stats) then
            local mult = 1 + (upgrade * (rarity.UpgradeMultiplier or 0.08))
            local statTokens = {}
            for k, v in pairs(item.Stats) do
                local scaled = math.floor(v * mult)
                local compareDelta = ""
                if data.compareItem and data.compareItem.Stats then
                    local baseOther = data.compareItem.Stats[k] or 0
                    local diff = scaled - baseOther
                    if diff &gt; 0 then
                        compareDelta = string.format(" &lt;font color='#5ED79E'&gt;(+%d)&lt;/font&gt;", diff)
                    elseif diff &lt; 0 then
                        compareDelta = string.format(" &lt;font color='#EF5262'&gt;(%d)&lt;/font&gt;", diff)
                    end
                end
                table.insert(statTokens, string.format("&lt;b&gt;%s&lt;/b&gt; +%d%s", k, scaled, compareDelta))
            end
            table.sort(statTokens)
            table.insert(lines, table.concat(statTokens, "   •   "))
        end
        if item.Passive then
            table.insert(lines, "&lt;font color='#E4B863'&gt;" .. item.Passive .. "&lt;/font&gt;")
        end
        if item.Description then
            table.insert(lines, item.Description)
        end

        statsLabel.Text = table.concat(lines, "\n")

        local canEquip = item.Slot ~= nil and count &gt; 0
        equipBtn.Visible = canEquip
        compareBtn.Visible = canEquip
        if canEquip then
            equipApi:Update({
                label = isEquipped and "UNEQUIP" or "EQUIP",
                variant = isEquipped and "secondary" or "primary",
            })
            compareApi:Update({
                label = data.compareMode and "HIDE COMPARE" or "COMPARE",
                selected = data.compareMode == true,
            })
        end
    end

    function api:Destroy()
        equipApi:Destroy()
        compareApi:Destroy()
        if card and card.Parent then
            card:Destroy()
        end
    end

    return card, api
end

Tooltip.create = Tooltip.Create

return Tooltip
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX372A3B60A750442D8193C98632B2FA07"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX2B7252C7ACF24C889157BDA77DFF0F6C"><Properties><string name="Name">HUDController</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — HUD &amp; Humanoid Binding Controller
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Controllers/HUDController.lua
-- Implements Section 10.3 real Humanoid HealthChanged binding with leak-free connection management.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local WorldConfig = require(Shared:WaitForChild("Config"):WaitForChild("WorldConfig"))

local Store = require(script.Parent.Parent:WaitForChild("Store"))
local Animations = require(script.Parent.Parent:WaitForChild("Animations"))

local HUDController = {
    HealthConnection = nil,
    MaxHealthConnection = nil,
    CharacterAddedConnection = nil,
    BoundHPBarApi = nil,
    ExternalActionCallback = nil,
    ExternalAttackCallback = nil,
}

function HUDController.SetCombatCallbacks(onAction, onAttack)
    HUDController.ExternalActionCallback = onAction
    HUDController.ExternalAttackCallback = onAttack
end

function HUDController.BindHumanoidToBar(hpBarApi)
    HUDController.BoundHPBarApi = hpBarApi
    local player = Players.LocalPlayer
    if not player then
        return
    end

    local function disconnectHealth()
        if HUDController.HealthConnection then
            HUDController.HealthConnection:Disconnect()
            HUDController.HealthConnection = nil
        end
        if HUDController.MaxHealthConnection then
            HUDController.MaxHealthConnection:Disconnect()
            HUDController.MaxHealthConnection = nil
        end
    end

    local function bindCharacter(character)
        disconnectHealth()
        if not character then
            return
        end
        task.spawn(function()
            local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 8)
            if not humanoid or player.Character ~= character then
                return
            end

            local function renderHealth()
                local hp = math.max(0, humanoid.Health)
                local maxHp = math.max(1, humanoid.MaxHealth)
                local snap = Store.GetSnapshot()
                snap.vitals.hp = hp
                snap.vitals.maxHp = maxHp
                if HUDController.BoundHPBarApi then
                    HUDController.BoundHPBarApi:Update({
                        current = hp,
                        max = maxHp,
                        customText = string.format("HP  %d / %d", math.ceil(hp), math.ceil(maxHp)),
                    })
                end
            end

            HUDController.HealthConnection = humanoid.HealthChanged:Connect(renderHealth)
            HUDController.MaxHealthConnection = humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(renderHealth)
            renderHealth()
        end)
    end

    if HUDController.CharacterAddedConnection then
        HUDController.CharacterAddedConnection:Disconnect()
    end
    HUDController.CharacterAddedConnection = player.CharacterAdded:Connect(bindCharacter)
    if player.Character then
        bindCharacter(player.Character)
    end
end

function HUDController.TriggerAction(actionName)
    local snap = Store.GetSnapshot()
    local classId = snap.player.classId or "SkyGuardian"
    local classCfg = WorldConfig.Classes[classId] or WorldConfig.Classes.SkyGuardian

    -- Map generic slot keys to class-specific server action IDs
    local resolvedAction = actionName
    if actionName == "Skill1" or actionName == "SkySlash" then
        resolvedAction = classCfg.Skills[1] and classCfg.Skills[1].Id or "SkySlash"
    elseif actionName == "Skill2" or actionName == "GuardianShield" then
        resolvedAction = classCfg.Skills[2] and classCfg.Skills[2].Id or "GuardianShield"
    elseif actionName == "Skill3" then
        resolvedAction = classCfg.Skills[4] and classCfg.Skills[4].Id or "JudgmentStrike"
    elseif actionName == "Ultimate" then
        resolvedAction = classCfg.Skills[5] and classCfg.Skills[5].Id or "CelestialAegis"
    end

    -- Check level lock for Skills 3 &amp; Ultimate
    for _, sk in ipairs(classCfg.Skills) do
        if sk.Id == resolvedAction then
            if snap.player.level &lt; (sk.LevelReq or 1) then
                Store.ShowToast(string.format("%s unlocks at Level %d.", sk.Name, sk.LevelReq), "warning")
                return
            end
            break
        end
    end

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if actionName == "Z" or actionName == "X" or actionName == "C" or actionName == "V" or actionName == "F" then
        if remotes and remotes:FindFirstChild("AbilityRequest") then
            remotes.AbilityRequest:FireServer({ action = "SlotMove", key = actionName })
        end
        return
    end

    local serverSkillAlias = {
        TempestSpiral = "StormBlitz",
        Thunderfall = "ThunderJudgement",
    }
    local serverSkillId = serverSkillAlias[resolvedAction] or resolvedAction

    if type(HUDController.ExternalActionCallback) == "function" then
        -- Route through ClientBootstrap's existing server sender when available
        if resolvedAction == classCfg.Skills[1].Id then
            HUDController.ExternalActionCallback("SkySlash")
        elseif resolvedAction == classCfg.Skills[2].Id then
            HUDController.ExternalActionCallback("GuardianShield")
        elseif resolvedAction == "Dodge" or resolvedAction == "Dash" or resolvedAction == "Interact" then
            HUDController.ExternalActionCallback(resolvedAction)
        else
            if remotes and remotes:FindFirstChild("AbilityRequest") then
                remotes.AbilityRequest:FireServer({ skillId = serverSkillId, action = serverSkillId })
            end
            Store.ShowToast("Activated " .. resolvedAction .. "!", "info")
        end
        return
    end

    -- Direct Remote fallback or Demo Mode simulation
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes and not snap.isDemoMode then
        if resolvedAction == "Dodge" or resolvedAction == "Dash" or resolvedAction == "Attack" or resolvedAction == "Heavy" then
            local ev = remotes:FindFirstChild("CombatRequest")
            if ev then ev:FireServer({ action = resolvedAction }) end
        else
            local ev = remotes:FindFirstChild("AbilityRequest")
            if ev then ev:FireServer({ skillId = resolvedAction }) end
        end
    else
        snap.cooldowns[resolvedAction] = 5.0
        Store.LastServerSyncClock = os.clock()
        Store.ShowToast("[DEMO] Triggered ability: " .. tostring(resolvedAction), "info")
    end
end

function HUDController.TriggerAttackInput(inputObject)
    if type(HUDController.ExternalAttackCallback) == "function" then
        HUDController.ExternalAttackCallback(inputObject)
        return
    end
    HUDController.TriggerAction("Attack")
end

function HUDController.Cleanup()
    if HUDController.HealthConnection then
        HUDController.HealthConnection:Disconnect()
        HUDController.HealthConnection = nil
    end
    if HUDController.MaxHealthConnection then
        HUDController.MaxHealthConnection:Disconnect()
        HUDController.MaxHealthConnection = nil
    end
    HUDController.BoundHPBarApi = nil
    Animations.CleanupScope("HUD")
end

return HUDController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3233876C5A534272AC7CB9090FE03110"><Properties><string name="Name">InventoryController</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Inventory, Equipment &amp; 3D ViewportFrame Controller
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Controllers/InventoryController.lua
-- Handles filtering, sorting, server-validated equip requests, and leak-free ViewportFrame 3D preview (Section 10.4).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local RarityConfig = require(Shared:WaitForChild("Config"):WaitForChild("RarityConfig"))
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))

local Store = require(script.Parent.Parent:WaitForChild("Store"))
local UIFactory = require(script.Parent.Parent:WaitForChild("UIFactory"))

local InventoryController = {
    ActiveViewportModel = nil,
    ActiveViewportCamera = nil,
    CurrentYaw = math.rad(165),
}

function InventoryController.GetFilteredInventory()
    local snap = Store.GetSnapshot()
    local view = Store.GetView()
    local filter = view.inventoryFilter or "All"
    local sortMode = view.inventorySort or "Rarity"
    local query = string.lower(view.searchQuery or "")

    local results = {}
    for _, entry in ipairs(snap.inventory or {}) do
        if (entry.count or 0) &gt; 0 then
            local cfg = RarityConfig.GetItem(entry.itemId)
            if cfg then
                local categoryMatch = (filter == "All")
                    or (filter == "Equipment" and cfg.Slot ~= nil)
                    or (filter == "Weapons" and cfg.Category == "Weapons")
                    or (filter == "Armor" and cfg.Category == "Armor")
                    or (filter == "Materials" and cfg.Category == "Materials")
                    or (filter == "Quest" and cfg.Category == "Quest")

                local searchMatch = (query == "")
                    or (string.find(string.lower(cfg.Name or ""), query, 1, true) ~= nil)
                    or (string.find(string.lower(cfg.VietnameseName or ""), query, 1, true) ~= nil)
                    or (string.find(string.lower(entry.itemId), query, 1, true) ~= nil)

                if categoryMatch and searchMatch then
                    table.insert(results, {
                        itemId = entry.itemId,
                        count = entry.count,
                        upgrade = entry.upgrade or 0,
                        equipped = (snap.equipped and snap.equipped[cfg.Slot or ""] == entry.itemId) or entry.equipped == true,
                        config = cfg,
                        rarity = RarityConfig.GetRarity(cfg.Rarity),
                    })
                end
            end
        end
    end

    table.sort(results, function(a, b)
        if sortMode == "Level" then
            local la = a.config.LevelReq or 1
            local lb = b.config.LevelReq or 1
            if la ~= lb then return la &gt; lb end
        elseif sortMode == "Name" then
            if a.config.Name ~= b.config.Name then
                return a.config.Name &lt; b.config.Name
            end
        end
        if a.rarity.Tier ~= b.rarity.Tier then
            return a.rarity.Tier &gt; b.rarity.Tier
        end
        return a.config.Name &lt; b.config.Name
    end)

    return results
end

function InventoryController.RequestEquipToggle(itemId, currentlyEquipped)
    local snap = Store.GetSnapshot()
    local cfg = RarityConfig.GetItem(itemId)
    if not cfg or not cfg.Slot then
        Store.ShowToast("Selected item cannot be equipped.", "warning")
        return
    end

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes and not snap.isDemoMode then
        -- Live server supports starter weapons via EquipmentRequest and extended slots via UICommand
        local equipRemote = remotes:FindFirstChild("EquipmentRequest")
        local uiCmd = remotes:FindFirstChild("UICommand")
        if cfg.Slot == "Weapon" and (itemId == "starter_sword" or itemId == "starter_daggers" or itemId == "starter_staff") and equipRemote then
            equipRemote:FireServer({
                action = currentlyEquipped and "Unequip" or "Equip",
                itemId = itemId,
            })
            Store.ShowToast(currentlyEquipped and ("Unequipping " .. cfg.Name .. "...") or ("Equipping " .. cfg.Name .. "..."), "info")
            return
        elseif uiCmd then
            uiCmd:FireServer({
                command = "EquipItem",
                itemId = itemId,
                slot = cfg.Slot,
                unequip = currentlyEquipped,
            })
            return
        end
    end

    Store.ApplyDemoPreviewAction("EquipItem", { itemId = itemId })
end

-- Build player's live 3D V5 Hero Rig (or Fruit Transformation Rig) with skeletal animation for Inventory ViewportFrame
function InventoryController.CloneCharacterForViewport()
    local player = Players.LocalPlayer
    local snap = Store.GetSnapshot()
    local classId = (player and player:GetAttribute("ClassId")) or (snap and snap.player and snap.player.classId) or "SkyGuardian"
    local gender = (player and player:GetAttribute("SkybornGender")) or (snap and snap.player and snap.player.gender) or "Male"
    local stage = (player and player:GetAttribute("OutfitStage")) or "SkyGuardian"
    local ch = player and player.Character
    local fTrans = ch and ch:GetAttribute("FruitTransform") or ""

    local assetName = "Male_SkyGuardian"
    if fTrans == "SolarTitan" then
        assetName = "SolarTitanBuddha"
    elseif fTrans == "AbyssalSovereign" then
        assetName = "AbyssalSovereignDragon"
    elseif fTrans == "AbyssalDragonHybrid" then
        assetName = "AbyssalDragonHybrid"
    elseif classId == "ThunderStriker" then
        assetName = (gender == "Female") and "ThunderStrikerFemale" or "ThunderStriker"
    elseif classId == "ArcaneMage" then
        assetName = (gender == "Female") and "ArcaneMageFemale" or "ArcaneMage"
    else
        assetName = string.format("%s_%s", (gender == "Female") and "Female" or "Male", stage)
    end

    local okR, Renderer = pcall(function()
        return require(ReplicatedStorage:WaitForChild("DelegatedV5Renderer", 2))
    end)
    if okR and Renderer then
        local okB, built = pcall(Renderer.Build, assetName)
        if okB and built then
            pcall(function()
                built:PivotTo(CFrame.identity)
            end)
            local okC, clips = pcall(Renderer.Clips, assetName)
            if okC and type(clips) == "table" then
                local activeClip = clips.HeroicKata or clips.ElementalSurge or clips.Idle
                if activeClip then
                    pcall(Renderer.Pose, built, activeClip, os.clock())
                    local RunService = game:GetService("RunService")
                    if InventoryController.ActiveSpinConn then
                        InventoryController.ActiveSpinConn:Disconnect()
                    end
                    InventoryController.ActiveSpinConn = RunService.RenderStepped:Connect(function()
                        if not built or not built.Parent then
                            if InventoryController.ActiveSpinConn then
                                InventoryController.ActiveSpinConn:Disconnect()
                                InventoryController.ActiveSpinConn = nil
                            end
                            return
                        end
                        pcall(Renderer.Pose, built, activeClip, os.clock())
                    end)
                end
            end
            return built
        end
    end
    return nil
end

function InventoryController.MountViewportPreview(viewportFrame, fallbackContainer)
    InventoryController.CleanupViewport()
    if not viewportFrame then
        return false
    end

    for _, child in ipairs(viewportFrame:GetChildren()) do
        if child:IsA("WorldModel") or child:IsA("Camera") or child:IsA("Frame") then
            child:Destroy()
        end
    end

    local clone = InventoryController.CloneCharacterForViewport()
    if clone then
        local worldModel = UIFactory.Create("WorldModel", viewportFrame, {
            Name = "PreviewWorldModel",
        })
        clone.Parent = worldModel

        local cf, size = clone:GetBoundingBox()
        local target = cf.Position
        local distance = math.max(size.Y, size.X, 4) / (2 * math.tan(math.rad(19))) * 1.15

        local camera = UIFactory.Create("Camera", viewportFrame, {
            Name = "PreviewCamera",
            FieldOfView = 38,
        })
        viewportFrame.CurrentCamera = camera
        InventoryController.ActiveViewportModel = clone
        InventoryController.ActiveViewportCamera = camera
        InventoryController.ActiveTarget = target
        InventoryController.ActiveDistance = distance
        InventoryController.ActiveHeightOffset = size.Y * 0.08
        InventoryController.UpdateCameraRotation(0)
        return true
    end

    -- Fallback procedural silhouette crest when character model is not yet spawned
    local fallback = fallbackContainer or viewportFrame
    local silhouette = UIFactory.Create("Frame", fallback, {
        Name = "FallbackCrest",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.48),
        Size = UDim2.fromOffset(148, 190),
        BackgroundColor3 = Theme.Colors.BG_700,
        BackgroundTransparency = 0.25,
        BorderSizePixel = 0,
    })
    UIFactory.Corner(silhouette, Theme.Radius.Large)
    UIFactory.Stroke(silhouette, Theme.Colors.ACCENT_GOLD, 1.5, 0.25)

    local snap = Store.GetSnapshot()
    local classIcon = snap.player.classId == "ThunderStriker" and "Daggers"
        or (snap.player.classId == "ArcaneMage" and "Staff" or "Sword")

    UIFactory.Icon(silhouette, classIcon, UDim2.new(0.5, -32, 0.36, -32), 64, Theme.Colors.ACCENT_GOLD)
    UIFactory.Label(silhouette, {
        Name = "FallbackCaption",
        Text = "3D AVATAR PREVIEW\n(Spawns with Character)",
        Position = UDim2.new(0, 8, 1, -48),
        Size = UDim2.new(1, -16, 0, 40),
        TextSize = 11,
        TextColor = Theme.Colors.TEXT_SECONDARY,
        Bold = true,
        XAlign = Enum.TextXAlignment.Center,
    })
    return false
end

function InventoryController.UpdateCameraRotation(deltaRadians)
    InventoryController.CurrentYaw += (deltaRadians or 0)
    local cam = InventoryController.ActiveViewportCamera
    local target = InventoryController.ActiveTarget
    local dist = InventoryController.ActiveDistance or 7
    local hOff = InventoryController.ActiveHeightOffset or 0.3
    if cam and target then
        local offset = Vector3.new(
            math.sin(InventoryController.CurrentYaw) * dist,
            hOff,
            math.cos(InventoryController.CurrentYaw) * dist
        )
        cam.CFrame = CFrame.lookAt(target + offset, target)
    end
end

function InventoryController.CleanupViewport()
    if InventoryController.ActiveSpinConn then
        InventoryController.ActiveSpinConn:Disconnect()
        InventoryController.ActiveSpinConn = nil
    end
    if InventoryController.ActiveViewportModel then
        pcall(function()
            InventoryController.ActiveViewportModel:Destroy()
        end)
        InventoryController.ActiveViewportModel = nil
    end
    if InventoryController.ActiveViewportCamera then
        pcall(function()
            InventoryController.ActiveViewportCamera:Destroy()
        end)
        InventoryController.ActiveViewportCamera = nil
    end
end

return InventoryController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3325B419C16A43478C714C9083005F46"><Properties><string name="Name">PartyController</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Class, Forge, World Travel &amp; Raid Controller
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Controllers/PartyController.lua
-- All resource/travel/class actions request server validation first; never grants client-side Gold/EXP.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local WorldConfig = require(Shared:WaitForChild("Config"):WaitForChild("WorldConfig"))
local RarityConfig = require(Shared:WaitForChild("Config"):WaitForChild("RarityConfig"))

local Store = require(script.Parent.Parent:WaitForChild("Store"))

local PartyController = {}

function PartyController.RequestClassOrGenderChange(classId, gender)
    local snap = Store.GetSnapshot()
    local targetClass = classId or snap.player.classId
    local targetGender = gender or snap.player.gender

    local cls = WorldConfig.Classes[targetClass]
    if not cls then
        Store.ShowToast("Invalid Class selection.", "error")
        return
    end
    if targetClass == "ArcaneMage" and targetGender == "Female" then
        Store.ShowToast(cls.FemaleLockReason or "Arcane Mage nữ chưa có model; hiện chọn bản nam.", "warning")
        return
    end

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes and not snap.isDemoMode then
        local appRemote = remotes:FindFirstChild("AppearanceRequest")
        if appRemote then
            appRemote:FireServer({
                ClassId = targetClass,
                Gender = targetGender,
            })
            Store.ShowToast("Requested Class / Appearance switch from server...", "info")
            return
        end
    end

    Store.ApplyDemoPreviewAction("SelectClass", {
        classId = targetClass,
        gender = targetGender,
    })
end

function PartyController.RequestFastTravel(realmId)
    local snap = Store.GetSnapshot()
    local realm = WorldConfig.RealmById[realmId] or (WorldConfig.IslandById and WorldConfig.IslandById[realmId])
    if not realm then
        Store.ShowToast("Unknown destination realm or island.", "error")
        return
    end

    local isUnlocked = (realmId == "SkyHub")
        or (realmId == "GoldenSky")
        or (realm.FastTravelUnlockedByDefault == true)
        or (WorldConfig.IslandById and WorldConfig.IslandById[realmId] ~= nil)
        or (snap.world and snap.world.unlocked and snap.world.unlocked[realmId] == true)

    if not isUnlocked then
        Store.ShowToast(
            string.format("%s is locked. %s", realm.Name, realm.UnlockConditionText or "Complete prior chapter first."),
            "warning"
        )
        return
    end

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes and not snap.isDemoMode then
        local eqRemote = remotes:FindFirstChild("EquipmentRequest")
        if eqRemote then
            eqRemote:FireServer({
                action = "FastTravel",
                nodeId = realmId,
            })
        end
        local uiCmd = remotes:FindFirstChild("UICommand")
        if uiCmd then
            uiCmd:FireServer({
                command = "FastTravel",
                realmId = realmId,
            })
        end
        if eqRemote or uiCmd then
            snap.world.current = realm.RealmId or realmId
            Store.ShowToast("Fast Traveling to " .. realm.Name .. "...", "info")
            return
        end
    end

    snap.world.current = realm.RealmId or realmId
    Store.ShowToast("[DEMO] Fast Travel preview: arrived at " .. realm.Name, "success")
end

function PartyController.RequestForgeCraft(recipeId)
    local snap = Store.GetSnapshot()
    local recipe = nil
    for _, r in ipairs(RarityConfig.Recipes) do
        if r.Id == recipeId then
            recipe = r
            break
        end
    end
    if not recipe then
        Store.ShowToast("Invalid recipe selected.", "error")
        return
    end

    -- Client pre-check for clear user feedback (Server still re-validates everything!)
    if snap.player.level &lt; (recipe.LevelReq or 1) then
        Store.ShowToast(string.format("Requires Level %d to craft %s.", recipe.LevelReq, recipe.Name), "warning")
        return
    end
    if snap.currency.gold &lt; (recipe.GoldCost or 0) then
        Store.ShowToast(string.format("Insufficient Gold (%d / %d required).", snap.currency.gold, recipe.GoldCost), "error")
        return
    end

    local ownedCounts = {}
    for _, entry in ipairs(snap.inventory) do
        ownedCounts[entry.itemId] = entry.count or 0
    end
    for _, mat in ipairs(recipe.Materials) do
        local have = ownedCounts[mat.ItemId] or 0
        if have &lt; mat.Count then
            local matCfg = RarityConfig.GetItem(mat.ItemId)
            Store.ShowToast(
                string.format("Missing material: %s (%d / %d).", matCfg and matCfg.Name or mat.ItemId, have, mat.Count),
                "error"
            )
            return
        end
    end

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes and not snap.isDemoMode then
        local uiCmd = remotes:FindFirstChild("UICommand")
        if uiCmd then
            uiCmd:FireServer({
                command = "CraftRecipe",
                recipeId = recipeId,
            })
            Store.ShowToast("Submitting craft order to Kael's Forge...", "info")
            return
        end
    end

    Store.ShowToast("[DEMO] Craft validated (" .. recipe.Name .. "). Server authority required to consume materials.", "success")
end

function PartyController.RequestUpgradeItem(itemId)
    local snap = Store.GetSnapshot()
    local itemCfg = RarityConfig.GetItem(itemId)
    if not itemCfg then
        Store.ShowToast("Select a valid equipment piece to upgrade.", "warning")
        return
    end

    local currentUpgrade = 0
    for _, entry in ipairs(snap.inventory) do
        if entry.itemId == itemId then
            currentUpgrade = entry.upgrade or 0
            break
        end
    end

    local costInfo = RarityConfig.GetUpgradeCost(itemId, currentUpgrade)
    if not costInfo.CanUpgrade then
        Store.ShowToast(itemCfg.Name .. " has reached maximum upgrade tier!", "warning")
        return
    end
    if snap.currency.gold &lt; costInfo.GoldCost then
        Store.ShowToast(string.format("Insufficient Gold (%d / %d).", snap.currency.gold, costInfo.GoldCost), "error")
        return
    end

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes and not snap.isDemoMode then
        local uiCmd = remotes:FindFirstChild("UICommand")
        if uiCmd then
            uiCmd:FireServer({
                command = "UpgradeItem",
                itemId = itemId,
            })
            Store.ShowToast("Requesting upgrade +" .. costInfo.NextUpgrade .. " from server...", "info")
            return
        end
    end

    Store.ShowToast(
        string.format("[DEMO] Upgrade +%d preview for %s (Server validates material consumption).", costInfo.NextUpgrade, itemCfg.Name),
        "info"
    )
end

function PartyController.SimulateBossPhase(raidId, phaseNumber)
    Store.ApplyDemoPreviewAction("ToggleRaidPreview", {
        raidId = raidId,
        forcePhase = phaseNumber,
    })
end

return PartyController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXDA93B45D78EA46A6916EF5D49C9DCD32"><Properties><string name="Name">QuestController</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Quest Journal, Tracker &amp; Dialogue Controller
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Controllers/QuestController.lua

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local WorldConfig = require(Shared:WaitForChild("Config"):WaitForChild("WorldConfig"))

local Store = require(script.Parent.Parent:WaitForChild("Store"))

local QuestController = {}

function QuestController.GetQuestsByCategory(category)
    category = category or "Main"
    local snap = Store.GetSnapshot()
    local activeId = snap.quest and snap.quest.activeId
    local completedMap = (snap.quest and snap.quest.completedIds) or {}

    local list = {}
    for _, q in ipairs(WorldConfig.Quests) do
        if category == "All" or q.Category == category then
            local status = "Available"
            if completedMap[q.Id] then
                status = "Completed"
            elseif q.Id == activeId then
                status = snap.quest.accepted and "Active" or "ReadyToAccept"
            elseif snap.player.level &lt; (q.LevelReq or 1) then
                status = "Locked"
            end
            table.insert(list, {
                config = q,
                status = status,
                isTracked = (q.Id == activeId),
            })
        end
    end
    return list
end

function QuestController.SelectQuest(questId)
    Store.SetView({ selectedQuestId = questId })
end

function QuestController.TrackQuest(questId)
    local snap = Store.GetSnapshot()
    local found = nil
    for _, q in ipairs(WorldConfig.Quests) do
        if q.Id == questId then
            found = q
            break
        end
    end
    if not found then
        return
    end

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes and not snap.isDemoMode then
        local uiCmd = remotes:FindFirstChild("UICommand")
        if uiCmd then
            uiCmd:FireServer({ command = "TrackQuest", questId = questId })
        end
    end

    -- Update local tracker display if in Demo Mode or previewing secondary quests
    if snap.isDemoMode or found.Category ~= "Main" then
        local objs = {}
        for i, o in ipairs(found.Objectives or {}) do
            table.insert(objs, {
                id = tostring(i),
                label = o.Label,
                current = i == 1 and 1 or 0,
                target = o.Target or 1,
            })
        end
        snap.quest = {
            activeId = found.Id,
            name = found.Name,
            text = found.Description,
            accepted = true,
            level = found.LevelReq,
            objectives = objs,
            completedIds = snap.quest and snap.quest.completedIds or {},
        }
        Store.SetView({ selectedQuestId = questId })
        Store.ShowToast("Tracking Quest: " .. found.Name, "success")
    else
        Store.ShowToast("Active Main Quest synced with server: " .. (snap.quest and snap.quest.name or found.Name), "info")
    end
end

function QuestController.OpenDialogue(speaker, text, role, questId, actionLabel, actionCommand)
    Store.SetView({
        dialogue = {
            visible = true,
            speaker = speaker or "LYRA • SKY HUB",
            role = role or "Lorekeeper of the Core",
            text = text or "",
            questId = questId,
            actionLabel = actionLabel,
            actionCommand = actionCommand,
        },
    })
end

function QuestController.CloseDialogue()
    Store.SetView({
        dialogue = {
            visible = false,
        },
    })
end

return QuestController
</ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX5BAAE90C80994B318C5D2B972D82E535"><Properties><string name="Name">Responsive</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Responsive Layout &amp; Device Profile Utility
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Responsive.lua

local UserInputService = game:GetService("UserInputService")

local Responsive = {}

Responsive.Profiles = {
    Desktop = "Desktop",
    Laptop = "Laptop",
    Tablet = "Tablet",
    PhoneLandscape = "PhoneLandscape",
    PhonePortrait = "PhonePortrait",
    Console = "Console",
}

function Responsive.GetState(viewportSize, layoutOverride, textScaleSetting)
    local size = viewportSize or Vector2.new(1280, 720)
    local w = math.max(320, size.X)
    local h = math.max(240, size.Y)
    local aspect = w / h
    local isPortrait = w &lt; h * 0.92

    local touchEnabled = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    local gamepadEnabled = UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled

    local isMobile = touchEnabled or (w &lt;= 920 and h &lt;= 540) or isPortrait
    if layoutOverride == "Mobile" then
        isMobile = true
    elseif layoutOverride == "Desktop" then
        isMobile = false
    end

    local profile = Responsive.Profiles.Desktop
    if gamepadEnabled and layoutOverride == "Auto" then
        profile = Responsive.Profiles.Console
    elseif isPortrait then
        profile = Responsive.Profiles.PhonePortrait
    elseif isMobile and w &lt; 960 then
        profile = Responsive.Profiles.PhoneLandscape
    elseif isMobile then
        profile = Responsive.Profiles.Tablet
    elseif w &lt;= 1400 or h &lt;= 800 then
        profile = Responsive.Profiles.Laptop
    end

    -- Reference canvas &amp; scale clamping so fonts never shrink below readable sizes (Section 06.2)
    local refWidth = isPortrait and 760 or 1366
    local refHeight = isPortrait and 1220 or 768
    local rawScale = math.min(w / refWidth, h / refHeight)
    local uiScale = math.clamp(rawScale, 0.68, 1.25)

    local userTextScale = math.clamp(tonumber(textScaleSetting) or 1.0, 0.85, 1.25)

    return {
        Viewport = Vector2.new(w, h),
        Aspect = aspect,
        Profile = profile,
        IsPortrait = isPortrait,
        IsMobile = isMobile,
        IsCompact = isPortrait or w &lt; 1024 or h &lt; 640,
        TouchControls = isMobile,
        GamepadEnabled = gamepadEnabled,
        CanvasSize = UDim2.fromOffset(refWidth, refHeight),
        CanvasWidth = refWidth,
        CanvasHeight = refHeight,
        UIScale = uiScale,
        TextScale = userTextScale,
        CollapseSidebar = isPortrait or w &lt; 900,
        MinButtonHeight = isMobile and 52 or 44,
    }
end

function Responsive.ClampTooltipPosition(anchorPos, tooltipSize, viewportSize, margin)
    margin = margin or 12
    local vw = viewportSize.X
    local vh = viewportSize.Y
    local tw = tooltipSize.X
    local th = tooltipSize.Y
    local x = math.clamp(anchorPos.X, margin, math.max(margin, vw - tw - margin))
    local y = math.clamp(anchorPos.Y, margin, math.max(margin, vh - th - margin))
    return Vector2.new(x, y)
end

return Responsive
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXDA6D1276809D446EA3FBDEAD102E4DCC"><Properties><string name="Name">ScreenRouter</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Navigation &amp; Modal Priority Router
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/ScreenRouter.lua
-- Single router managing active screens, back stack, Escape/Gamepad-B handling, and HUD visibility (Section 03).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local UIState = require(Shared:WaitForChild("Types"):WaitForChild("UIState"))

local Store = require(script.Parent:WaitForChild("Store"))
local Animations = require(script.Parent:WaitForChild("Animations"))

local ScreenRouter = {
    CurrentScreen = UIState.Screens.HUD,
    BackStack = {},
    RegisteredScreens = {},
    OnRouteChanged = nil,
}

function ScreenRouter.NormalizeRoute(route)
    if not route then
        return UIState.Screens.HUD
    end
    return UIState.LegacyPageMap[route] or route
end

function ScreenRouter.RegisterScreen(screenId, screenModule)
    ScreenRouter.RegisteredScreens[screenId] = screenModule
end

function ScreenRouter.Navigate(route, options)
    options = options or {}
    local target = ScreenRouter.NormalizeRoute(route)
    local previous = ScreenRouter.CurrentScreen

    if previous == target and not options.forceRebuild then
        return target
    end

    -- Cleanup active screen animations and resources (e.g. ViewportFrame connections)
    local prevModule = ScreenRouter.RegisteredScreens[previous]
    if prevModule and type(prevModule.Cleanup) == "function" then
        pcall(prevModule.Cleanup)
    end
    Animations.CleanupScope("Screen_" .. tostring(previous))

    if not options.replace and previous and previous ~= target then
        table.insert(ScreenRouter.BackStack, previous)
        if #ScreenRouter.BackStack &gt; 12 then
            table.remove(ScreenRouter.BackStack, 1)
        end
    end

    ScreenRouter.CurrentScreen = target
    ScreenRouter.LastNavigateClock = os.clock()
    Store.SetView({
        currentScreen = target,
        backStack = ScreenRouter.BackStack,
    })

    if ScreenRouter.OnRouteChanged then
        ScreenRouter.OnRouteChanged(target, previous)
    end

    return target
end

function ScreenRouter.CloseAllToHUD()
    table.clear(ScreenRouter.BackStack)
    return ScreenRouter.Navigate(UIState.Screens.HUD, { replace = true, forceRebuild = true })
end

function ScreenRouter.ToggleScreen(route)
    if os.clock() - (ScreenRouter.LastNavigateClock or 0) &lt; 0.06 then
        return ScreenRouter.CurrentScreen
    end
    local target = ScreenRouter.NormalizeRoute(route)
    if ScreenRouter.CurrentScreen == target then
        return ScreenRouter.Navigate(UIState.Screens.HUD, { replace = true })
    end
    return ScreenRouter.Navigate(target)
end

function ScreenRouter.Back()
    local view = Store.GetView()
    -- Priority 1: Dismiss active Confirmation Modal
    if view.modal and view.modal.visible then
        Store.CloseModal()
        return ScreenRouter.CurrentScreen
    end

    -- Priority 2: Dismiss contextual NPC Dialogue overlay
    if view.dialogue and view.dialogue.visible then
        Store.SetView({ dialogue = { visible = false } })
        return ScreenRouter.CurrentScreen
    end

    -- Priority 3: If in a full-screen sub-menu (including MainMenu), return to previous screen or HUD
    if ScreenRouter.CurrentScreen ~= UIState.Screens.HUD then
        local popped = table.remove(ScreenRouter.BackStack)
        local fallback = popped or UIState.Screens.HUD
        return ScreenRouter.Navigate(fallback, { replace = true })
    end

    -- Priority 4: If on HUD and Escape/Back pressed, open MainMenu / Pause
    if ScreenRouter.CurrentScreen == UIState.Screens.HUD then
        return ScreenRouter.Navigate(UIState.Screens.MainMenu)
    end

    return ScreenRouter.CurrentScreen
end

function ScreenRouter.BlocksCombat()
    local view = Store.GetView()
    if view.modal and view.modal.visible then
        return true
    end
    if view.dialogue and view.dialogue.visible then
        return true
    end
    return ScreenRouter.CurrentScreen ~= UIState.Screens.HUD
end

return ScreenRouter
</ProtectedString></Properties></Item><Item class="Folder" referent="RBXF6C66A2B96744403969AFC77C70D66E3"><Properties><string name="Name">Screens</string></Properties><Item class="ModuleScript" referent="RBX39A14C091AEB4F75B668048A1878C1E7"><Properties><string name="Name">Dialogue</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Contextual NPC Dialogue Overlay (Phase 4)
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Screens/Dialogue.lua

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))

local UIFactory = require(script.Parent.Parent:WaitForChild("UIFactory"))
local Store = require(script.Parent.Parent:WaitForChild("Store"))
local ScreenRouter = require(script.Parent.Parent:WaitForChild("ScreenRouter"))
local PremiumPanel = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("PremiumPanel"))
local PremiumButton = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("PremiumButton"))
local QuestController = require(script.Parent.Parent:WaitForChild("Controllers"):WaitForChild("QuestController"))

local Dialogue = {}

function Dialogue.CreateOverlay(parent)
    local colors = Theme.Colors
    local currentActionCommand = nil

    local card = PremiumPanel.Create(parent, {
        name = "DialogueOverlay",
        variant = "gold",
        anchorPoint = Vector2.new(0.5, 1),
        position = UDim2.new(0.5, 0, 1, -32),
        size = UDim2.fromOffset(740, 210),
        visible = false,
        zIndex = 30,
    })

    local portraitBox = UIFactory.Create("Frame", card, {
        Name = "NPCPortrait",
        Position = UDim2.fromOffset(18, 18),
        Size = UDim2.fromOffset(88, 88),
        BackgroundColor3 = colors.BG_900,
        BorderSizePixel = 0,
        ZIndex = 32,
    })
    UIFactory.Corner(portraitBox, Theme.Radius.Medium)
    UIFactory.Stroke(portraitBox, colors.ACCENT_GOLD, 1.6, 0.15)
    UIFactory.Icon(portraitBox, "Core", UDim2.new(0.5, -24, 0.5, -24), 48, colors.ACCENT_GOLD)

    local speakerLabel = UIFactory.Label(card, {
        Name = "NPCName",
        Text = "LYRA • SKY HUB",
        Position = UDim2.fromOffset(122, 16),
        Size = UDim2.new(1, -140, 0, 24),
        TextSize = 18,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
        ZIndex = 32,
    })

    local roleLabel = UIFactory.Label(card, {
        Name = "NPCRole",
        Text = "Lorekeeper of the Core",
        Position = UDim2.fromOffset(122, 38),
        Size = UDim2.new(1, -140, 0, 18),
        TextSize = 12,
        TextColor = colors.ACCENT_SAPPHIRE,
        Bold = true,
        ZIndex = 32,
    })

    local bodyLabel = UIFactory.Label(card, {
        Name = "DialogueText",
        Text = "",
        Position = UDim2.fromOffset(122, 64),
        Size = UDim2.new(1, -144, 0, 76),
        TextSize = 15,
        TextColor = colors.TEXT_PRIMARY,
        YAlign = Enum.TextYAlignment.Top,
        Wrapped = true,
        ZIndex = 32,
    })

    local _, continueBtnApi = PremiumButton.Create(card, {
        name = "ContinueButton",
        label = "TIẾP TỤC / MỞ BẢNG [SPACE]",
        variant = "gold",
        position = UDim2.new(1, -268, 1, -54),
        size = UDim2.fromOffset(250, 40),
        textSize = 12,
        zIndex = 33,
        onActivated = function()
            local cmd = currentActionCommand
            QuestController.CloseDialogue()
            if type(cmd) == "string" and cmd:sub(1, 11) == "OpenScreen:" then
                local targetScreen = cmd:sub(12)
                ScreenRouter.Navigate(targetScreen)
            end
        end,
    })

    PremiumButton.Create(card, {
        name = "SkipButton",
        label = "ĐÓNG [ESC]",
        variant = "secondary",
        position = UDim2.new(1, -392, 1, -54),
        size = UDim2.fromOffset(114, 40),
        textSize = 12,
        zIndex = 33,
        onActivated = function()
            QuestController.CloseDialogue()
        end,
    })

    local api = {
        Instance = card,
    }

    function api:Update(dialogueState)
        dialogueState = dialogueState or {}
        card.Visible = dialogueState.visible == true
        if not card.Visible then
            return
        end
        speakerLabel.Text = dialogueState.speaker or "LYRA • SKY HUB"
        roleLabel.Text = dialogueState.role or "Celestial Archive"
        bodyLabel.Text = dialogueState.text or ""
        currentActionCommand = dialogueState.actionCommand
        if continueBtnApi then
            continueBtnApi:Update({
                label = dialogueState.actionLabel or "TIẾP TỤC / ĐÓNG [SPACE]",
            })
        end
    end

    return card, api
end

return Dialogue
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXC99372877B6D493086BC907FC5421599"><Properties><string name="Name">Forge</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Screen 6: Forge / Upgrade / Socket Station (Section 10, 11, 12)
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Screens/Forge.lua
-- Features:
--   * Live 3D Weapon ViewportFrame (WorldModel + PreviewCamera) with drag-to-rotate &amp; auto-spin
--   * Pending anti-spam lock on Craft/Upgrade + server confirmation pulse animation
--   * Complete material checklist + server RemoteEvent integration

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))
local RarityConfig = require(Shared:WaitForChild("Config"):WaitForChild("RarityConfig"))
local UIAnimator = require(Shared:WaitForChild("UIAnimator"))
local MotionTokens = require(Shared:WaitForChild("MotionTokens"))

local UIFactory = require(script.Parent.Parent:WaitForChild("UIFactory"))
local Store = require(script.Parent.Parent:WaitForChild("Store"))
local PremiumPanel = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("PremiumPanel"))
local PremiumButton = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("PremiumButton"))

local Forge = {
    Refs = {},
    SpinConn = nil,
    DragConn = nil,
    EndConn = nil,
    PendingLock = false,
}

local function getOwnedCount(inventory, itemId)
    for _, entry in ipairs(inventory or {}) do
        if entry.itemId == itemId then
            return entry.count or 0, entry.upgrade or 0
        end
    end
    return 0, 0
end

-- Build an ornate AAA 3D Celestial Weapon Model inside WorldModel for the Forge ViewportFrame
local function build3DWeaponModel(worldModel, outputItem, rarityColor)
    local itemId = tostring(outputItem and outputItem.Id or "Dawnbringer")
    local model = Instance.new("Model")
    model.Name = "SKY_Weapon_" .. itemId

    local bladeColor = rarityColor or Color3.fromHex("#9DE1FF")
    local goldColor = Color3.fromHex("#D7B979")
    local iceColor = Color3.fromHex("#9DE1FF")
    local darkSteel = Color3.fromHex("#132136")

    -- Central Celestial Blade
    local blade = Instance.new("Part")
    blade.Name = "DawnbringerBlade"
    blade.Size = Vector3.new(0.46, 3.7, 0.14)
    blade.CFrame = CFrame.new(0, 0.72, 0)
    blade.Color = bladeColor
    blade.Material = Enum.Material.Neon
    blade.Anchored = true
    blade.CanCollide = false
    blade.Parent = model

    -- Inner Metallic Core Fuller
    local fuller = Instance.new("Part")
    fuller.Name = "BladeCore"
    fuller.Size = Vector3.new(0.22, 3.15, 0.20)
    fuller.CFrame = CFrame.new(0, 0.58, 0)
    fuller.Color = goldColor
    fuller.Material = Enum.Material.Metal
    fuller.Reflectance = 0.45
    fuller.Anchored = true
    fuller.CanCollide = false
    fuller.Parent = model

    -- Swept Winged Celestial Crossguard (Left &amp; Right Articulated Wing Blades)
    for _, side in ipairs({ -1, 1 }) do
        for tier = 1, 3 do
            local wing = Instance.new("Part")
            wing.Name = string.format("CrossguardWing_%d_%d", side, tier)
            wing.Size = Vector3.new(0.85 - tier * 0.15, 0.18, 0.24)
            wing.CFrame = CFrame.new(side * (0.48 + tier * 0.22), -0.98 + tier * 0.08, 0)
                * CFrame.Angles(0, 0, math.rad(side * (24 - tier * 5)))
            wing.Color = (tier == 2) and iceColor or goldColor
            wing.Material = (tier == 2) and Enum.Material.Neon or Enum.Material.Metal
            wing.Reflectance = 0.35
            wing.Anchored = true
            wing.CanCollide = false
            wing.Parent = model
        end
    end

    -- Celestial Halo Ring around the Crossguard Core
    local halo = Instance.new("Part")
    halo.Shape = Enum.PartType.Cylinder
    halo.Name = "AstrolabeHalo"
    halo.Size = Vector3.new(0.12, 1.15, 1.15)
    halo.CFrame = CFrame.new(0, -0.98, 0) * CFrame.Angles(0, math.rad(90), 0)
    halo.Color = goldColor
    halo.Material = Enum.Material.Neon
    halo.Transparency = 0.25
    halo.Anchored = true
    halo.CanCollide = false
    halo.Parent = model

    -- Center Core Gem in Crossguard
    local gem = Instance.new("Part")
    gem.Shape = Enum.PartType.Ball
    gem.Name = "CoreGem"
    gem.Size = Vector3.new(0.48, 0.48, 0.48)
    gem.CFrame = CFrame.new(0, -0.98, 0)
    gem.Color = iceColor
    gem.Material = Enum.Material.Neon
    gem.Anchored = true
    gem.CanCollide = false
    gem.Parent = model

    -- Obsidian Grip &amp; Pommel
    local grip = Instance.new("Part")
    grip.Name = "Grip"
    grip.Size = Vector3.new(0.24, 0.98, 0.24)
    grip.CFrame = CFrame.new(0, -1.65, 0)
    grip.Color = darkSteel
    grip.Material = Enum.Material.SmoothPlastic
    grip.Anchored = true
    grip.CanCollide = false
    grip.Parent = model

    local pommel = Instance.new("Part")
    pommel.Shape = Enum.PartType.Ball
    pommel.Name = "Pommel"
    pommel.Size = Vector3.new(0.42, 0.42, 0.42)
    pommel.CFrame = CFrame.new(0, -2.20, 0)
    pommel.Color = goldColor
    pommel.Material = Enum.Material.Metal
    pommel.Reflectance = 0.4
    pommel.Anchored = true
    pommel.CanCollide = false
    pommel.Parent = model

    model.PrimaryPart = blade
    model.Parent = worldModel
    return model
end

function Forge.Build(parent, responsiveState)
    Forge.Cleanup()
    local colors = Theme.Colors
    local snap = Store.GetSnapshot()
    local view = Store.GetView()
    local isPortrait = responsiveState and responsiveState.IsPortrait

    local root = UIFactory.Create("Frame", parent, {
        Name = "ForgeScreen",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
    })

    -- Left Column: Recipe &amp; Upgrade Blueprint List
    local recipeCard = PremiumPanel.Create(root, {
        name = "RecipeListPanel",
        title = "CELESTIAL FORGE BLUEPRINTS",
        subtitle = "Craft Mythic Blades &amp; Upgrade Equipped Gear",
        position = UDim2.fromOffset(0, 0),
        size = isPortrait and UDim2.new(1, 0, 0.44, -8) or UDim2.new(0.44, -8, 1, 0),
    })

    local recipeScroll = UIFactory.Create("ScrollingFrame", recipeCard, {
        Name = "RecipeScroll",
        Position = UDim2.fromOffset(14, 60),
        Size = UDim2.new(1, -28, 1, -74),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 5,
        ScrollBarImageColor3 = colors.ACCENT_SAPPHIRE,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.fromOffset(0, 0),
    })
    UIFactory.ListLayout(recipeScroll, Enum.FillDirection.Vertical, 8)

    local recipes = RarityConfig.Recipes or RarityConfig.ForgeRecipes or {}
    local selectedRecipe = recipes[1]
    for idx, recipe in ipairs(recipes) do
        if recipe.Id == view.selectedRecipeId then
            selectedRecipe = recipe
        end
        local isSel = (recipe.Id == (view.selectedRecipeId or (recipes[1] and recipes[1].Id)))
        local outItem = RarityConfig.GetItem(recipe.OutputItemId) or RarityConfig.Items.Dawnbringer
        local rInfo = RarityConfig.GetRarity(outItem.Rarity)

        local row = UIFactory.Create("TextButton", recipeScroll, {
            Name = "Recipe_" .. recipe.Id,
            Size = UDim2.new(1, -6, 0, 74),
            BackgroundColor3 = isSel and colors.BG_700 or colors.BG_900,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            LayoutOrder = idx,
        })
        UIFactory.Corner(row, Theme.Radius.Medium)
        UIFactory.Stroke(row, isSel and colors.ACCENT_GOLD or rInfo.Color, isSel and 1.8 or 1.2, 0.2)

        UIFactory.Icon(row, outItem.Icon or "Sword", UDim2.fromOffset(12, 16), 34, rInfo.Color)

        UIFactory.Label(row, {
            Name = "Title",
            Text = recipe.Name,
            Position = UDim2.fromOffset(58, 10),
            Size = UDim2.new(1, -70, 0, 22),
            TextSize = 14,
            TextColor = colors.TEXT_PRIMARY,
            Bold = true,
        })

        UIFactory.Label(row, {
            Name = "Sub",
            Text = string.format("%s  •  Gold Cost: %s", tostring(recipe.Category or recipe.Type or "Craft"), UIFactory.FormatNumber(recipe.GoldCost or 0)),
            Position = UDim2.fromOffset(58, 34),
            Size = UDim2.new(1, -70, 0, 20),
            TextSize = 12,
            TextColor = rInfo.Color,
            Bold = true,
        })

        row.Activated:Connect(function()
            Store.SetView({ selectedRecipeId = recipe.Id })
        end)
    end

    -- Right Column: Forge Anvil Workbench + 3D Rotating Weapon ViewportFrame
    local anvilCard = PremiumPanel.Create(root, {
        name = "AnvilPanel",
        title = string.upper(selectedRecipe.Name),
        subtitle = selectedRecipe.Description,
        position = isPortrait and UDim2.new(0, 0, 0.44, 8) or UDim2.new(0.44, 8, 0, 0),
        size = isPortrait and UDim2.new(1, 0, 0.56, -8) or UDim2.new(0.56, -8, 1, 0),
    })

    local outItem = RarityConfig.GetItem(selectedRecipe.OutputItemId)
    local rInfo = RarityConfig.GetRarity(outItem.Rarity)
    local ownedCount, currentUpgrade = getOwnedCount(snap.inventory, selectedRecipe.OutputItemId)

    -- Section 10 &amp; Section 11: Live 3D Weapon ViewportFrame with WorldModel &amp; PreviewCamera
    local previewBox = UIFactory.Create("Frame", anvilCard, {
        Name = "ForgePreview",
        Position = UDim2.fromOffset(18, 62),
        Size = UDim2.new(1, -36, 0, 128),
        BackgroundColor3 = colors.BG_900,
        BorderSizePixel = 0,
    })
    local previewScale = Instance.new("UIScale")
    previewScale.Name = "UIScale"
    previewScale.Scale = 1.0
    previewScale.Parent = previewBox

    UIFactory.Corner(previewBox, Theme.Radius.Medium)
    UIFactory.Stroke(previewBox, rInfo.Color, 1.6, 0.15)

    local weaponViewport = UIFactory.Create("ViewportFrame", previewBox, {
        Name = "WeaponViewport",
        Position = UDim2.fromOffset(8, 6),
        Size = UDim2.fromOffset(132, 116),
        BackgroundColor3 = colors.BG_800,
        BackgroundTransparency = 0.2,
        Ambient = Color3.fromRGB(185, 205, 235),
        LightColor = Color3.fromRGB(255, 244, 214),
        LightDirection = Vector3.new(-1, -1, -1),
    })
    UIFactory.Corner(weaponViewport, Theme.Radius.Small)
    UIFactory.Stroke(weaponViewport, rInfo.Color, 1.0, 0.35)

    local worldModel = Instance.new("WorldModel")
    worldModel.Name = "WorldModel"
    worldModel.Parent = weaponViewport

    local previewCamera = Instance.new("Camera")
    previewCamera.Name = "PreviewCamera"
    previewCamera.FieldOfView = 36
    previewCamera.Parent = weaponViewport
    weaponViewport.CurrentCamera = previewCamera

    local v5Renderer = nil
    pcall(function()
        v5Renderer = require(ReplicatedStorage:WaitForChild("DelegatedV5Renderer", 2))
    end)
    local weaponModel, weaponClips, isV5Weapon = nil, nil, false
    if v5Renderer then
        local okW, builtW = pcall(v5Renderer.Build, "MythicalWeaponsSet")
        if okW and builtW then
            weaponModel = builtW
            weaponModel.Parent = worldModel
            isV5Weapon = true
            local okC, cRes = pcall(v5Renderer.Clips, "MythicalWeaponsSet")
            if okC and type(cRes) == "table" then
                weaponClips = cRes
            end
        end
    end
    if not weaponModel then
        weaponModel = build3DWeaponModel(worldModel, outItem, rInfo.Color)
    end
    local _, wSize = weaponModel:GetBoundingBox()
    local camDist = isV5Weapon and math.max(wSize.X, wSize.Y, wSize.Z, 3.0) * 1.35 or 5.8
    local yaw = math.rad(28)
    local dragging = false
    local lastX = 0

    local function updateWeaponCam()
        if weaponModel and weaponModel.Parent then
            if isV5Weapon then
                weaponModel:PivotTo(CFrame.new(0, -wSize.Y * 0.35, 0) * CFrame.Angles(0, yaw, 0))
                local activeClip = weaponClips and (weaponClips.ElementalSurge or weaponClips.Idle) or nil
                if activeClip and v5Renderer and v5Renderer.Pose then
                    pcall(v5Renderer.Pose, weaponModel, activeClip, os.clock())
                end
            else
                weaponModel:PivotTo(CFrame.Angles(math.rad(18), yaw, math.rad(-28)))
            end
        end
        previewCamera.CFrame = CFrame.lookAt(Vector3.new(0, 0.25, camDist), Vector3.new(0, 0, 0))
    end
    updateWeaponCam()

    weaponViewport.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            lastX = input.Position.X
        end
    end)

    Forge.EndConn = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    Forge.DragConn = UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local dx = input.Position.X - lastX
            lastX = input.Position.X
            yaw += math.rad(dx * 0.65)
            updateWeaponCam()
        end
    end)

    Forge.SpinConn = RunService.RenderStepped:Connect(function(dt)
        if not weaponViewport.Parent or UIAnimator.ReducedMotion then
            return
        end
        if not dragging then
            yaw += dt * 0.85
            updateWeaponCam()
        end
    end)

    UIFactory.Label(previewBox, {
        Name = "ItemTitle",
        Text = string.format("%s  %s", outItem.Name, currentUpgrade &gt; 0 and ("+" .. currentUpgrade) or ""),
        Position = UDim2.fromOffset(152, 12),
        Size = UDim2.new(1, -166, 0, 26),
        TextSize = 18,
        TextColor = rInfo.Color,
        Bold = true,
    })

    UIFactory.Label(previewBox, {
        Name = "StatsPreview",
        Text = string.format(
            "ATK +%d   •   CRIT +%d%%   •   OWNED: x%d\n3D Preview: Drag weapon to inspect  •  Success Rate: %d%%",
            (outItem.Stats and outItem.Stats.ATK or 0) + (currentUpgrade * 6),
            outItem.Stats and outItem.Stats.CRIT or 0,
            ownedCount,
            math.floor((selectedRecipe.SuccessRate or 1) * 100)
        ),
        Position = UDim2.fromOffset(152, 42),
        Size = UDim2.new(1, -166, 0, 44),
        TextSize = 12,
        TextColor = colors.TEXT_SECONDARY,
    })

    -- Core Shard Socket Badge
    UIFactory.Label(previewBox, {
        Name = "SocketInfo",
        Text = "◈ CELESTIAL SOCKET: Compatible with Core of Light &amp; Void Essence Shards",
        Position = UDim2.fromOffset(152, 92),
        Size = UDim2.new(1, -166, 0, 22),
        TextSize = 11,
        TextColor = colors.ACCENT_ICE,
        Bold = true,
    })

    -- Material Requirements Header
    UIFactory.Label(anvilCard, {
        Name = "MatHeader",
        Text = "REQUIRED MATERIALS &amp; CURRENCY",
        Position = UDim2.fromOffset(18, 200),
        Size = UDim2.new(1, -36, 0, 20),
        TextSize = 12,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
    })

    local matList = UIFactory.Create("Frame", anvilCard, {
        Name = "MaterialList",
        Position = UDim2.fromOffset(18, 224),
        Size = UDim2.new(1, -36, 0, 148),
        BackgroundTransparency = 1,
    })
    UIFactory.ListLayout(matList, Enum.FillDirection.Vertical, 6)

    local allSatisfied = (snap.currency.gold &gt;= (selectedRecipe.GoldCost or 0))
    for idx, mat in ipairs(selectedRecipe.Materials or {}) do
        local matId = mat.ItemId or mat.itemId
        local reqCount = mat.Count or mat.count or 1
        local mCfg = RarityConfig.GetItem(matId) or { Name = tostring(matId) }
        local have = getOwnedCount(snap.inventory, matId)
        local ok = have &gt;= reqCount
        if not ok then
            allSatisfied = false
        end

        local mRow = UIFactory.Create("Frame", matList, {
            Name = "Mat_" .. tostring(matId),
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundColor3 = colors.BG_900,
            BorderSizePixel = 0,
            LayoutOrder = idx,
        })
        UIFactory.Corner(mRow, Theme.Radius.Small)
        UIFactory.Stroke(mRow, ok and colors.SUCCESS or colors.DANGER, 1, 0.35)

        UIFactory.Label(mRow, {
            Name = "Name",
            Text = mCfg.Name,
            Position = UDim2.fromOffset(12, 0),
            Size = UDim2.new(0.65, -12, 1, 0),
            TextSize = 13,
            TextColor = colors.TEXT_PRIMARY,
            Bold = true,
        })

        UIFactory.Label(mRow, {
            Name = "Count",
            Text = string.format("%d / %d", have, reqCount),
            Position = UDim2.new(0.65, 0, 0, 0),
            Size = UDim2.new(0.35, -12, 1, 0),
            TextSize = 13,
            TextColor = ok and colors.SUCCESS or colors.DANGER,
            Bold = true,
            XAlign = Enum.TextXAlignment.Right,
        })
    end

    -- Gold Check Row
    local goldOk = snap.currency.gold &gt;= (selectedRecipe.GoldCost or 0)
    local gRow = UIFactory.Create("Frame", matList, {
        Name = "GoldRow",
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = colors.BG_900,
        BorderSizePixel = 0,
        LayoutOrder = 99,
    })
    UIFactory.Corner(gRow, Theme.Radius.Small)
    UIFactory.Stroke(gRow, goldOk and colors.ACCENT_GOLD or colors.DANGER, 1, 0.35)

    UIFactory.Label(gRow, {
        Name = "GoldName",
        Text = "Gold Required",
        Position = UDim2.fromOffset(12, 0),
        Size = UDim2.new(0.6, -12, 1, 0),
        TextSize = 13,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
    })

    UIFactory.Label(gRow, {
        Name = "GoldCount",
        Text = string.format("%s / %s", UIFactory.FormatNumber(snap.currency.gold), UIFactory.FormatNumber(selectedRecipe.GoldCost)),
        Position = UDim2.new(0.6, 0, 0, 0),
        Size = UDim2.new(0.4, -12, 1, 0),
        TextSize = 13,
        TextColor = goldOk and colors.SUCCESS or colors.DANGER,
        Bold = true,
        XAlign = Enum.TextXAlignment.Right,
    })

    -- Craft / Upgrade Action Button with Pending Lock &amp; Craft Pulse Animation
    local _, craftBtnApi = PremiumButton.Create(anvilCard, {
        name = "CraftButton",
        label = allSatisfied
            and (selectedRecipe.Type == "Craft" and "⚒  FORGE CELESTIAL WEAPON" or "⬆  UPGRADE WEAPON (+1)")
            or "INSUFFICIENT MATERIALS / GOLD",
        variant = allSatisfied and "gold" or "secondary",
        disabled = not allSatisfied or Forge.PendingLock,
        position = UDim2.new(0, 18, 1, -56),
        size = UDim2.new(1, -36, 0, 44),
        textSize = 14,
        onActivated = function()
            if Forge.PendingLock then
                return
            end
            Forge.PendingLock = true
            craftBtnApi:Update({
                label = "⏳ FORGING CELESTIAL ALLOY...",
                disabled = true,
            })

            -- Section 11: Craft pulse animation on ForgePreview
            if previewScale and previewScale.Parent then
                previewScale.Scale = 1.06
                UIAnimator.Tween(previewScale, { Scale = 1.0 }, MotionTokens.questComplete.duration, MotionTokens.questComplete.style, MotionTokens.questComplete.direction)
            end

            task.delay(0.28, function()
                Forge.PendingLock = false
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                if remotes and not snap.isDemoMode then
                    if selectedRecipe.ServerRemote == "ForgeRequest" and remotes:FindFirstChild("ForgeRequest") then
                        remotes.ForgeRequest:FireServer()
                        Store.ShowToast("Forging Dawnbringer at the Celestial Anvil...", "info")
                        return
                    elseif selectedRecipe.ServerRemote == "EquipmentRequest" and remotes:FindFirstChild("EquipmentRequest") then
                        remotes.EquipmentRequest:FireServer({
                            action = "Upgrade",
                            itemId = selectedRecipe.OutputItemId,
                        })
                        Store.ShowToast("Upgrading " .. outItem.Name .. "...", "info")
                        return
                    end
                end
                Store.ApplyDemoPreviewAction("ForgeRecipe", { recipeId = selectedRecipe.Id })
            end)
        end,
    })

    Forge.Refs = {
        Root = root,
        WeaponViewport = weaponViewport,
        CraftBtnApi = craftBtnApi,
    }
    return root
end

function Forge.Update()
    if Forge.Refs.Root and Forge.Refs.Root.Parent then
        local parent = Forge.Refs.Root.Parent
        Forge.Build(parent)
    end
end

function Forge.Cleanup()
    if Forge.SpinConn then
        Forge.SpinConn:Disconnect()
        Forge.SpinConn = nil
    end
    if Forge.DragConn then
        Forge.DragConn:Disconnect()
        Forge.DragConn = nil
    end
    if Forge.EndConn then
        Forge.EndConn:Disconnect()
        Forge.EndConn = nil
    end
    Forge.PendingLock = false
    Forge.Refs = {}
end

return Forge
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX829CE7329517441EAFBDEFBE76E3F141"><Properties><string name="Name">Fruits</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Separated 3D Devil Fruits &amp; Awakening Screen ([G])
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Screens/Fruits.lua

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))
local UIState = require(Shared:WaitForChild("Types"):WaitForChild("UIState"))

local UIFactory = require(script.Parent.Parent:WaitForChild("UIFactory"))
local Store = require(script.Parent.Parent:WaitForChild("Store"))
local ScreenRouter = require(script.Parent.Parent:WaitForChild("ScreenRouter"))
local PremiumPanel = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("PremiumPanel"))
local PremiumButton = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("PremiumButton"))
local HUDController = require(script.Parent.Parent:WaitForChild("Controllers"):WaitForChild("HUDController"))

local Renderer = nil
pcall(function()
    Renderer = require(ReplicatedStorage:WaitForChild("DelegatedV5Renderer", 3))
end)

local Fruits = {
    SelectedFruitId = nil,
    SpinConnection = nil,
}

local FRUIT_CATALOG = {
    {
        Id = "GaleCore",
        Asset = "Fruit_GaleCore",
        Name = "Trái Cuồng Phong (Gale Core)",
        Rarity = "Common",
        Type = "Elemental (Logia)",
        Element = "Sky",
        Color = Color3.fromRGB(165, 245, 215),
