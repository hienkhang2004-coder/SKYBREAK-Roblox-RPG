            { Phase = 2, Name = "AEGIS CONDUIT", Threshold = "65% – 30% HP", Mechanic = "Boss deploys invulnerable Energy Shield. Destroy 2 Energy Pylons (-24, +24) to trigger Break stun!" },
            { Phase = 3, Name = "OVERDRIVE DAWN", Threshold = "30% – 0% HP", Mechanic = "Accelerated attack tempo (0.6s windup) and double targeted solar strikes." },
