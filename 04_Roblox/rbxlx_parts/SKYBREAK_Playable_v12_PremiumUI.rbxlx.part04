    NPCs = { "Lyra (Lorekeeper)", "Kael (Master Blacksmith)", "Astrael (Astral Vanguard)" },
}

-- Canonical 8 Floating Realms (Section 08 of Build Guide)
WorldConfig.Realms = {
    {
        Order = 1,
        Id = "GoldenSky",
        Name = "Golden Sky",
        VietnameseName = "Bầu Trời Hoàng Kim",
        LevelRange = "Lv. 1–10",
        MinLevel = 1,
        MaxLevel = 10,
        BossId = "AureonSentinel",
        BossName = "Aureon Sentinel",
        BossTitle = "Warden of the Sun Citadel",
        MapPosition = Vector2.new(0.22, 0.22),
        AccentColor = Theme.Colors.ACCENT_GOLD,
        Chapter = "Chapter I — The Fallen Light",
        Objectives = {
            "Train against Skyborn Drones &amp; Corrupted Guards",
            "Reactivate the 3 Energy Stations across the Sky Bridge",
            "Defeat Golden Knight &amp; reclaim the Sun Citadel Key",
            "Vanquish Aureon Sentinel and recover the Core of Light",
        },
        Description = "Sunlit marble citadels and shattered sky-bridges guarded by solar constructs.",
        FastTravelUnlockedByDefault = true,
    },
    {
        Order = 2,
        Id = "FrozenCyber",
        Name = "Frozen Cyber",
        VietnameseName = "Băng Thành Cơ Giới",
        LevelRange = "Lv. 11–20",
        MinLevel = 11,
        MaxLevel = 20,
        BossId = "CryonPrime",
        BossName = "Cryon Prime",
        BossTitle = "Sub-Zero Sovereign Construct",
        MapPosition = Vector2.new(0.50, 0.14),
        AccentColor = Theme.Colors.ACCENT_SAPPHIRE,
        Chapter = "Chapter II — Absolute Zero Protocol",
        Objectives = {
            "Traverse the cryo-data conduits beyond the Frozen Portal",
            "Disrupt Cryon's sub-zero resonance pillars",
            "Defeat Cryon Prime in the Glacial Reactor Core",
        },
        Description = "Glacial spires fused with ancient cybernetic data-conduits and frost storms.",
        UnlockConditionText = "Complete Quest Q05 (Defeat Aureon Sentinel)",
    },
    {
        Order = 3,
        Id = "ShadowRealm",
        Name = "Shadow Realm",
        VietnameseName = "Vực Thẳm Hư Ảnh",
        LevelRange = "Lv. 21–30",
        MinLevel = 21,
        MaxLevel = 30,
        BossId = "Noxar",
        BossName = "Noxar",
        BossTitle = "The Eclipsed Fallen Guardian",
        MapPosition = Vector2.new(0.78, 0.22),
        AccentColor = Theme.Colors.VOID_PURPLE,
        Chapter = "Chapter III — Eclipse of Astrael",
        Objectives = {
            "Breach the Shadow Fortress and stabilize the 4 Safe-Zone Pillars",
            "Survive Noxar's 3 Combat Phases",
            "Complete the Final Core Purification ritual to free Astrael",
        },
        Description = "An obsidian citadel suspended in perpetual eclipse where Noxar's void chains bind the fallen guardian.",
        UnlockConditionText = "Clear Frozen Cyber &amp; reach Level 21",
    },
    {
        Order = 4,
        Id = "VerdantCrown",
        Name = "Verdant Crown",
        VietnameseName = "Vương Miện Cổ Thụ",
        LevelRange = "Lv. 31–42",
        MinLevel = 31,
        MaxLevel = 42,
        BossId = "Sylvaris",
        BossName = "Sylvaris",
        BossTitle = "Elder Archon of the World-Bough",
        MapPosition = Vector2.new(0.84, 0.50),
        AccentColor = Theme.Colors.SUCCESS,
        Chapter = "Chapter IV — Roots of the Aether",
        Objectives = {
            "Ascend the petrified sky-canopy and cleanse the Aether Sap",
            "Awaken the First Celestial Anchor",
            "Defeat Sylvaris in the Heartwood Sanctuary",
        },
        Description = "Colossal bioluminescent sky-forests whose roots hold drifting islands together.",
        UnlockConditionText = "Purify Noxar in Shadow Realm &amp; reach Level 31",
    },
    {
        Order = 5,
        Id = "EmberforgeWastes",
        Name = "Emberforge Wastes",
        VietnameseName = "Hoang Mạc Lò Rèn Lửa",
        LevelRange = "Lv. 43–54",
        MinLevel = 43,
        MaxLevel = 54,
        BossId = "Ignivar",
        BossName = "Ignivar",
        BossTitle = "Titan of the Molten Crucible",
        MapPosition = Vector2.new(0.78, 0.78),
        AccentColor = Color3.fromRGB(245, 130, 72),
        Chapter = "Chapter V — Crucible of Stars",
        Objectives = {
            "Cross the slag viaducts and cool the overheated Star-Forges",
            "Restore the Second Celestial Anchor",
            "Subdue Ignivar at the Molten Anvil",
        },
        Description = "Volcanic foundry-islands where ancient titans once forged the Celestial Anchors.",
        UnlockConditionText = "Restore Verdant Crown &amp; reach Level 43",
    },
    {
        Order = 6,
        Id = "AbyssalTides",
        Name = "Abyssal Tides",
        VietnameseName = "Thủy Triều Vực Sâu",
        LevelRange = "Lv. 55–66",
        MinLevel = 55,
        MaxLevel = 66,
        BossId = "Nerith",
        BossName = "Nerith",
        BossTitle = "Leviathan of the Inverted Sea",
        MapPosition = Vector2.new(0.50, 0.86),
        AccentColor = Color3.fromRGB(56, 196, 224),
        Chapter = "Chapter VI — The Inverted Ocean",
        Objectives = {
            "Navigate the suspended water-spheres and sunken cathedrals",
            "Restore the Third Celestial Anchor",
            "Defeat Nerith within the Maelstrom Choir",
        },
        Description = "Gravity-defying ocean spheres and coral temples floating above the abyss.",
        UnlockConditionText = "Restore Emberforge Wastes &amp; reach Level 55",
    },
    {
        Order = 7,
        Id = "ChronosBastion",
        Name = "Chronos Bastion",
        VietnameseName = "Pháo Đài Thời Gian Chronos",
        LevelRange = "Lv. 67–80",
        MinLevel = 67,
        MaxLevel = 80,
        BossId = "Aion",
        BossName = "Aion",
        BossTitle = "Keeper of the Fractured Pendulum",
        MapPosition = Vector2.new(0.22, 0.78),
        AccentColor = Theme.Colors.ACCENT_GOLD,
        Chapter = "Chapter VII — Shattered Horology",
        Objectives = {
            "Synchronize the temporal astrolabes across time-locked rings",
            "Restore the Fourth Celestial Anchor",
            "Defeat Aion before the timeline collapses",
        },
        Description = "A clockwork citadel where past and future collide in golden astrolabe rings.",
        UnlockConditionText = "Restore Abyssal Tides &amp; reach Level 67",
    },
    {
        Order = 8,
        Id = "VeilsEnd",
        Name = "Veil's End",
        VietnameseName = "Tận Cùng Bức Màn — Veil's End",
        LevelRange = "Lv. 81–100",
        MinLevel = 81,
        MaxLevel = 100,
        BossId = "Veyr",
        BossName = "Veyr, The First Architect",
        BossTitle = "Sovereign of the Unmaking",
        MapPosition = Vector2.new(0.16, 0.50),
        AccentColor = Theme.Colors.VOID_PURPLE,
        Chapter = "Finale — Fragments of the Core",
        Objectives = {
            "Defend all 4 Celestial Anchors against Void Beacons",
            "Withstand Veyr's 4 Ascension Phases",
            "Survive Reality Severance and reforge the Prime Sky Core",
        },
        Description = "The event horizon beyond the sky where Veyr, The First Architect, seeks to unmake creation.",
        UnlockConditionText = "Restore all 4 Celestial Anchors &amp; reach Level 81",
    },
}

WorldConfig.RealmById = {}
for _, realm in ipairs(WorldConfig.Realms) do
    realm.FastTravelUnlockedByDefault = true
    WorldConfig.RealmById[realm.Id] = realm
end
WorldConfig.RealmById.SkyHub = WorldConfig.Hub

-- Grand Sky Seas Islands &amp; Landmarks (15 Storyline Zones across 3 Seas, Lv. 1–30 + Expansion Realms Lv. 31–100)
WorldConfig.Islands = {
    -- Sea 1: Golden Sky Archipelago (Lv. 1–10)
    { Id = "SkyHub", Name = "Zone 1: Sky Hub Nexus", VietnameseName = "Đảo Khởi Đầu Sky Hub", RealmId = "GoldenSky", LevelRange = "Lv. 1–3", Pos = Vector3.new(-92, 42, 153) },
    { Id = "ZiolesGachaShrine", Name = "Zone 1B: Zioles Gacha Shrine", VietnameseName = "Điện Thờ Zioles Gacha", RealmId = "GoldenSky", LevelRange = "Lv. 2–5", Pos = Vector3.new(-220, 42, 272) },
