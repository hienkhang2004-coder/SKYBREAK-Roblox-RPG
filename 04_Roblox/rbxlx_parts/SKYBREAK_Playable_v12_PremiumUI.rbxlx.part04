        PurificationLabel = "FINAL STEP: CORE PURIFICATION",
        AccentColor = Theme.Colors.VOID_PURPLE,
        Phases = {
            { Phase = 1, Name = "SHACKLED ECLIPSE", Threshold = "100% – 70% HP", Mechanic = "Umbral cleaves and shadow tether chains." },
            { Phase = 2, Name = "CRIMSON SOVEREIGN", Threshold = "70% – 35% HP", Mechanic = "Armor fractures ignite; seek shelter inside the 4 Shadow Sanctuary Pillars." },
            { Phase = 3, Name = "ABYSSAL RESONANCE", Threshold = "35% – 1% HP", Mechanic = "Relentless void shockwaves until posture breaks." },
