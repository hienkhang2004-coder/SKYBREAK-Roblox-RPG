        LevelReq = 1, Icon = "Gem", Stats = {}, Description = "Quặng sắt lơ lửng thu thập từ các đảo cổ.",
    },
    CelestialFeather = {
        Id = "CelestialFeather", Name = "Celestial Feather", Category = "Materials", Rarity = "Epic",
        LevelReq = 1, Icon = "Gem", Stats = {}, Description = "Lông vũ phát sáng dùng trong chế tác giáp trụ.",
    },
    CoreEssence = {
        Id = "CoreEssence", Name = "Core Essence", Category = "Materials", Rarity = "Mythic",
        LevelReq = 1, Icon = "Core", Stats = {}, Description = "Tinh chất lõi năng lượng thuần khiết từ Boss.",
    },
}

-- Kael's Celestial Forge Recipes (Section 04.G)
RarityConfig.Recipes = {
    {
        Id = "craft_dawnbringer",
        OutputItemId = "Dawnbringer",
        OutputCount = 1,
        Name = "Dawnbringer",
        Category = "Weapon",
        LevelReq = 10,
        GoldCost = 500,
        CoreShardCost = 10,
        Materials = {
            { ItemId = "DawnbringerBlueprint", Count = 1 },
            { ItemId = "CoreOfLight", Count = 1 },
            { ItemId = "upgrade_material", Count = 5 },
        },
        Description = "Bind the Core of Light into the legendary solar greatsword.",
    },
    {
        Id = "craft_stormfang",
        OutputItemId = "Stormfang",
        OutputCount = 1,
        Name = "Stormfang",
        Category = "Weapon",
        LevelReq = 20,
        GoldCost = 1200,
        CoreShardCost = 25,
        Materials = {
            { ItemId = "SkyCrystal", Count = 10 },
            { ItemId = "upgrade_material", Count = 8 },
        },
        Description = "Synthesize high-frequency twin daggers infused with Frozen Cyber lightning.",
    },
    {
        Id = "craft_eternal_frost",
        OutputItemId = "EternalFrost",
        OutputCount = 1,
        Name = "Eternal Frost",
        Category = "Weapon",
        LevelReq = 20,
        GoldCost = 1200,
        CoreShardCost = 25,
        Materials = {
            { ItemId = "SkyCrystal", Count = 12 },
            { ItemId = "upgrade_material", Count = 8 },
        },
        Description = "Channel sub-zero resonance into a legendary Arcane Mage staff.",
    },
    {
        Id = "craft_celestial_plate",
        OutputItemId = "CelestialPlate",
        OutputCount = 1,
        Name = "Celestial Aegis Plate",
        Category = "Armor",
        LevelReq = 15,
        GoldCost = 800,
        CoreShardCost = 15,
        Materials = {
            { ItemId = "SkyCrystal", Count = 6 },
            { ItemId = "upgrade_material", Count = 5 },
        },
        Description = "Forge obsidian-sapphire heavy armor for frontline survival.",
    },
    {
        Id = "craft_solar_band",
        OutputItemId = "SolarBand",
        OutputCount = 1,
        Name = "Solar Band",
        Category = "Accessory",
        LevelReq = 12,
        GoldCost = 600,
        CoreShardCost = 12,
        Materials = {
            { ItemId = "SkyCrystal", Count = 4 },
            { ItemId = "upgrade_material", Count = 3 },
        },
        Description = "Craft a champagne-gold ring that accelerates Energy recovery.",
    },
}

function RarityConfig.GetRarity(rarityId)
    return RarityConfig.Rarities[rarityId] or RarityConfig.Rarities.Common
end

function RarityConfig.GetItem(itemId)
    return RarityConfig.Items[itemId]
end

function RarityConfig.GetUpgradeCost(itemId, currentUpgrade)
    local item = RarityConfig.GetItem(itemId)
    local rarity = RarityConfig.GetRarity(item and item.Rarity or "Common")
    local nextLevel = (currentUpgrade or 0) + 1
    return {
        NextUpgrade = nextLevel,
        MaxUpgrade = rarity.MaxUpgrade,
        CanUpgrade = nextLevel &lt;= rarity.MaxUpgrade,
        GoldCost = math.floor(120 * nextLevel * rarity.Tier),
        MaterialId = "upgrade_material",
        MaterialCount = math.max(1, math.floor(nextLevel * 0.8 + rarity.Tier * 0.5)),
    }
end

return RarityConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3FE777C26525402E84245EDC5427B324"><Properties><string name="Name">Theme</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Design System &amp; Tokens
-- Style: Celestial Obsidian / Sapphire / Champagne Gold (70% Dark Neutral / 20% Sapphire / 10% Gold)
-- Location: ReplicatedStorage/SkybreakShared/Config/Theme.lua

local Theme = {}

Theme.Colors = {
    -- Canonical Design Tokens (from SKYBREAK_PREMIUM_UI_UX_BUILD_GUIDE.md Section 02)
    BG_900 = Color3.fromRGB(8, 15, 29),          -- #080F1D Deepest Obsidian Background
    BG_800 = Color3.fromRGB(14, 25, 43),         -- #0E192B Dark Glass Panel
    BG_700 = Color3.fromRGB(19, 35, 57),         -- #132339 Elevated / Hover Panel
    SURFACE_GLASS = Color3.fromRGB(25, 46, 71),  -- #192E47 Translucent Glass Surface
    STROKE_STEEL = Color3.fromRGB(76, 104, 134), -- #4C6886 Fine Metallic Border
    TEXT_PRIMARY = Color3.fromRGB(240, 244, 250),-- #F0F4FA Primary Crisp Text
    TEXT_SECONDARY = Color3.fromRGB(168, 185, 209), -- #A8B9D1 Muted / Secondary Text
    ACCENT_SAPPHIRE = Color3.fromRGB(64, 170, 255), -- #40AAFF Primary CTA / Selected / Mana
    ACCENT_DEEP_BLUE = Color3.fromRGB(21, 78, 168), -- #154EA8 CTA Gradient Bottom
    ACCENT_ICE = Color3.fromHex("#9DE1FF"),      -- #9DE1FF Ice Blue Highlight
    ACCENT_GOLD = Color3.fromRGB(228, 184, 99),  -- #E4B863 Champagne Gold / Legendary / Title
    ACCENT_GOLD_BRIGHT = Color3.fromHex("#FFE29A"), -- #FFE29A Bright Gold Hover
    TEXT_MUTED = Color3.fromHex("#A9B5C7"),      -- #A9B5C7 Muted Text
    HP_RED = Color3.fromRGB(239, 82, 98),        -- #EF5262 Health / Danger / Warning
    DANGER = Color3.fromHex("#F26A70"),          -- #F26A70 Danger / Error
    SUCCESS = Color3.fromRGB(94, 215, 158),      -- #5ED79E Completed / Available / Valid
    VOID_PURPLE = Color3.fromRGB(180, 106, 250), -- #B46AFA Void / Epic / Boss Veyr / Break

    -- Semantic &amp; Ergonomic Aliases (compatible with Section 10.1 production snippets)
    Background = Color3.fromRGB(8, 15, 29),
    Panel = Color3.fromRGB(14, 25, 43),
    PanelHover = Color3.fromRGB(19, 35, 57),
    Glass = Color3.fromRGB(25, 46, 71),
    Stroke = Color3.fromRGB(76, 104, 134),
    Text = Color3.fromRGB(240, 244, 250),
    Muted = Color3.fromRGB(168, 185, 209),
    Sapphire = Color3.fromRGB(64, 170, 255),
    DeepBlue = Color3.fromRGB(21, 78, 168),
    Gold = Color3.fromRGB(228, 184, 99),
    HP = Color3.fromRGB(239, 82, 98),
    Success = Color3.fromRGB(94, 215, 158),
    VoidPurple = Color3.fromRGB(180, 106, 250),
    Warning = Color3.fromRGB(245, 166, 66),
}

Theme.Fonts = {
    Regular = Enum.Font.Gotham,
    Medium = Enum.Font.GothamMedium,
    Bold = Enum.Font.GothamBold,
    Heading = Enum.Font.GothamBold,
    Title = Enum.Font.GothamBold,
    Lore = Enum.Font.GothamMedium,
}

Theme.TextSize = {
    Display = 34,
    Title = 26,
    Heading = 18,
    Body = 14,
    Caption = 12,
}

Theme.Typography = {
    Logo = { Size = 44, Font = Enum.Font.GothamBold },
    PageTitle = { Size = 26, Font = Enum.Font.GothamBold },
    PanelHeading = { Size = 18, Font = Enum.Font.GothamBold },
    Body = { Size = 15, Font = Enum.Font.Gotham },
    Label = { Size = 13, Font = Enum.Font.GothamMedium },
    Stat = { Size = 16, Font = Enum.Font.GothamBold },
    Caption = { Size = 12, Font = Enum.Font.GothamMedium },
}

Theme.Spacing = {
    XS = 4,
    S = 8,
    M = 12,
    L = 16,
    XL = 24,
    XXL = 32,
}

Theme.Radius = {
    Slot = 6,
    Small = 6,
    Medium = 10,
    Large = 12,
    Pill = 999,
}

Theme.Stroke = {
    Thin = 1,
    Default = 1.5,
    Thick = 2,
    AlphaDefault = 0.32,
    AlphaSubtle = 0.45,
    AlphaGold = 0.14,
    AlphaActive = 0.08,
}

Theme.Transparency = {
    Panel = 0.06,
    Elevated = 0.04,
    Glass = 0.18,
    ModalBackdrop = 0.32,
    HUDCard = 0.12,
}

Theme.Motion = {
    Hover = 0.14,
    Press = 0.08,
    Open = 0.22,
    HP = 0.22,
    Tooltip = 0.12,
    Reward = 0.18,
    BossPhase = 0.35,
}

Theme.Layout = {
    DesktopButtonHeight = 48,
    TouchButtonHeight = 54,
    MinTouchTarget = 44,
    PanelPadding = 16,
    CompactPadding = 10,
}

function Theme.GetColor(tokenOrColor)
    if typeof(tokenOrColor) == "Color3" then
        return tokenOrColor
    end
    return Theme.Colors[tokenOrColor] or Theme.Colors.TEXT_PRIMARY
end

return Theme
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXDDFA013C60F9485185CB9D6E9CDA3149"><Properties><string name="Name">UIAssets</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — UI Asset Manifest
-- Location: ReplicatedStorage/SkybreakShared/Config/UIAssets.lua
-- Rule: Never fabricate fake rbxassetid:// IDs. Un-uploaded assets stay "" and trigger clean procedural Roblox GUI fallbacks.

local UIAssets = {
    -- Core Brand &amp; 9-Slice Frames (Fill with real rbxassetid:// after Creator Hub upload)
    Logo = "",                 -- ui_logo_skybreak (PNG transparent)
    PanelNineSlice = "",       -- ui_panel_9slice (PNG 9-slice frame)
    ButtonNineSlice = "",      -- ui_button_primary_9slice (PNG 9-slice button texture)
    WorldMapBackground = "",   -- ui_map_worlds (Clean map background without baked text)
    MainMenuBackground = "",   -- ui_mainmenu_bg (Sky Hub vista fallback when 3D scene not active)
    SoftGlow = "",             -- ui_fx_glow_soft (Subtle alpha radial glow)

    -- Optional Verified Project Atlas (only used when UseProjectAtlas is explicitly enabled)
    UseProjectAtlas = false,
    ProjectIconAtlas = "rbxassetid://100014627871168",
    ProjectRealmPreview = "rbxassetid://84846582893628",

    -- 9-Slice Center Rectangles (configured for 64x64 or 128x128 9-slice textures once uploaded)
    NineSliceRects = {
        Panel = Rect.new(16, 16, 48, 48),
        Button = Rect.new(12, 12, 52, 52),
    },

    -- Individual Icon Asset IDs (Empty string = procedural geometric/vector fallback in UIFactory)
    Icons = {
        Sword = "",
        Daggers = "",
        Staff = "",
        Shield = "",
        Bolt = "",
        Frost = "",
        Bag = "",
        Skill = "",
        Quest = "",
        Map = "",
        Forge = "",
        Raid = "",
        Settings = "",
        Close = "",
        Gold = "",
        CoreShard = "",
        VoidEssence = "",
        Anchor = "",
        Lock = "",
        Check = "",
        Star = "",
        Heart = "",
    },

    -- Rarity Border Frame Textures (Empty string = procedural UIStroke + UIGradient by RarityConfig)
    RarityBorders = {
        Common = "",
        Rare = "",
        Epic = "",
        Legendary = "",
        Mythic = "",
    },

    -- Class Portraits (Empty string = live ViewportFrame 3D clone or procedural crest fallback)
    ClassPortraits = {
        SkyGuardian = "",
        ThunderStriker = "",
        ArcaneMage = "",
    },

    -- Boss Portraits for World Map &amp; Raid UI (Empty string = procedural boss emblem badge)
    BossPortraits = {
        AureonSentinel = "",
        CryonPrime = "",
        Noxar = "",
        Sylvaris = "",
        Ignivar = "",
        Nerith = "",
        Aion = "",
        Veyr = "",
    },
}

function UIAssets.IsValidAssetId(assetId)
    return type(assetId) == "string"
        and #assetId &gt; 13
        and string.sub(assetId, 1, 13) == "rbxassetid://"
        and tonumber(string.sub(assetId, 14)) ~= nil
end

function UIAssets.GetIcon(iconName)
    local id = UIAssets.Icons[iconName]
    if UIAssets.IsValidAssetId(id) then
        return id
    end
    return nil
end

function UIAssets.GetPendingUploadList()
    local pending = {}
    local topKeys = { "Logo", "PanelNineSlice", "ButtonNineSlice", "WorldMapBackground", "MainMenuBackground", "SoftGlow" }
    for _, key in ipairs(topKeys) do
        if not UIAssets.IsValidAssetId(UIAssets[key]) then
            table.insert(pending, { Category = "CoreUI", Key = key, SuggestedFile = "ui_" .. string.lower(key) .. ".png" })
        end
    end
    for key, val in pairs(UIAssets.Icons) do
        if not UIAssets.IsValidAssetId(val) then
            table.insert(pending, { Category = "Icons", Key = key, SuggestedFile = "ui_icon_" .. string.lower(key) .. ".png" })
        end
    end
    for key, val in pairs(UIAssets.ClassPortraits) do
        if not UIAssets.IsValidAssetId(val) then
            table.insert(pending, { Category = "ClassPortraits", Key = key, SuggestedFile = "ui_class_" .. string.lower(key) .. "_portrait.png" })
        end
    end
    for key, val in pairs(UIAssets.BossPortraits) do
        if not UIAssets.IsValidAssetId(val) then
            table.insert(pending, { Category = "BossPortraits", Key = key, SuggestedFile = "ui_boss_" .. string.lower(key) .. "_portrait.png" })
        end
    end
    table.sort(pending, function(a, b)
        if a.Category ~= b.Category then
            return a.Category &lt; b.Category
        end
        return a.Key &lt; b.Key
    end)
    return pending
end

return UIAssets
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXB31698A6BBCD4AFDB1C942568F96354E"><Properties><string name="Name">WorldConfig</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Canonical V2 World, Class, Skill, Quest &amp; Raid Data
-- Location: ReplicatedStorage/SkybreakShared/Config/WorldConfig.lua
-- Canonical Specification: Max Level 100, Central Sky Hub + 8 Floating Realms, 3 Classes, Final Boss Veyr.

local Theme = require(script.Parent.Theme)

local WorldConfig = {}

WorldConfig.MaxLevel = 100
WorldConfig.MVPChapterMaxLevel = 10

-- Central Hub
WorldConfig.Hub = {
    Id = "SkyHub",
