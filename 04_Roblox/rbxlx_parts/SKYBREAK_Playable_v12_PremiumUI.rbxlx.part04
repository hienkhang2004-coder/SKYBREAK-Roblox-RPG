	G.SpawnEnemy("ArcticCorsair",Vector3.new(-2374.0,122.5,-2384.0),false)
	G.SpawnEnemy("TerrorSkyShark",Vector3.new(-2416.0,122.5,-2374.0),false)
	G.SpawnEnemy("TerrorSkyShark",Vector3.new(-2384.0,122.5,-2374.0),false)
	G.SpawnEnemy("Nerith",Vector3.new(-2400.0,122.5,-2378.0),false)
	-- 21. ChronosBastion (deckY = 180.0, TempleOfTheCoreRaceV4 clone dx=±10, dz=±8)
	G.SpawnEnemy("MechaDrone",Vector3.new(-10.0,182.5,-4192.0),false)
	G.SpawnEnemy("MechaDrone",Vector3.new(10.0,182.5,-4192.0),false)
	G.SpawnEnemy("CryoVanguard",Vector3.new(-10.0,182.5,-4204.0),false)
	G.SpawnEnemy("CryoVanguard",Vector3.new(10.0,182.5,-4204.0),false)
	G.SpawnEnemy("Aion",Vector3.new(0.0,182.5,-4206.0),false)
	-- 22. VeilsEnd (deckY = 260.0, CastleOnTheVoidMansion clone dx=±8.3, dz=±8.3)
	G.SpawnEnemy("ShadowSpecter",Vector3.new(-8.3,262.5,-5791.7),false)
	G.SpawnEnemy("ShadowSpecter",Vector3.new(8.3,262.5,-5791.7),false)
	G.SpawnEnemy("AbyssalDreadknight",Vector3.new(-8.3,262.5,-5808.3),false)
	G.SpawnEnemy("AbyssalDreadknight",Vector3.new(8.3,262.5,-5808.3),false)
	G.SpawnEnemy("AbyssalDragonHybrid",Vector3.new(-11.7,262.5,-5800.0),false)
	G.SpawnEnemy("AbyssalDragonHybrid",Vector3.new(11.7,262.5,-5800.0),false)
	G.SpawnEnemy("Veyr",Vector3.new(0.0,262.5,-5811.7),false)

	task.spawn(function()
		local sync=0 local previous=os.clock()
		while true do
			task.wait(.04) local now=os.clock() local dt=math.min(now-previous,.25) previous=now sync+=dt
			local playerRoots={}
			for p in pairs(G.Runtime) do
				local pr=root(p)
				if pr then table.insert(playerRoots,pr.Position) end
			end
			for i=#G.Enemies,1,-1 do
				local e=G.Enemies[i]
				if not e.Alive or not e.Model.Parent then
					table.remove(G.Enemies,i)
				else
					local isNear=false
					local bpos=e.Body and e.Body.Position or e.Home
					for _,ppos in ipairs(playerRoots) do
						if (bpos-ppos).Magnitude&lt;=220 then
							isNear=true
							break
						end
					end
					if isNear or e==G.Boss or e.Returning or e.State=="Chase" or e.State=="Attack" then
						local eDt=now-(e.LastTickAt or (now-dt))
						e.LastTickAt=now
						G.TickEnemy(e,math.min(eDt,.25))
					elseif now&gt;=(e.NextFarTick or 0) then
						local eDt=now-(e.LastTickAt or (now-.4))
						e.LastTickAt=now
						e.NextFarTick=now+.4
						G.TickEnemy(e,math.min(eDt,.5))
					end
				end
			end
			G.TickCompanions(dt)
			for p,rt in pairs(G.Runtime) do
				local r,h=root(p) local profile=D.Get(p)
				if r and profile then
					ensureProfileFields(profile)
					if now&gt;=(rt.NextInstinctRegen or 0) then
						rt.NextInstinctRegen=now+5
						if profile.Haki then
							profile.Haki.InstinctDodges=math.min(8,(profile.Haki.InstinctDodges or 8)+1)
						end
					end
					if now&gt;=(rt.JumpPadUntil or 0) then
						local elapsed=now-rt.MoveAt local delta=r.Position-rt.Safe
						local horizontal=Vector3.new(delta.X,0,delta.Z).Magnitude
						if not finiteVector(r.Position) or horizontal&gt;math.max(48,elapsed*140) then G.Teleport(p,rt.Safe)
						else rt.Safe=r.Position rt.MoveAt=now end
						if now&gt;=(rt.NextVoidCheck or 0) then
							rt.NextVoidCheck=now+.2
							local gy=safeGroundY(r.Position,r.Position.Y-3.5)
							if math.abs(r.Position.Y-gy)&lt;=10 and r.Position.Y&gt;-10 then
								rt.LastGroundedPos=Vector3.new(r.Position.X,gy+3.5,r.Position.Z)
							elseif r.Position.Y&lt;-15 or (rt.LastGroundedPos and r.Position.Y&lt;(rt.LastGroundedPos.Y-65)) then
								local cpNode=C.FastTravel[profile.Checkpoint] or C.FastTravel.GoldenSky
								local rescue=rt.LastGroundedPos or (cpNode and cpNode.Pos) or C.Spawn
								G.Teleport(p,rescue)
								G.Notify(p,"Void Rescue: Đã đưa bạn trở lại mặt sàn đảo mây an toàn!")
							end
						end
					else
						rt.Safe=r.Position rt.MoveAt=now
					end
					if now&gt;=(rt.JumpPadCooldown or 0) then
						for _,pad in ipairs(G.JumpPads) do
							if distance(r.Position,pad.Start)&lt;=5.5 then
								rt.JumpPadCooldown=now+2.5
								G.LaunchPlayer(p,r.Position,pad.Target,pad.Arc,pad.Duration)
								break
							end
						end
					end
					if now&gt;=(rt.ShrineTouchCooldown or 0) then
						for _,sh in pairs(G.Shrines) do
							if distance(r.Position,sh.Pos)&lt;=8 then
								rt.ShrineTouchCooldown=now+12
								G.ActivateShrine(p,sh)
								break
							end
						end
					end
					if now&gt;=(rt.PortalTouchCooldown or 0) and G.WorldPortals then
						for _,gate in pairs(G.WorldPortals) do
							if distance(r.Position,gate.CenterPos)&lt;=4.6 then
								G.EnterWorldPortal(p,gate)
								break
							end
						end
					end
					rt.Stamina=math.min(100,rt.Stamina+17*dt)
					if now-rt.LastHurt&gt;7 then h.Health=math.min(h.MaxHealth,h.Health+3*dt) end
				end
				if sync&gt;=.3 then G.Sync(p) end
			end
			if sync&gt;=.3 then sync=0 end
		end
	end)
	print("[SKYBREAK] Grand Sky Seas v11 initialized. Studio persistence:",C.StudioPersistence)
end
return G
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX9">
        <Properties>
          <string name="Name">PlayerDataService</string>
          <ProtectedString name="Source">local Players = game:GetService("Players")
local DSS = game:GetService("DataStoreService")
local Http = game:GetService("HttpService")
local Run = game:GetService("RunService")
local C = require(game.ReplicatedStorage.Shared.Config)
local D = {Sessions={}}
local persistent = not Run:IsStudio() or C.StudioPersistence
local okStore, store = pcall(function()
    return persistent and DSS:GetDataStore(C.StoreName) or nil
end)
if not okStore or not store then
    persistent = false
    store = nil
end
local token = game.JobId .. ":" .. Http:GenerateGUID(false)

local function clone(t)
    if type(t) ~= "table" then return t end
    local copy = {}
    for k, v in pairs(t) do
        copy[k] = clone(v)
    end
    return copy
end

local function defaultSkillLevels()
    local levels = {}
    for skillId in pairs(C.SkillNames) do
        levels[skillId] = 1
    end
    return levels
end

local function defaults()
    return {
        SchemaVersion = 1,
        Level = 1,
        XP = 0,
        Gold = 300,
        CoreShards = 50,
        SkillPoints = 1,
        StatPoints = 0,
        StatAlloc = {
            Melee = 1,
            Defense = 1,
            Sword = 1,
            Gun = 1,
            Fruit = 1,
        },
        Potions = 4,
        DailyClaimed = 0,
        PartySize = "Solo",
        WeaponEnhance = 0,
        ClassId = "SkyGuardian",
        Gender = "Male",
        ActiveSlot = 3, -- 1=FightingStyle, 2=AetherFruit, 3=Sword, 4=Gun
        FightingStyle = "SkybornCombat",
        UnlockedStyles = {
            SkybornCombat = true,
            SkyStep = true,
        },
        EquippedFruit = "GaleCore",
        StoredFruits = {
            GaleCore = 1,
            SolarFlameCore = 1,
        },
        AwakenedFruits = {},
        EquippedGun = "aether_flintlock",
        Mastery = {
            SkybornCombat = 1,
            GaleCore = 1,
            starter_sword = 1,
            starter_daggers = 1,
            starter_staff = 1,
            aether_flintlock = 1,
        },
        Haki = {
            Aura = false,
            AuraStage = 1,
            Instinct = false,
            InstinctDodges = 4,
            MaxDodges = 4,
            ConquerorUnlocked = false,
        },
        Race = "Skyborn",
        RaceTier = 1,
        RaceV4Active = false,
        AwakeningMeter = 0,
        Faction = "Pirate",
        Bounty = 0,
        Honor = 0,
        Title = "Skyborn Novice",
        UnlockedTitles = {
            ["Skyborn Novice"] = true,
        },
        ActiveShip = "SkySloop",
        UnlockedShips = {
            SkySloop = true,
        },
        Transformed = false,
        TransformId = nil,
        HomeIsland = "SkyHub",
        Loadouts = {
            SkyGuardian = "starter_sword",
            ThunderStriker = "starter_daggers",
            ArcaneMage = "starter_staff",
        },
        SkillLevels = defaultSkillLevels(),
        Equipped = {
            Weapon = "starter_sword",
        },
        QuestIndex = 1,
        Accepted = true,
        Progress = {},
        CompletedQuests = {},
        Inventory = {
            starter_sword = 1,
            starter_daggers = 1,
            starter_staff = 1,
            aether_flintlock = 1,
            SkyIron = 3,
            SunshardCore = 1,
            upgrade_material = 2,
        },
        Weapon = "starter_sword",
        FirstClearBosses = {},
        UnlockedWorlds = {
            SkyHub = true,
            GoldenSky = true,
            FrozenCyber = false,
            ShadowRealm = false,
            VerdantCrown = false,
            EmberforgeWastes = false,
            AbyssalTides = false,
            ChronosBastion = false,
            VeilsEnd = false,
        },
    }
end

D.Default = defaults

local function hydrate(p)
    if type(p) ~= "table" then return defaults() end
    local def = defaults()
    for k, v in pairs(def) do
        if p[k] == nil then
            p[k] = clone(v)
        end
    end
    p.Level = type(p.Level) == "number" and math.clamp(math.floor(p.Level), 1, C.MaxLevel) or def.Level
    p.XP = type(p.XP) == "number" and math.max(0, math.floor(p.XP)) or def.XP
    p.Gold = type(p.Gold) == "number" and math.max(0, math.floor(p.Gold)) or def.Gold
    p.QuestIndex = type(p.QuestIndex) == "number" and math.clamp(math.floor(p.QuestIndex), 1, #C.Quests) or def.QuestIndex
    p.Accepted = (p.Accepted ~= false)
    p.Gender = (p.Gender == "Female") and "Female" or "Male"
    p.PartySize = p.PartySize or "Solo"
    p.ActiveSlot = (type(p.ActiveSlot) == "number" and p.ActiveSlot &gt;= 1 and p.ActiveSlot &lt;= 4) and math.floor(p.ActiveSlot) or 3
    p.StatPoints = type(p.StatPoints) == "number" and math.max(0, math.floor(p.StatPoints)) or def.StatPoints

    p.StatAlloc = type(p.StatAlloc) == "table" and p.StatAlloc or clone(def.StatAlloc)
    for statKey, defVal in pairs(def.StatAlloc) do
        if type(p.StatAlloc[statKey]) ~= "number" or p.StatAlloc[statKey] &lt; 0 then
            p.StatAlloc[statKey] = defVal
        end
    end

    p.FightingStyle = (type(p.FightingStyle) == "string" and C.FightingStyles and C.FightingStyles[p.FightingStyle]) and p.FightingStyle or def.FightingStyle
    p.UnlockedStyles = type(p.UnlockedStyles) == "table" and p.UnlockedStyles or clone(def.UnlockedStyles)
    for styleId, unlocked in pairs(def.UnlockedStyles) do
        if p.UnlockedStyles[styleId] == nil then
            p.UnlockedStyles[styleId] = unlocked
        end
    end

    p.EquippedFruit = (type(p.EquippedFruit) == "string" and C.AetherFruits and C.AetherFruits[p.EquippedFruit]) and p.EquippedFruit or def.EquippedFruit
    p.StoredFruits = type(p.StoredFruits) == "table" and p.StoredFruits or clone(def.StoredFruits)
    for fruitId, count in pairs(def.StoredFruits) do
        if p.StoredFruits[fruitId] == nil then
            p.StoredFruits[fruitId] = count
        end
    end

    p.AwakenedFruits = type(p.AwakenedFruits) == "table" and p.AwakenedFruits or clone(def.AwakenedFruits)
    for fruitId, isAwakened in pairs(def.AwakenedFruits) do
        if p.AwakenedFruits[fruitId] == nil then
            p.AwakenedFruits[fruitId] = isAwakened
        end
    end

    p.EquippedGun = (type(p.EquippedGun) == "string" and C.Items[p.EquippedGun]) and p.EquippedGun or def.EquippedGun
    p.Mastery = type(p.Mastery) == "table" and p.Mastery or clone(def.Mastery)
    for key, val in pairs(def.Mastery) do
        if type(p.Mastery[key]) ~= "number" or p.Mastery[key] &lt; 1 then
            p.Mastery[key] = val
        end
    end

    p.Haki = type(p.Haki) == "table" and p.Haki or clone(def.Haki)
    for k, v in pairs(def.Haki) do
        if p.Haki[k] == nil then
            p.Haki[k] = v
        end
    end

    p.Race = (type(p.Race) == "string" and C.Races and C.Races[p.Race]) and p.Race or def.Race
    p.RaceTier = (type(p.RaceTier) == "number" and p.RaceTier &gt;= 1 and p.RaceTier &lt;= 4) and math.floor(p.RaceTier) or def.RaceTier
    p.RaceV4Active = p.RaceV4Active == true
    p.AwakeningMeter = type(p.AwakeningMeter) == "number" and math.clamp(p.AwakeningMeter, 0, 100) or 0
    p.Faction = (p.Faction == "Marine") and "Marine" or "Pirate"
    p.Bounty = type(p.Bounty) == "number" and math.max(0, math.floor(p.Bounty)) or def.Bounty
    p.Honor = type(p.Honor) == "number" and math.max(0, math.floor(p.Honor)) or def.Honor
    p.Title = type(p.Title) == "string" and p.Title or def.Title
    p.UnlockedTitles = type(p.UnlockedTitles) == "table" and p.UnlockedTitles or clone(def.UnlockedTitles)
    p.ActiveShip = (type(p.ActiveShip) == "string" and C.SkyShips and C.SkyShips[p.ActiveShip]) and p.ActiveShip or def.ActiveShip
    p.UnlockedShips = type(p.UnlockedShips) == "table" and p.UnlockedShips or clone(def.UnlockedShips)
    p.Transformed = p.Transformed == true

    p.Loadouts = type(p.Loadouts) == "table" and p.Loadouts or clone(def.Loadouts)
    for classId, weaponId in pairs(def.Loadouts) do
        if not p.Loadouts[classId] then
            p.Loadouts[classId] = weaponId
        end
    end
    p.SkillLevels = type(p.SkillLevels) == "table" and p.SkillLevels or {}
    for skillId in pairs(C.SkillNames) do
        if type(p.SkillLevels[skillId]) ~= "number" or p.SkillLevels[skillId] &lt; 1 then
            p.SkillLevels[skillId] = 1
        end
    end
    p.Inventory = type(p.Inventory) == "table" and p.Inventory or {}
    for itemId, count in pairs(def.Inventory) do
        if p.Inventory[itemId] == nil then
            p.Inventory[itemId] = count
        end
    end
    p.Equipped = type(p.Equipped) == "table" and p.Equipped or clone(def.Equipped)
    if p.Weapon and p.Equipped.Weapon == nil then
        p.Equipped.Weapon = p.Weapon
    elseif p.Equipped.Weapon and p.Weapon == nil then
        p.Weapon = p.Equipped.Weapon
    end
    p.UnlockedWorlds = type(p.UnlockedWorlds) == "table" and p.UnlockedWorlds or clone(def.UnlockedWorlds)
    p.UnlockedWorlds.SkyHub = true
    p.UnlockedWorlds.GoldenSky = true
    return p
end

local function valid(p)
    if type(p) ~= "table" or p.SchemaVersion ~= 1 then return false end
    for _, key in ipairs({"Level", "XP", "Gold", "QuestIndex"}) do
        local v = p[key]
        if type(v) ~= "number" or v ~= v or v % 1 ~= 0 or v &lt; 0 or v &gt; 1e12 then return false end
    end
    if p.Level &lt; 1 or p.Level &gt; C.MaxLevel or p.QuestIndex &lt; 1 or p.QuestIndex &gt; (#C.Quests + 2) then return false end
    for _, key in ipairs({"Progress", "CompletedQuests", "Inventory", "FirstClearBosses", "UnlockedWorlds"}) do
        if type(p[key]) ~= "table" then return false end
    end
    if not C.Classes[p.ClassId] or type(p.Accepted) ~= "boolean" then return false end
    if p.Gender ~= nil and p.Gender ~= "Male" and p.Gender ~= "Female" then return false end
    if p.Loadouts ~= nil and type(p.Loadouts) ~= "table" then return false end
    if p.Equipped ~= nil and type(p.Equipped) ~= "table" then return false end
    if p.SkillLevels ~= nil and type(p.SkillLevels) ~= "table" then return false end
    if p.StatAlloc ~= nil and type(p.StatAlloc) ~= "table" then return false end
    if p.StoredFruits ~= nil and type(p.StoredFruits) ~= "table" then return false end
    if p.AwakenedFruits ~= nil and type(p.AwakenedFruits) ~= "table" then return false end
    if p.Mastery ~= nil and type(p.Mastery) ~= "table" then return false end
    if p.Haki ~= nil and type(p.Haki) ~= "table" then return false end
    for k, v in pairs(p.Inventory) do
        if type(k) ~= "string" or type(v) ~= "number" or v ~= v or v &lt; 0 or v &gt; 1e8 then return false end
    end
    for k, v in pairs(p.Progress) do
        if type(k) ~= "string" or type(v) ~= "number" or v ~= v or v &lt; 0 then return false end
    end
    return p.Weapon == nil or C.Items[p.Weapon] ~= nil
end

local function retry(fn)
    for n = 1, 3 do
        local ok, result = pcall(fn)
        if ok then return true, result end
        warn("[SKYBREAK] DataStore attempt", n, result)
        if n &lt; 3 then task.wait(2 ^ (n - 1) + math.random()) end
    end
    return false, nil
end

function D.Load(player)
    local profile = defaults()
    local expires = os.time() + C.LeaseSeconds
    local loadedFromStore = false
    if persistent and store then
        local ok, record = retry(function()
            return store:UpdateAsync("u_" .. player.UserId, function(old)
                local rawData = (type(old) == "table" and type(old.Data) == "table") and old.Data or defaults()
                local migrated = hydrate(rawData)
                return {Data = migrated, Owner = token, Expires = os.time() + C.LeaseSeconds}
            end)
        end)
        if ok and type(record) == "table" and type(record.Data) == "table" then
            profile = record.Data
            expires = record.Expires or expires
            loadedFromStore = true
        else
            warn("[SKYBREAK] Falling back to in-memory profile for", player.Name)
        end
    end
    profile = hydrate(profile)
    D.Sessions[player] = {
        Profile = profile,
        Expires = expires,
        Busy = false,
        Active = true,
        SaveStatus = loadedFromStore and "Đã tải" or (persistent and "Tạm lưu bộ nhớ" or "Studio: KHÔNG LƯU"),
    }
    if player.Parent ~= Players then
        D.Release(player)
        return
    end
    return profile
end

function D.Get(player)
    local s = D.Sessions[player]
    if not s or not s.Active then return nil end
    if persistent and os.time() &gt;= s.Expires then
        s.Expires = os.time() + C.LeaseSeconds
    end
    return s.Profile
end

function D.Save(player, release)
    local s = D.Sessions[player]
    if not s then return false end
    while s.Busy do task.wait(0.1) end
    if not s.Active then return false end
    s.Busy = true
    if not persistent then
        s.Busy = false
        return true
    end
    local snapshot = clone(s.Profile)
    local ok, record = retry(function()
        return store:UpdateAsync("u_" .. player.UserId, function()
            return {
                Data = snapshot,
                Owner = not release and token or nil,
                Expires = not release and (os.time() + C.LeaseSeconds) or 0,
            }
        end)
    end)
    local saved = ok and record and record.Data and (release or record.Owner == token)
    if saved then
        s.Expires = record.Expires or (os.time() + C.LeaseSeconds)
        s.SaveStatus = "Đã lưu"
    else
        s.SaveStatus = "Tạm lưu bộ nhớ"
    end
    s.Busy = false
    return saved == true
end

function D.Release(player)
    local s = D.Sessions[player]
    if not s then return end
    D.Save(player, true)
    s.Active = false
    D.Sessions[player] = nil
end

function D.Start()
    task.spawn(function()
        while true do
            task.wait(C.AutosaveSeconds)
            for player in pairs(D.Sessions) do
                task.spawn(D.Save, player, false)
            end
        end
    end)
    game:BindToClose(function()
        local count = 0
        for player in pairs(D.Sessions) do
            count += 1
            task.spawn(function()
                D.Release(player)
                count -= 1
            end)
        end
        local deadline = os.clock() + 25
        while count &gt; 0 and os.clock() &lt; deadline do
            task.wait(0.1)
        end
    end)
end

return D
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX10">
        <Properties>
          <string name="Name">WorldService</string>
          <ProtectedString name="Source">local W={Interactions={}}
local gold=Color3.fromRGB(238,187,73)
local stone=Color3.fromRGB(224,222,204)
function W.Part(parent,name,size,pos,color,material)
    local p=Instance.new("Part") p.Name=name p.Size=size p.Position=pos p.Anchored=true
    p.Color=color or stone p.Material=material or Enum.Material.SmoothPlastic p.TopSurface=Enum.SurfaceType.Smooth p.BottomSurface=Enum.SurfaceType.Smooth p.Parent=parent
    return p
end
function W.Label(part,text)
    local gui=Instance.new("BillboardGui") gui.Size=UDim2.fromOffset(220,48) gui.StudsOffset=Vector3.new(0,4,0) gui.AlwaysOnTop=false gui.MaxDistance=90 gui.Parent=part
    local label=Instance.new("TextLabel") label.Size=UDim2.fromScale(1,1) label.BackgroundTransparency=.3 label.BackgroundColor3=Color3.fromRGB(18,26,39) label.TextColor3=Color3.new(1,.9,.65) label.TextScaled=true label.Font=Enum.Font.GothamBold label.Text=text label.Parent=gui
    return label
end
function W.Ring(parent,name,center,radius,color,segments)
    for i=1,segments or 24 do
        local count=segments or 24 local a=(i-1)*math.pi*2/count local b=i*math.pi*2/count
        local from=center+Vector3.new(math.cos(a)*radius,0,math.sin(a)*radius)
        local to=center+Vector3.new(math.cos(b)*radius,0,math.sin(b)*radius)
        local p=W.Part(parent,name,Vector3.new(.35,.35,(to-from).Magnitude), (from+to)/2,color,Enum.Material.Neon)
        p.CFrame=CFrame.lookAt((from+to)/2,to) p.CanCollide=false p.CanQuery=false
    end
end
function W.Decorate()
    local hub=W.Hub local sky=W.Sky
    local blue=Color3.fromRGB(29,53,92)
    for _,z in ipairs({0,-110,-205,-290,-355,-440}) do
        for _,x in ipairs({-46,46}) do
            local falling=W.Part(sky,"Waterfall",Vector3.new(7,58,1),Vector3.new(x,-24,z),Color3.fromRGB(152,223,246),Enum.Material.Glass)
            falling.Transparency=.45 falling.CanCollide=false falling.CanQuery=false
        end
    end
    for i=1,12 do
        local x=(i%2==0 and 1 or -1)*(88+(i%3)*18) local z=-i*34
        local rock=Instance.new("WedgePart") rock.Name="DistantFloatingRock" rock.Size=Vector3.new(18,30,20) rock.Position=Vector3.new(x,-12+(i%3)*9,z) rock.Anchored=true rock.Color=Color3.fromRGB(107,115,128) rock.Material=Enum.Material.Slate rock.Parent=sky
        W.Part(sky,"SatelliteGarden",Vector3.new(22,3,24),rock.Position+Vector3.new(0,16,0),Color3.fromRGB(100,151,113),Enum.Material.Grass)
    end
    for _,z in ipairs({-32,-138,-230,-316}) do
        for _,x in ipairs({-18,18}) do
            W.Part(sky,"IvoryColumn",Vector3.new(3,13,3),Vector3.new(x,10,z),stone)
            W.Part(sky,"GoldenCapital",Vector3.new(5,1,5),Vector3.new(x,17,z),gold)
            local flag=W.Part(sky,"SkybornBanner",Vector3.new(3,7,.25),Vector3.new(x,12,z-2),blue) flag.CanCollide=false
            local crest=W.Part(sky,"BannerCrest",Vector3.new(.3,3,.3),Vector3.new(x,12,z-2.2),gold,Enum.Material.Neon) crest.CanCollide=false
        end
    end
    W.Ring(hub,"HubSigil",Vector3.new(0,3.8,-13),10,gold,24)
    local crystal=W.Part(hub,"SkyCoreCrystal",Vector3.new(2.8,6,2.8),Vector3.new(0,9,-13),Color3.fromRGB(104,219,255),Enum.Material.Neon)
    crystal.CFrame*=CFrame.Angles(0,math.pi/4,math.pi/5) crystal.CanCollide=false
    for _,y in ipairs({31,47,59}) do W.Ring(sky,"TowerHalo",Vector3.new(0,y,-440),y==47 and 34 or 26,gold,32) end
    W.Ring(sky,"ArenaSigil",Vector3.new(0,3.8,-440),38,gold,48)
    for _,x in ipairs({-44,44}) do
        for _,z in ipairs({-405,-470}) do
            W.Part(sky,"TowerSpire",Vector3.new(3,16,3),Vector3.new(x,45,z),gold,Enum.Material.Metal)
        end
    end
    if not game.Lighting:FindFirstChildOfClass("Atmosphere") then
        local atmosphere=Instance.new("Atmosphere") atmosphere.Density=.22 atmosphere.Offset=.1 atmosphere.Color=Color3.fromRGB(215,228,244) atmosphere.Decay=Color3.fromRGB(240,211,163) atmosphere.Parent=game.Lighting
    end
end
function W.Interactable(parent,id,pos,text)
    local p=W.Part(parent,id,Vector3.new(3,5,3),pos,gold,Enum.Material.Neon)
    p.CanCollide=false
    p:SetAttribute("InteractableId",id)
    local prompt=Instance.new("ProximityPrompt")
    prompt.ActionText="Nói chuyện / Tương tác"
    prompt.ObjectText=text
    prompt.MaxActivationDistance=18
    prompt.HoldDuration=0
    prompt.RequiresLineOfSight=false
    prompt.Style=Enum.ProximityPromptStyle.Default
    prompt.Parent=p
    W.Label(p,text) W.Interactions[id]=p return p
end
function W.Build()
    if game.ReplicatedStorage:FindFirstChild('DelegatedV5Sources') then return require(script.Parent.DelegatedWorldService).Build(W) end
    local existingHub=workspace:FindFirstChild("SkyHub") local existingSky=workspace:FindFirstChild("GoldenSky")
    if existingHub and existingSky and existingHub:GetAttribute("WorldVersion")==2 then
        W.Hub=existingHub W.Sky=existingSky W.Spawn=existingHub:FindFirstChild("SkybornSpawn")
        for _,root in ipairs({existingHub,existingSky}) do for _,o in ipairs(root:GetDescendants()) do
            local id=o:GetAttribute("InteractableId") if id and o:IsA("BasePart") then W.Interactions[id]=o end
        end end
        require(script.Parent.VisualWorldService).UpgradeBaked(existingHub,existingSky)
        return
    end
    local lighting=game:GetService("Lighting") lighting.ClockTime=15 lighting.Brightness=2.5 lighting.Ambient=Color3.fromRGB(135,145,163)
    local hub=workspace:FindFirstChild("SkyHub") or Instance.new("Model",workspace) hub.Name="SkyHub"
    local sky=workspace:FindFirstChild("GoldenSky") or Instance.new("Model",workspace) sky.Name="GoldenSky"
    W.Hub=hub W.Sky=sky
    for _,name in ipairs({"ActiveEnemies","ActiveBosses","SpawnPoints"}) do
        if not workspace:FindFirstChild(name) then local f=Instance.new("Folder",workspace) f.Name=name end
    end
    local function island(parent,name,z,sx,sz)
        W.Part(parent,name,Vector3.new(sx,6,sz),Vector3.new(0,0,z),stone)
        W.Part(parent,name.."Grass",Vector3.new(sx-3,.6,sz-3),Vector3.new(0,3.2,z),Color3.fromRGB(98,151,113),Enum.Material.Grass)
        W.Part(parent,name.."Rock",Vector3.new(sx*.72,17,sz*.7),Vector3.new(0,-10,z),Color3.fromRGB(91,105,115),Enum.Material.Slate)
        for _,x in ipairs({-sx/2,sx/2}) do W.Part(parent,"SafetyRail",Vector3.new(1,3,sz),Vector3.new(x,5,z),gold) end
    end
    island(hub,"SkyHubSpawn",0,100,90)
    island(sky,"TrainingGround",-110,100,100)
    island(sky,"BrokenBridgeQuestArea",-205,110,75)
    island(sky,"GoldenKnightArena",-290,110,80)
    island(sky,"LightTowerEntrance",-355,100,45)
    island(sky,"AureonBossArena",-440,115,110)
    local function bridge(z,length)
        W.Part(sky,"Bridge",Vector3.new(16,2,length),Vector3.new(0,3,z),gold)
        for _,x in ipairs({-8,8}) do W.Part(sky,"BridgeRail",Vector3.new(1,3,length),Vector3.new(x,5,z),stone) end
    end
    bridge(-53,22) bridge(-164,15) bridge(-247,17) bridge(-330,13) bridge(-382,14)
    local spawn=Instance.new("SpawnLocation") spawn.Name="SkybornSpawn" spawn.Size=Vector3.new(10,1,10) spawn.Position=Vector3.new(0,4,15) spawn.Anchored=true spawn.Neutral=true spawn.Duration=2 spawn.Color=gold spawn.Parent=hub W.Spawn=spawn
    W.Interactable(hub,"Lyra",Vector3.new(-14,6,-10),"Lyra • Nhiệm vụ")
    W.Interactable(hub,"Kael",Vector3.new(20,6,0),"Kael • Thợ rèn (sắp có)")
    W.Interactable(hub,"FrozenPortal",Vector3.new(32,7,-28),"Frozen Cyber • Chương sau")
    W.Interactable(sky,"ReturnHub",Vector3.new(37,6,-350),"Về Sky Hub")
    for i=1,3 do W.Interactable(sky,"Station"..i,Vector3.new(-36+(i-1)*36,6,-205),"Trạm năng lượng "..i) end
    for i=1,3 do W.Interactable(sky,"Citizen"..i,Vector3.new(-36+(i-1)*36,6,-280),"Người dân "..i) end
    for i=1,2 do W.Interactable(sky,"Switch"..i,Vector3.new(i==1 and -26 or 26,6,-350),"Công tắc tháp "..i) end
    W.Interactable(sky,"ArenaGate",Vector3.new(0,6,-377),"Aureon • Vào / bắt đầu trận")
    W.Interactable(sky,"LeaveArena",Vector3.new(43,6,-399),"Rời đấu trường")
    for _,x in ipairs({-44,44}) do
        for _,z in ipairs({-405,-470}) do
            W.Part(sky,"TowerPillar",Vector3.new(7,32,7),Vector3.new(x,19,z),stone)
            W.Part(sky,"TowerCrown",Vector3.new(10,3,10),Vector3.new(x,36,z),gold,Enum.Material.Neon)
        end
    end
    W.Label(W.Part(sky,"RouteSign",Vector3.new(1,1,1),Vector3.new(0,9,-80),gold),"GOLDEN SKY • Sân tập")
    W.Label(W.Part(sky,"TowerSign",Vector3.new(1,1,1),Vector3.new(0,12,-345),gold),"THÁP ÁNH SÁNG")
    for i=1,14 do
        local z=-25-(i-1)*24 local x=(i%2==0 and 1 or -1)*43
        W.Part(sky,"TreeTrunk",Vector3.new(2,7,2),Vector3.new(x,7,z),Color3.fromRGB(107,81,58))
        local crown=W.Part(sky,"TreeCrown",Vector3.new(10,10,10),Vector3.new(x,13,z),Color3.fromRGB(68,126,92)) crown.Shape=Enum.PartType.Ball crown.CanCollide=false
    end
    W.Decorate()
    require(script.Parent.VisualWorldService).Build(hub,sky)
end
return W
</ProtectedString>
        </Properties>
      </Item>
    <Item class="ModuleScript" referent="RBX90AD8E099A6D4CEC81ACFC88E4EA78F4"><Properties><string name="Name">DelegatedWorldService</string><ProtectedString name="Source">local M={}

function M.Build(W)
    for _,name in {'SkyHub','GoldenSky','GrandSkyIslands_Collision','VerdantCrown','EmberforgeWastes','AbyssalTides','ChronosBastion','VeilsEnd'} do
        local old=workspace:FindFirstChild(name)
        if old then old:Destroy() end
    end
    local hub=Instance.new('Model');hub.Name='SkyHub';hub.Parent=workspace
    local sky=Instance.new('Model');sky.Name='GoldenSky';sky.Parent=workspace;hub:SetAttribute('WorldVersion',5)
    W.Hub=hub;W.Sky=sky;W.Interactions={}
    require(script.Parent.GoldenSkyCollision)(sky)
    for _,name in {'ActiveEnemies','ActiveBosses','SpawnPoints'} do
        if not workspace:FindFirstChild(name) then
            local f=Instance.new('Folder');f.Name=name;f.Parent=workspace
        end
    end
    local spawn=Instance.new('SpawnLocation');spawn.Name='SkybornSpawn';spawn.Size=Vector3.new(8,1,8);spawn.Position=Vector3.new(-92,36.6,153)
    spawn.Anchored=true;spawn.Transparency=1;spawn.CanCollide=false;spawn.Neutral=true;spawn.Duration=2;spawn.Parent=hub;W.Spawn=spawn
    local locations={
        Lyra={-78,39,145},Kael={-68,39,145},FrozenPortal={16,49,-199},ReturnHub={19,43,20},
        Station1={-18,43,17},Station2={0,43,23},Station3={18,43,17},
        Citizen1={-22,43,-4},Citizen2={0,43,-26},Citizen3={22,43,-4},
        Switch1={-24,43,-25},Switch2={24,43,-25},ArenaGate={0,43,-42},LeaveArena={29,49,-90},
    }
    local labels={
        Lyra='Lyra • Chỉ Huy Skyborn (Nhiệm Vụ)',
        Kael='Kael • Thợ Rèn Thần Khí (Forge)',
        FrozenPortal='Frozen Cyber • Sea 2',
        ReturnHub='Về Sky Hub',
        ArenaGate='Aureon • Vào / bắt đầu trận',
        LeaveArena='Rời đấu trường'
    }
    for id,pos in locations do
        local marker=W.Interactable((id=='Lyra' or id=='Kael') and hub or sky,id,Vector3.new(table.unpack(pos)),labels[id]or id)
        marker.Transparency=1
        if id=='Lyra' or id=='Kael' then
            for _,ch in ipairs(marker:GetChildren()) do
                if ch:IsA("BillboardGui") or ch:IsA("ProximityPrompt") then
                    ch:Destroy()
                end
            end
        end
    end
    local floors={sky.GoldenSky_Collision}

    local solid3D = nil
    if script.Parent:FindFirstChild('Solid3DWorldColliders') then
        local ok, mod = pcall(require, script.Parent.Solid3DWorldColliders)
        if ok and mod then
            solid3D = mod
            pcall(mod.Build)
        end
    end

    local islandColFolder = workspace:FindFirstChild("GrandSkyIslands_Collision")
    if not islandColFolder then
        islandColFolder = Instance.new("Folder")
        islandColFolder.Name = "GrandSkyIslands_Collision"
        islandColFolder.Parent = workspace
    end
    table.insert(floors, islandColFolder)

    if game.ReplicatedStorage.DelegatedV5Sources:FindFirstChild('FrozenCyber') then
        local origin=require(game.ReplicatedStorage.Shared.RealmConfig).FrozenCyber.Origin
        local oldF=workspace:FindFirstChild('FrozenCyber')
        if oldF then oldF:Destroy() end
        local frozen=Instance.new('Model');frozen.Name='FrozenCyber';frozen.Parent=workspace
        local collision=require(script.Parent.FrozenCyberCollision)(frozen)
        collision=collision or frozen.FrozenCyber_Collision
        for _,o in collision:GetDescendants() do if o:IsA('BasePart')then o.CFrame=CFrame.new(origin)*o.CFrame end end
        table.insert(floors,collision)
        local frHub=W.Interactable(frozen,'FrozenReturnHub',origin+Vector3.new(-101,43,150),'Về Golden Sky')
        if frHub then frHub.Transparency=1 end
        local shPortal=W.Interactable(frozen,'ShadowPortal',origin+Vector3.new(120,68,-130),'Shadow Realm • Sea 3')
        if shPortal then shPortal.Transparency=1 end
    end
    if game.ReplicatedStorage.DelegatedV5Sources:FindFirstChild('ShadowRealm')then
        local origin=require(game.ReplicatedStorage.Shared.RealmConfig).ShadowRealm.Origin
        local oldS=workspace:FindFirstChild('ShadowRealm')
        if oldS then oldS:Destroy() end
        local shadow=Instance.new('Model');shadow.Name='ShadowRealm';shadow.Parent=workspace
        require(script.Parent.ShadowRealmCollision)(shadow)
        local collision=shadow.ShadowRealm_Collision
        for _,o in collision:GetDescendants()do if o:IsA('BasePart')then o.CFrame=CFrame.new(origin)*o.CFrame end end
        table.insert(floors,collision)
        local shRet=W.Interactable(shadow,'ShadowReturnHub',origin+Vector3.new(-158,51,90),'Về Golden Sky')
        if shRet then shRet.Transparency=1 end
    end
    local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Include;params.FilterDescendantsInstances=floors
    function W.RaycastGround(pos, refFloorY)
        local originY = (refFloorY or pos.Y) + 32
        return workspace:Raycast(Vector3.new(pos.X, originY, pos.Z),Vector3.new(0,-85,0),params)
    end
    function W.GroundY(pos, refFloorY)
        local hit = W.RaycastGround(pos, refFloorY)
        if hit then
            return hit.Position.Y
        end
        return refFloorY or (pos.Y - 2.5)
    end
    if solid3D and solid3D.SnapToOpenGround then
        W.SnapToOpenGround = solid3D.SnapToOpenGround
    else
        function W.SnapToOpenGround(pos, refFloorY, heightOffset)
            local gy = W.GroundY(pos, refFloorY)
            return Vector3.new(pos.X, gy + (heightOffset or 0), pos.Z), gy
        end
    end
    workspace:SetAttribute('WorldArtVersion',8)
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXD39B73BB9DF348BF9DF7AA0B4D0C69C9"><Properties><string name="Name">CosmeticService</string><ProtectedString name="Source">-- V8 Rigged EditableMesh Cosmetic Service (Zero legacy white MeshPart prefabs)
local A={}
function A.Boss(model,body)
    for _,o in ipairs(model:GetDescendants()) do
        if o:IsA("BasePart") then
            o.Anchored=true o.CanCollide=(o==body) o.CanTouch=false o.CanQuery=(o==body) o.Transparency=1
        end
    end
    if body then body.CanCollide=true body.CanQuery=true end
end
function A.Enemy(model,body,id)
    for _,o in ipairs(model:GetDescendants()) do
        if o:IsA("BasePart") then
            o.Anchored=true o.CanCollide=(o==body) o.CanTouch=false o.CanQuery=(o==body) o.Transparency=1
        end
    end
    if body then body.CanCollide=true body.CanQuery=true end
end
function A.Weapon(ch,hand,equipped)
    local blade=ch and ch:FindFirstChild("SkybornBlade")
    if blade then blade.Transparency=1 end
    A.Equip(ch,equipped)
end
function A.Guardian(ch)
    local root=ch and ch:FindFirstChild("HumanoidRootPart")
    local humanoid=ch and ch:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then return false end
    for _,o in ipairs(ch:GetDescendants()) do
        if o:IsA("BasePart") and o.Name~="HumanoidRootPart" and not o:FindFirstAncestor("SkyGuardianVisual") and not o:FindFirstAncestor("ThunderStrikerVisual") and not o:FindFirstAncestor("ArcaneMageVisual") then
            o.Transparency=1
        end
        if o:IsA("Decal") then
            o.Transparency=1
        end
    end
    ch:SetAttribute("BlenderGuardian",true)
    ch:SetAttribute("SkybreakCosmeticsReady",true)
    return true
end
function A.Equip(ch,equipped)
    if not ch then return end
    local body=ch:FindFirstChild("SkyGuardianVisual")
    if body then
        for _,o in ipairs(body:GetDescendants()) do
            if o:IsA("MeshPart") and o.Name:find("_Weapon_") then
                o.Transparency=equipped and 0 or 1
            end
        end
    end
    local blade=ch:FindFirstChild("SkybornBlade")
    if blade then blade.Transparency=1 end
end
function A.BossSwing(model,windup)
    if model then
        model:SetAttribute("V5SwingAt",workspace:GetServerTimeNow())
    end
end
return A
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX136F1079262C4CA4A7C40B97C554A576"><Properties><string name="Name">EnvironmentService</string><ProtectedString name="Source">-- Server startup default. Each player applies their realm locally afterward.
return require(game.ReplicatedStorage.Shared.RealmEnvironment)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXC5D6EAA0E0F9432A9785FCABA80F1FA7"><Properties><string name="Name">FrozenCyberCollision</string><ProtectedString name="Source">-- Offline generated proposal. Review and invoke manually after importing art.
