local FRUIT_BY_ID = {}
for _, f in ipairs(FRUIT_CATALOG) do
    FRUIT_BY_ID[f.Id] = f
end

local function fireEquipRemote(payload)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes and remotes:FindFirstChild("EquipmentRequest") then
        remotes.EquipmentRequest:FireServer(payload)
    end
end

local function fireAbilityRemote(payload)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes and remotes:FindFirstChild("AbilityRequest") then
        remotes.AbilityRequest:FireServer(payload)
    end
end

local function mount3DFruitPreview(viewport, fruitInfo)
    if Fruits.SpinConnection then
        Fruits.SpinConnection:Disconnect()
        Fruits.SpinConnection = nil
    end
    for _, ch in ipairs(viewport:GetChildren()) do
        ch:Destroy()
    end

    local worldModel = Instance.new("WorldModel")
    worldModel.Parent = viewport

    local cam = Instance.new("Camera")
    cam.FieldOfView = 38
    cam.Parent = viewport
    viewport.CurrentCamera = cam

    task.spawn(function()
        local built, clips = nil, nil
        if Renderer then
            local ok, res = pcall(Renderer.Build, fruitInfo.Asset)
            if ok and res then
                built = res
            end
            local okC, resC = pcall(Renderer.Clips, fruitInfo.Asset)
            if okC and type(resC) == "table" then
                clips = resC
            end
        end
        if not viewport or not viewport.Parent then
            if built then built:Destroy() end
            return
        end
        if built then
            built.Parent = worldModel
            local cf, size = built:GetBoundingBox()
            local maxDim = math.max(size.X, size.Y, size.Z, 1.5)
            local dist = maxDim * 1.65
            local t0 = os.clock()
            local activeClip = clips and (clips.ElementalSurge or clips.UltimateAwakening or clips.Idle) or nil
            Fruits.SpinConnection = RunService.RenderStepped:Connect(function()
                if not viewport.Parent or not built.Parent then
                    if Fruits.SpinConnection then
                        Fruits.SpinConnection:Disconnect()
                        Fruits.SpinConnection = nil
                    end
                    return
                end
                local t = os.clock() - t0
                local bob = math.sin(t * 2.4) * 0.12
                built:PivotTo(CFrame.new(0, -size.Y * 0.42 + bob, 0) * CFrame.Angles(0, t * 1.15, 0))
                if activeClip and Renderer and Renderer.Pose then
                    pcall(Renderer.Pose, built, activeClip, t)
                end
                cam.CFrame = CFrame.lookAt(Vector3.new(0, 0.35, dist), Vector3.new(0, 0, 0))
            end)
        end
    end)
end

function Fruits.Build(parent, _responsiveState)
    if Fruits.SpinConnection then
        Fruits.SpinConnection:Disconnect()
        Fruits.SpinConnection = nil
    end

    local colors = Theme.Colors
    local snap = Store.GetSnapshot()
    local fState = snap.fruits or {}
    local equippedId = fState.equippedFruit or "GaleCore"
    if not FRUIT_BY_ID[equippedId] then
        equippedId = "SolarTitanCore"
    end
    if not Fruits.SelectedFruitId or not FRUIT_BY_ID[Fruits.SelectedFruitId] then
        Fruits.SelectedFruitId = equippedId
    end
    local selectedFruit = FRUIT_BY_ID[Fruits.SelectedFruitId] or FRUIT_CATALOG[1]

    local root = UIFactory.Create("Frame", parent, {
        Name = "FruitsScreen",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ZIndex = 10,
    })

    -- Top Bar
    local topBar = PremiumPanel.Create(root, {
        name = "TopHeader",
        position = UDim2.fromOffset(18, 12),
        size = UDim2.new(1, -36, 0, 52),
    })

    UIFactory.Label(topBar, {
        Name = "ScreenTitle",
        Text = "🍎 HỆ THỐNG TRÁI ÁC QUỶ 3D • 12 TRÁI ĐÃ TÁCH RIÊNG [G]",
        Position = UDim2.fromOffset(16, 0),
        Size = UDim2.fromOffset(460, 52),
        TextSize = 16,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
    })

    UIFactory.Label(topBar, {
        Name = "CurrencySummary",
        Text = string.format(
            "🪙 %s Gold   •   💎 %s Core Shards   •   Đang dùng: %s",
            UIFactory.FormatNumber(snap.currency.gold),
            UIFactory.FormatNumber(snap.currency.coreShards),
            (FRUIT_BY_ID[equippedId] and FRUIT_BY_ID[equippedId].Name or equippedId)
        ),
        Position = UDim2.new(1, -620, 0, 0),
        Size = UDim2.fromOffset(470, 52),
        TextSize = 13,
        TextColor = colors.TEXT_PRIMARY,
        Bold = true,
        XAlign = Enum.TextXAlignment.Right,
    })

    PremiumButton.Create(topBar, {
        name = "CloseBtn",
        label = "✕ ĐÓNG [ESC]",
        variant = "secondary",
        position = UDim2.new(1, -138, 0.5, -18),
        size = UDim2.fromOffset(124, 36),
        textSize = 12,
        onActivated = function()
            ScreenRouter.CloseAllToHUD()
        end,
    })

    -- Left Column: 3D Separated Devil Fruit Viewport &amp; Actions
    local leftCol = PremiumPanel.Create(root, {
        name = "FruitPreviewPanel",
        variant = "gold",
        position = UDim2.fromOffset(18, 74),
        size = UDim2.new(0.31, -18, 1, -90),
    })

    UIFactory.Label(leftCol, {
        Name = "SelectedFruitTitle",
        Text = selectedFruit.Name,
        Position = UDim2.fromOffset(14, 10),
        Size = UDim2.new(1, -28, 0, 24),
        TextSize = 15,
        TextColor = selectedFruit.Color,
        Bold = true,
    })

    local isAwakened = fState.awakenedFruits and fState.awakenedFruits[selectedFruit.Id] == true
    local masteryLv = (fState.mastery and fState.mastery[selectedFruit.Id]) or 1
    UIFactory.Label(leftCol, {
        Name = "SelectedFruitMeta",
        Text = string.format("%s  •  %s  •  Mastery Lv.%d  %s", selectedFruit.Rarity, selectedFruit.Type, masteryLv, isAwakened and "⚡ [AWAKENED V2]" or ""),
        Position = UDim2.fromOffset(14, 34),
        Size = UDim2.new(1, -28, 0, 18),
        TextSize = 12,
        TextColor = colors.ACCENT_SAPPHIRE,
        Bold = true,
    })

    local viewportBox = UIFactory.Create("ViewportFrame", leftCol, {
        Name = "FruitViewport3D",
        Position = UDim2.fromOffset(14, 56),
        Size = UDim2.new(1, -28, 0, 196),
        BackgroundColor3 = colors.BG_900,
        BorderSizePixel = 0,
        Ambient = Color3.fromRGB(190, 205, 235),
        LightColor = Color3.fromRGB(255, 245, 220),
        LightDirection = Vector3.new(-1, -1, -1),
    })
    UIFactory.Corner(viewportBox, Theme.Radius.Medium)
    UIFactory.Stroke(viewportBox, selectedFruit.Color, 1.8, 0.15)
    mount3DFruitPreview(viewportBox, selectedFruit)

    UIFactory.Label(leftCol, {
        Name = "FruitDesc",
        Text = selectedFruit.Desc,
        Position = UDim2.fromOffset(14, 258),
        Size = UDim2.new(1, -28, 0, 42),
        TextSize = 12,
        TextColor = colors.TEXT_SECONDARY,
        Wrapped = true,
    })

    -- Action Buttons for Selected Fruit
    PremiumButton.Create(leftCol, {
        name = "EatFruitBtn",
        label = (equippedId == selectedFruit.Id) and "✓ ĐANG TRANG BỊ (BẤM ĐỂ KÍCH HOẠT SLOT [2])" or "🍎 ĂN / TRANG BỊ TRÁI NÀY NGAY",
        variant = "gold",
        position = UDim2.fromOffset(14, 306),
        size = UDim2.new(1, -28, 0, 40),
        textSize = 13,
        onActivated = function()
            fireEquipRemote({ action = "EatFruit", fruitId = selectedFruit.Id })
            task.delay(0.15, function()
                Fruits.Update()
            end)
        end,
    })

    PremiumButton.Create(leftCol, {
        name = "HoldFruitBtn",
        label = (fState.heldFruit == selectedFruit.Id) and "✋ ĐANG CẦM 3D TRÊN TAY (BẤM ĐỂ CẤT)" or "✋ CẦM MÔ HÌNH TRÁI 3D TRÊN TAY",
        variant = "primary",
        position = UDim2.fromOffset(14, 352),
        size = UDim2.new(0.5, -18, 0, 38),
        textSize = 11,
        onActivated = function()
            fireEquipRemote({ action = "HoldFruit", fruitId = selectedFruit.Id })
            task.delay(0.15, function()
                Fruits.Update()
            end)
        end,
    })

    PremiumButton.Create(leftCol, {
        name = "AwakenFruitBtn",
        label = isAwakened and "⚡ ĐÃ THỨC TỈNH V2" or "⚡ THỨC TỈNH V2 (500💎)",
        variant = "secondary",
        position = UDim2.new(0.5, 4, 0, 352),
        size = UDim2.new(0.5, -18, 0, 38),
        textSize = 11,
        onActivated = function()
            fireEquipRemote({ action = "AwakenFruit", fruitId = selectedFruit.Id })
            task.delay(0.15, function()
                Fruits.Update()
            end)
        end,
    })

    PremiumButton.Create(leftCol, {
        name = "RollGachaBtn",
        label = "🎲 QUAY GACHA TRÁI ÁC QUỶ ZIOLES (25,000 Gold)",
        variant = "primary",
        position = UDim2.fromOffset(14, 396),
        size = UDim2.new(1, -28, 0, 40),
        textSize = 12,
        onActivated = function()
            fireEquipRemote({ action = "RollFruit" })
            task.delay(0.2, function()
                local latest = Store.GetSnapshot()
                if latest and latest.fruits and latest.fruits.heldFruit and latest.fruits.heldFruit ~= "" then
                    Fruits.SelectedFruitId = latest.fruits.heldFruit
                end
                Fruits.Update()
            end)
        end,
    })

    -- Haki &amp; Race V4 Strip inside Left Panel bottom
    UIFactory.Label(leftCol, {
        Name = "HakiHeader",
        Text = "⚡ HAKI BA LOẠI &amp; THỨC TỈNH TỘC V4",
        Position = UDim2.fromOffset(14, 444),
        Size = UDim2.new(1, -28, 0, 20),
        TextSize = 12,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
    })

    local hakiRow = UIFactory.Create("Frame", leftCol, {
        Name = "HakiButtons",
        Position = UDim2.fromOffset(14, 468),
        Size = UDim2.new(1, -28, 0, 76),
        BackgroundTransparency = 1,
    })
    UIFactory.GridLayout(hakiRow, UDim2.new(0.5, -6, 0, 34), UDim2.fromOffset(8, 6))

    local hakiActions = {
        { id = "Aura", label = (fState.haki and fState.haki.Aura) and "⚔ HAKI VŨ TRANG: BẬT" or "⚔ HAKI VŨ TRANG [J]", act = "ToggleAura" },
        { id = "Instinct", label = (fState.haki and fState.haki.Instinct) and "👁 HAKI QUAN SÁT: BẬT" or "👁 HAKI QUAN SÁT [U]", act = "ToggleInstinct" },
        { id = "Conqueror", label = "👑 HAKI BÁ VƯƠNG [H]", act = "ConquerorBurst" },
        { id = "RaceV4", label = fState.raceV4Active and ("🪽 TỘC V4 [" .. tostring(fState.race) .. "]: BẬT") or "🪽 THỨC TỈNH TỘC V4 [Y]", act = "ActivateRaceV4" },
    }
    for idx, hk in ipairs(hakiActions) do
        PremiumButton.Create(hakiRow, {
            name = hk.id,
            label = hk.label,
            variant = "secondary",
            layoutOrder = idx,
            textSize = 11,
            onActivated = function()
                fireEquipRemote({ action = hk.act })
                task.delay(0.15, function()
                    Fruits.Update()
                end)
            end,
        })
    end

    -- Center Column: 5 Active Moves ([Z][X][C][V][F]) + Blox-Fruits 4 Slots
    local centerCol = PremiumPanel.Create(root, {
        name = "FruitMovesPanel",
        position = UDim2.new(0.31, 8, 0, 74),
        size = UDim2.new(0.33, -12, 1, -90),
    })

    UIFactory.Label(centerCol, {
        Name = "MovesHeader",
        Text = "🔥 BỘ 5 KỸ NĂNG TRÁI ÁC QUỶ ([Z] [X] [C] [V] [F])",
        Position = UDim2.fromOffset(14, 12),
        Size = UDim2.new(1, -28, 0, 24),
        TextSize = 15,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
    })

    local movesList = UIFactory.Create("Frame", centerCol, {
        Name = "MovesList",
        Position = UDim2.fromOffset(14, 44),
        Size = UDim2.new(1, -28, 1, -130),
        BackgroundTransparency = 1,
    })
    UIFactory.ListLayout(movesList, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)

    for idx, mv in ipairs(selectedFruit.Moves) do
        local mvCard = UIFactory.Create("Frame", movesList, {
            Name = "Move_" .. mv.Key,
            Size = UDim2.new(1, 0, 0, 72),
            BackgroundColor3 = colors.BG_900,
            BorderSizePixel = 0,
            LayoutOrder = idx,
        })
        UIFactory.Corner(mvCard, Theme.Radius.Small)
        UIFactory.Stroke(mvCard, selectedFruit.Color, 1.2, 0.25)

        local keyBadge = UIFactory.Create("Frame", mvCard, {
            Name = "KeyBadge",
            Position = UDim2.fromOffset(10, 12),
            Size = UDim2.fromOffset(46, 46),
            BackgroundColor3 = colors.BG_800,
            BorderSizePixel = 0,
        })
        UIFactory.Corner(keyBadge, Theme.Radius.Small)
        UIFactory.Stroke(keyBadge, selectedFruit.Color, 1.5, 0.1)
        UIFactory.Label(keyBadge, {
            Name = "KeyText",
            Text = "[" .. mv.Key .. "]",
            Size = UDim2.fromScale(1, 1),
            TextSize = 16,
            TextColor = selectedFruit.Color,
            Bold = true,
            XAlign = Enum.TextXAlignment.Center,
        })

        UIFactory.Label(mvCard, {
            Name = "MoveName",
            Text = mv.Name,
            Position = UDim2.fromOffset(66, 10),
            Size = UDim2.new(1, -180, 0, 24),
            TextSize = 14,
            TextColor = colors.TEXT_PRIMARY,
            Bold = true,
        })

        UIFactory.Label(mvCard, {
            Name = "MoveStats",
            Text = string.format("Sát thương: %s   •   Tầm: %s   •   Hồi: %s", mv.Mult, mv.Range, mv.Cd),
            Position = UDim2.fromOffset(66, 36),
            Size = UDim2.new(1, -180, 0, 20),
            TextSize = 11,
            TextColor = colors.ACCENT_SAPPHIRE,
            Bold = true,
        })

        PremiumButton.Create(mvCard, {
            name = "Cast_" .. mv.Key,
            label = "THI TRIỂN [" .. mv.Key .. "]",
            variant = "primary",
            position = UDim2.new(1, -112, 0.5, -18),
            size = UDim2.fromOffset(102, 36),
            textSize = 11,
            onActivated = function()
                if equippedId ~= selectedFruit.Id then
                    fireEquipRemote({ action = "EatFruit", fruitId = selectedFruit.Id })
                else
                    fireEquipRemote({ action = "SelectSlot", slot = 2 })
                end
                task.delay(0.08, function()
                    ScreenRouter.CloseAllToHUD()
                    fireAbilityRemote({ action = "SlotMove", key = mv.Key })
                end)
            end,
        })
    end

    -- 4 Loadout Slots Strip at bottom of Center Column
    local slotStrip = UIFactory.Create("Frame", centerCol, {
        Name = "LoadoutSlotStrip",
        Position = UDim2.new(0, 14, 1, -74),
        Size = UDim2.new(1, -28, 0, 62),
        BackgroundTransparency = 1,
    })
    UIFactory.GridLayout(slotStrip, UDim2.new(0.25, -6, 0, 54), UDim2.fromOffset(6, 6))

    local slotsInfo = {
        { slot = 1, label = "[1] VÕ: " .. tostring(fState.fightingStyle or "SkybornCombat") },
        { slot = 2, label = "[2] TRÁI: " .. tostring(selectedFruit.Id) },
        { slot = 3, label = "[3] KIẾM: " .. tostring(snap.equipped.Weapon or "starter_sword") },
        { slot = 4, label = "[4] SÚNG: " .. tostring(fState.equippedGun or "aether_flintlock") },
    }
    for _, sl in ipairs(slotsInfo) do
        PremiumButton.Create(slotStrip, {
            name = "Slot_" .. sl.slot,
            label = sl.label,
            variant = (fState.activeSlot == sl.slot) and "gold" or "secondary",
            layoutOrder = sl.slot,
            textSize = 10,
            onActivated = function()
                fireEquipRemote({ action = "SelectSlot", slot = sl.slot })
                task.delay(0.12, function()
                    Fruits.Update()
                end)
            end,
        })
    end

    -- Right Column: All 12 Separated 3D Devil Fruits Grid
    local rightCol = PremiumPanel.Create(root, {
        name = "AllFruitsGridPanel",
        position = UDim2.new(0.64, 4, 0, 74),
        size = UDim2.new(0.36, -22, 1, -90),
    })

    UIFactory.Label(rightCol, {
        Name = "CatalogHeader",
        Text = "🍇 KHO 12 TRÁI ÁC QUỶ 3D ĐÃ TÁCH RIÊNG (CHỌN ĐỂ ĂN / CẦM 3D)",
        Position = UDim2.fromOffset(14, 12),
        Size = UDim2.new(1, -28, 0, 24),
        TextSize = 14,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
    })

    local scroll = UIFactory.Create("ScrollingFrame", rightCol, {
        Name = "FruitScroll",
        Position = UDim2.fromOffset(14, 44),
        Size = UDim2.new(1, -28, 1, -56),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 5,
        ScrollBarImageColor3 = colors.ACCENT_GOLD,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.fromOffset(0, 0),
    })
    UIFactory.GridLayout(scroll, UDim2.new(0.5, -6, 0, 94), UDim2.fromOffset(8, 8))

    local stored = fState.storedFruits or {}
    for idx, item in ipairs(FRUIT_CATALOG) do
        local isSelected = (item.Id == selectedFruit.Id)
        local isEq = (item.Id == equippedId)
        local ownedCount = tonumber(stored[item.Id]) or 0

        local card = UIFactory.Create("TextButton", scroll, {
            Name = item.Id,
            BackgroundColor3 = isSelected and colors.BG_800 or colors.BG_900,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = true,
            LayoutOrder = idx,
        })
        UIFactory.Corner(card, Theme.Radius.Small)
        UIFactory.Stroke(card, isEq and colors.ACCENT_GOLD or (isSelected and item.Color or colors.BORDER_MUTED), isEq and 2.0 or 1.2, 0.1)

        UIFactory.Label(card, {
            Name = "Title",
            Text = item.Name,
            Position = UDim2.fromOffset(10, 6),
            Size = UDim2.new(1, -20, 0, 20),
            TextSize = 12,
            TextColor = item.Color,
            Bold = true,
        })

        UIFactory.Label(card, {
            Name = "RarityType",
            Text = item.Rarity .. " • " .. item.Type,
            Position = UDim2.fromOffset(10, 26),
            Size = UDim2.new(1, -20, 0, 16),
            TextSize = 10,
            TextColor = colors.TEXT_SECONDARY,
            Bold = true,
        })

        UIFactory.Label(card, {
            Name = "Status",
            Text = isEq and "★ ĐANG TRANG BỊ" or (ownedCount &gt; 0 and ("Trong kho: x" .. tostring(ownedCount)) or "Sẵn sàng trang bị"),
            Position = UDim2.fromOffset(10, 44),
            Size = UDim2.new(1, -20, 0, 16),
            TextSize = 10,
            TextColor = isEq and colors.ACCENT_GOLD or colors.ACCENT_SAPPHIRE,
            Bold = true,
        })

        PremiumButton.Create(card, {
            name = "QuickEat_" .. item.Id,
            label = isEq and "ĐANG DÙNG" or "🍎 ĂN NGAY",
            variant = isEq and "gold" or "primary",
            position = UDim2.fromOffset(8, 62),
            size = UDim2.new(0.54, -10, 0, 26),
            textSize = 10,
            onActivated = function()
                Fruits.SelectedFruitId = item.Id
                fireEquipRemote({ action = "EatFruit", fruitId = item.Id })
                task.delay(0.15, function()
                    Fruits.Update()
                end)
            end,
        })

        PremiumButton.Create(card, {
            name = "QuickHold_" .. item.Id,
            label = "✋ CẦM 3D",
            variant = "secondary",
            position = UDim2.new(0.54, 2, 0, 62),
            size = UDim2.new(0.46, -10, 0, 26),
            textSize = 10,
            onActivated = function()
                Fruits.SelectedFruitId = item.Id
                fireEquipRemote({ action = "HoldFruit", fruitId = item.Id, forceHold = true })
                task.delay(0.15, function()
                    Fruits.Update()
                end)
            end,
        })

        card.Activated:Connect(function()
            Fruits.SelectedFruitId = item.Id
            Fruits.Update()
        end)
    end

    return root
end

function Fruits.Update()
    local App = require(script.Parent.Parent:WaitForChild("App"))
    if ScreenRouter.CurrentScreen == UIState.Screens.Fruits then
        App.RebuildActiveScreen()
    end
end

return Fruits
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXAD91E832FA0A42A083C934A2B7FD200B"><Properties><string name="Name">HUD</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Gameplay HUD Screen (Phase 2)
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Screens/HUD.lua
-- Layout: Top-left Player Vitals (Humanoid bound), Mid-left QuestTracker, Top-right Compass &amp; Quick Menu,
-- Top-center RaidPhase Boss Bar (when active), Bottom-center PC Hotbar / Bottom-right Mobile Touch Arc.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))
local WorldConfig = require(Shared:WaitForChild("Config"):WaitForChild("WorldConfig"))
local UIState = require(Shared:WaitForChild("Types"):WaitForChild("UIState"))

local UIFactory = require(script.Parent.Parent:WaitForChild("UIFactory"))
local Store = require(script.Parent.Parent:WaitForChild("Store"))
local ScreenRouter = require(script.Parent.Parent:WaitForChild("ScreenRouter"))
local PremiumPanel = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("PremiumPanel"))
local PremiumButton = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("PremiumButton"))
local StatBar = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("StatBar"))
local QuestTracker = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("QuestTracker"))
local SkillButton = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("SkillButton"))
local RaidPhase = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("RaidPhase"))
local HUDController = require(script.Parent.Parent:WaitForChild("Controllers"):WaitForChild("HUDController"))

local HUD = {
    Refs = {},
}

function HUD.Build(parent, responsiveState)
    HUD.Cleanup()
    local colors = Theme.Colors
    local snap = Store.GetSnapshot()
    local view = Store.GetView()
    local isMobile = responsiveState and (responsiveState.TouchControls or responsiveState.IsPortrait)
    local isPortrait = responsiveState and responsiveState.IsPortrait
    local player = Players.LocalPlayer

    local root = UIFactory.Create("Frame", parent, {
        Name = "CombatHUD",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ZIndex = 2,
    })

    -- 1. Top-Left Player Vitals Card
    local vitalsCard = PremiumPanel.Create(root, {
        name = "PlayerHUD",
        position = UDim2.fromOffset(18, 16),
        size = UDim2.fromOffset(isPortrait and 360 or 354, 128),
        transparency = Theme.Transparency.HUDCard,
    })

    local classCfg = WorldConfig.Classes[snap.player.classId] or WorldConfig.Classes.SkyGuardian

    local portraitFrame = UIFactory.Create("Frame", vitalsCard, {
        Name = "ClassCrest",
        Position = UDim2.fromOffset(12, 12),
        Size = UDim2.fromOffset(76, 76),
        BackgroundColor3 = colors.BG_900,
        BorderSizePixel = 0,
    })
    UIFactory.Corner(portraitFrame, Theme.Radius.Medium)
    UIFactory.Stroke(portraitFrame, classCfg.AccentColor or colors.ACCENT_GOLD, 1.6, 0.15)
    UIFactory.Icon(portraitFrame, classCfg.Icon or "Sword", UDim2.new(0.5, -22, 0.5, -22), 44, classCfg.AccentColor)

    local levelLabel = UIFactory.Label(vitalsCard, {
        Name = "Level",
        Text = "Lv. " .. tostring(snap.player.level),
        Position = UDim2.fromOffset(12, 92),
        Size = UDim2.fromOffset(76, 22),
        TextSize = 15,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
        XAlign = Enum.TextXAlignment.Center,
    })

    local tierTag = (snap.player.level or 1) &lt; 5 and "NOVICE (SƠ KHAI)" or ((snap.player.level or 1) &lt; 15 and "ADVENTURER" or string.upper(classCfg.Name))
    local playerNameLabel = UIFactory.Label(vitalsCard, {
        Name = "PlayerName",
        Text = ((player and player.DisplayName) or "Skyborn") .. "  •  " .. tierTag,
        Position = UDim2.fromOffset(100, 10),
        Size = UDim2.new(1, -112, 0, 22),
        TextSize = 13,
        TextColor = colors.TEXT_PRIMARY,
        Bold = true,
    })

    local _, hpBarApi = StatBar.Create(vitalsCard, {
        name = "HPBar",
        type = "HP",
        current = snap.vitals.hp,
        max = snap.vitals.maxHp,
        label = "HP",
        position = UDim2.fromOffset(100, 36),
        size = UDim2.new(1, -112, 0, 26),
        scope = "HUD",
    })
    HUDController.BindHumanoidToBar(hpBarApi)

    local _, staminaBarApi = StatBar.Create(vitalsCard, {
        name = "StaminaBar",
        type = "Energy",
        current = snap.vitals.stamina,
        max = snap.vitals.maxStamina,
        label = "EN",
        position = UDim2.fromOffset(100, 68),
        size = UDim2.new(1, -112, 0, 22),
        scope = "HUD",
    })

    local _, xpBarApi = StatBar.Create(vitalsCard, {
        name = "XPBar",
        type = "EXP",
        current = snap.player.exp,
        max = snap.player.expToNext,
        customText = string.format("EXP %s / %s", UIFactory.FormatNumber(snap.player.exp), UIFactory.FormatNumber(snap.player.expToNext)),
        position = UDim2.fromOffset(100, 96),
        size = UDim2.new(1, -112, 0, 18),
        textSize = 11,
        scope = "HUD",
    })

    local shieldLabel = UIFactory.Label(root, {
        Name = "ShieldStatus",
        Text = snap.vitals.shieldRemaining &gt; 0 and string.format("🛡 AEGIS BARRIER • %ds", math.ceil(snap.vitals.shieldRemaining)) or "",
        Position = UDim2.fromOffset(22, 148),
        Size = UDim2.fromOffset(340, 22),
        TextSize = 14,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
    })

    -- 2. Middle-Left Collapsible Quest Tracker
    local _, questTrackerApi = QuestTracker.Create(root, {
        name = "QuestTracker",
        position = UDim2.fromOffset(18, 174),
        size = UDim2.fromOffset(isPortrait and 330 or 318, 172),
        collapsed = view.questTrackerCollapsed,
        onToggleCollapse = function(isCol)
            Store.SetView({ questTrackerCollapsed = isCol })
        end,
        onOpenJournal = function()
            ScreenRouter.Navigate(UIState.Screens.QuestJournal)
        end,
    })
    questTrackerApi:Update({ activeQuest = snap.quest })

    -- 3. Top-Right Region Compass &amp; Quick Navigation Bar
    local compassCard = PremiumPanel.Create(root, {
        name = "Compass",
        position = UDim2.new(1, -248, 0, 16),
        size = UDim2.fromOffset(230, 118),
        transparency = Theme.Transparency.HUDCard,
        visible = view.settings.showMinimap ~= false,
    })

    local currentRealmCfg = WorldConfig.RealmById[snap.world.current] or WorldConfig.RealmById.GoldenSky
    local curWorldOrder = (player and player:GetAttribute("CurrentWorldOrder")) or 1
    local realmTitle = UIFactory.Label(compassCard, {
        Name = "CompassTitle",
        Text = string.format("◈  %s (W%d/20)", string.upper(currentRealmCfg.Name), curWorldOrder),
        Position = UDim2.fromOffset(10, 6),
        Size = UDim2.new(1, -20, 0, 20),
        TextSize = 13,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
    })

    local nextGateLbl = (player and player:GetAttribute("NextWorldGateLabel")) or "WORLD 1 ➡ WORLD 2"
    local portalCompassLabel = UIFactory.Label(compassCard, {
        Name = "Directions",
        Text = "🌀 " .. tostring(nextGateLbl),
        Position = UDim2.fromOffset(10, 26),
        Size = UDim2.new(1, -20, 0, 34),
        TextSize = 11,
        TextColor = colors.ACCENT_SAPPHIRE,
        Bold = true,
        Wrapped = true,
        XAlign = Enum.TextXAlignment.Center,
    })

    PremiumButton.Create(compassCard, {
        name = "OpenMap",
        label = "WORLD MAP [M]",
        variant = "secondary",
        position = UDim2.fromOffset(12, 66),
        size = UDim2.new(1, -24, 0, 38),
        textSize = 13,
        onActivated = function()
            ScreenRouter.Navigate(UIState.Screens.WorldMap)
        end,
    })

    -- 3B. Top-Right Companion Squad Progression Card (Solo Lv.1 -&gt; Kairo Lv.15 -&gt; Lumen Lv.30 -&gt; Nyx Lv.50)
    local companionCard = PremiumPanel.Create(root, {
        name = "CompanionSquadCard",
        position = UDim2.new(1, -248, 0, 140),
        size = UDim2.fromOffset(230, 86),
        transparency = Theme.Transparency.HUDCard,
    })

    local companionTitle = UIFactory.Label(companionCard, {
        Name = "CompanionTitle",
        Text = "🛡 ĐỒNG HÀNH: SOLO (SƠ KHAI)",
        Position = UDim2.fromOffset(10, 6),
        Size = UDim2.new(1, -20, 0, 18),
        TextSize = 11,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
    })

    local companionSub = UIFactory.Label(companionCard, {
        Name = "CompanionRoster",
        Text = "🔒Kairo(Lv15) • 🔒Lumen(Lv30) • 🔒Nyx(Lv50)",
        Position = UDim2.fromOffset(10, 24),
        Size = UDim2.new(1, -20, 0, 18),
        TextSize = 10,
        TextColor = colors.TEXT_SECONDARY,
        Bold = true,
    })

    local partyBtnRow = UIFactory.Create("Frame", companionCard, {
        Name = "PartySizeButtons",
        Position = UDim2.fromOffset(8, 46),
        Size = UDim2.new(1, -16, 0, 32),
        BackgroundTransparency = 1,
    })
    UIFactory.ListLayout(partyBtnRow, Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)

    local partySizeDefs = {
        { id = "Solo", label = "SOLO", reqLv = 1 },
        { id = "Duo", label = "DUO (Lv15)", reqLv = 15 },
        { id = "Trio", label = "TRIO (Lv30)", reqLv = 30 },
        { id = "Squad", label = "SQUAD (Lv50)", reqLv = 50 },
    }
    local partySizeApis = {}
    local curPartySize = (snap.party and snap.party.partySize) or "Solo"
    for idx, ps in ipairs(partySizeDefs) do
        local _, pApi = PremiumButton.Create(partyBtnRow, {
            name = "Party_" .. ps.id,
            label = ps.label,
            variant = (curPartySize == ps.id) and "gold" or "secondary",
            size = UDim2.fromOffset(ps.id == "Squad" and 58 or 50, 28),
            textSize = 9,
            layoutOrder = idx,
            onActivated = function()
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                if remotes and remotes:FindFirstChild("EquipmentRequest") then
                    remotes.EquipmentRequest:FireServer({ action = "SetPartySize", size = ps.id })
                end
            end,
        })
        partySizeApis[ps.id] = pApi
    end

    -- Quick Navigation Strip (Bottom-Left — compact so it never overlaps AbilityHotbar)
    local quickNav = UIFactory.Create("Frame", root, {
        Name = "QuickNavStrip",
        Position = UDim2.new(0, 14, 1, -50),
        Size = UDim2.fromOffset(isPortrait and 460 or 496, 36),
        BackgroundTransparency = 1,
    })
    UIFactory.ListLayout(quickNav, Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)

    local navItems = {
        { id = "Menu", label = "☰ MENU", route = UIState.Screens.MainMenu, width = 62 },
        { id = "Fruits", label = "🍎 FRUITS [G]", route = UIState.Screens.Fruits, isGold = true, width = 88 },
        { id = "Inventory", label = "BAG [I]", route = UIState.Screens.Inventory, width = 58 },
        { id = "Skills", label = "SKILLS [K]", route = UIState.Screens.Skills, width = 68 },
        { id = "Quests", label = "QUESTS [J]", route = UIState.Screens.QuestJournal, width = 70 },
        { id = "Forge", label = "FORGE [F]", route = UIState.Screens.Forge, width = 64 },
        { id = "Raid", label = "RAID [P]", route = UIState.Screens.Raid, width = 58 },
    }
    for idx, nav in ipairs(navItems) do
        PremiumButton.Create(quickNav, {
            name = nav.id,
            label = nav.label,
            variant = nav.isGold and "gold" or "secondary",
            size = UDim2.fromOffset(isPortrait and 60 or (nav.width or 66), 34),
            textSize = 10,
            layoutOrder = idx,
            onActivated = function()
                ScreenRouter.Navigate(nav.route)
            end,
        })
    end

    -- Blox-Fruits Loadout Slots ([1]-[4]) &amp; Devil Fruit Moves ([Z][X][C][V][F]) Strip above Hotbar
    local fruitMovesBar = UIFactory.Create("Frame", root, {
        Name = "FruitLoadoutMovesStrip",
        AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 108, 1, -96),
        Size = UDim2.fromOffset(540, 32),
        BackgroundTransparency = 1,
    })
    UIFactory.ListLayout(fruitMovesBar, Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)

    local eqFruitId = (snap.fruits and snap.fruits.equippedFruit) or "GaleCore"
    local activeSlotNum = (snap.fruits and snap.fruits.activeSlot) or 2
    local fruitMoveDefs = {
        { id = "Slot1", label = "[1] Võ", isSlot = 1, w = 56 },
        { id = "Slot2", label = "🍎 [2] " .. tostring(eqFruitId):gsub("Core", ""), isSlot = 2, w = 108 },
        { id = "Slot3", label = "[3] Kiếm", isSlot = 3, w = 62 },
        { id = "Slot4", label = "[4] Súng", isSlot = 4, w = 62 },
        { id = "MoveZ", label = "[Z]", moveKey = "Z", w = 38 },
        { id = "MoveX", label = "[X]", moveKey = "X", w = 38 },
        { id = "MoveC", label = "[C]", moveKey = "C", w = 38 },
        { id = "MoveV", label = "[V]", moveKey = "V", w = 38 },
        { id = "MoveF", label = "[F]", moveKey = "F", w = 38 },
    }
    local fruitSlotApis = {}
    for idx, fm in ipairs(fruitMoveDefs) do
        local _, fApi = PremiumButton.Create(fruitMovesBar, {
            name = fm.id,
            label = fm.label,
            variant = (fm.isSlot == activeSlotNum) and "gold" or (fm.moveKey and "primary" or "secondary"),
            size = UDim2.fromOffset(fm.w or 42, 30),
            textSize = 10,
            layoutOrder = idx,
            onActivated = function()
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                if fm.isSlot then
                    if remotes and remotes:FindFirstChild("EquipmentRequest") then
                        remotes.EquipmentRequest:FireServer({ action = "SelectSlot", slot = fm.isSlot })
                    end
                elseif fm.moveKey then
                    HUDController.TriggerAction(fm.moveKey)
                end
            end,
        })
        if fm.isSlot then
            fruitSlotApis[fm.isSlot] = fApi
        end
    end

    -- 4. Top-Center Boss / Raid Phase Bar (only visible during encounter or raid preview)
    local _, bossBarApi = RaidPhase.Create(root, {
        name = "BossHUD",
        position = isPortrait and UDim2.new(0.5, 0, 0, 356) or UDim2.new(0.5, 0, 0, 16),
        size = UDim2.fromOffset(isPortrait and 520 or 540, 112),
        visible = snap.raid and snap.raid.active == true,
    })
    if snap.raid and snap.raid.active then
        bossBarApi:Update(snap.raid)
    end

    -- 5. Contextual [E] Interact Prompt
    local interactBtn, interactApi = PremiumButton.Create(root, {
        name = "Interact",
        label = view.interactPrompt and ("[E] • " .. view.interactPrompt) or "[E] • INTERACT",
        variant = "gold",
        anchorPoint = Vector2.new(0.5, 1),
        position = UDim2.new(0.5, 108, 1, -136),
        size = UDim2.fromOffset(330, 42),
        visible = view.interactPrompt ~= nil,
        onActivated = function()
            HUDController.TriggerAction("Interact")
        end,
    })

    -- 6. Ability Hotbar (PC Bottom-Center vs Mobile Right-Thumb Cluster)
    local skills = classCfg.Skills or {}
    local sk1 = skills[1] or { Id = "SkySlash", Name = "Sky Slash", Keybind = "1", Icon = "Sword", LevelReq = 1, Cooldown = 6 }
    local sk2 = skills[2] or { Id = "GuardianShield", Name = "Guardian Shield", Keybind = "2", Icon = "Shield", LevelReq = 5, Cooldown = 16 }
    local sk3 = skills[4] or { Id = "JudgmentStrike", Name = "Judgment Strike", Keybind = "3", Icon = "Bolt", LevelReq = 12, Cooldown = 12, EnergyCost = 25 }
    local skUlt = skills[5] or { Id = "CelestialAegis", Name = "Celestial Aegis", Keybind = "R", Icon = "Core", LevelReq = 20, Cooldown = 45, EnergyCost = 100 }

    local hotbarDefinitions = {
        { action = "Skill1", cfg = sk1 },
        { action = "Skill2", cfg = sk2 },
        { action = "Skill3", cfg = sk3 },
        {
            action = "Dodge",
            cfg = { Id = "Dodge", Name = "Dodge", Keybind = "Q", Icon = "Bolt", LevelReq = 1, Cooldown = 1.2, EnergyCost = 30 },
        },
        {
            action = "Ultimate",
            cfg = skUlt,
            isUltimate = true,
        },
    }

    local hotbarHolder = UIFactory.Create("Frame", root, {
        Name = "AbilityHotbar",
        AnchorPoint = isMobile and Vector2.new(1, 1) or Vector2.new(0.5, 1),
        Position = isMobile and UDim2.new(1, -140, 1, -18) or UDim2.new(0.5, 108, 1, -12),
        Size = UDim2.fromOffset(440, 78),
        BackgroundTransparency = 1,
    })
    UIFactory.ListLayout(hotbarHolder, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)

    local skillSlotApis = {}
    for idx, slot in ipairs(hotbarDefinitions) do
        local _, api = SkillButton.Create(hotbarHolder, {
            name = slot.action,
            skillId = slot.cfg.Id,
            label = slot.cfg.Name,
            keybind = slot.cfg.Keybind,
            icon = slot.cfg.Icon,
            energyCost = slot.cfg.EnergyCost or slot.cfg.StaminaCost or 0,
            maxCooldown = slot.cfg.Cooldown or 6,
            isUltimate = slot.isUltimate,
            locked = snap.player.level &lt; (slot.cfg.LevelReq or 1),
            layoutOrder = idx,
            size = UDim2.fromOffset(82, 74),
            onActivated = function()
                HUDController.TriggerAction(slot.action)
            end,
        })
        skillSlotApis[slot.action] = {
            Api = api,
            Config = slot.cfg,
        }
    end

    -- Right-Side Combat Strike &amp; Dash Cluster (Touch-friendly &amp; PC clickable)
    local strikeBtn = UIFactory.Create("TextButton", root, {
        Name = "Attack",
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -22, 1, -22),
        Size = UDim2.fromOffset(96, 96),
        BackgroundColor3 = colors.ACCENT_DEEP_BLUE,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 7,
    })
    UIFactory.PillCorner(strikeBtn)
    UIFactory.Stroke(strikeBtn, colors.ACCENT_GOLD, 2.2, 0.08)
    UIFactory.Gradient(strikeBtn, colors.ACCENT_SAPPHIRE, colors.ACCENT_DEEP_BLUE, 90)
    UIFactory.Icon(strikeBtn, classCfg.Icon or "Sword", UDim2.new(0.5, -22, 0.36, -22), 44, colors.TEXT_PRIMARY)
    UIFactory.Label(strikeBtn, {
        Name = "Caption",
        Text = "STRIKE / HOLD",
        Position = UDim2.new(0, 6, 1, -24),
        Size = UDim2.new(1, -12, 0, 18),
        TextSize = 10,
        TextColor = colors.TEXT_PRIMARY,
        Bold = true,
        XAlign = Enum.TextXAlignment.Center,
        ZIndex = 8,
    })
    strikeBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            HUDController.TriggerAttackInput(input)
        end
    end)

    local _, dashApi = PremiumButton.Create(root, {
        name = "Dash",
        label = "DASH • SHIFT",
        variant = "secondary",
        anchorPoint = Vector2.new(1, 1),
        position = UDim2.new(1, -22, 1, -126),
        size = UDim2.fromOffset(96, 40),
        textSize = 11,
        onActivated = function()
            HUDController.TriggerAction("Dash")
        end,
    })

    HUD.Refs = {
        Root = root,
        LevelLabel = levelLabel,
        PlayerNameLabel = playerNameLabel,
        FruitSlotApis = fruitSlotApis,
        HPBarApi = hpBarApi,
        StaminaBarApi = staminaBarApi,
        XPBarApi = xpBarApi,
        ShieldLabel = shieldLabel,
        QuestTrackerApi = questTrackerApi,
        RealmTitle = realmTitle,
        PortalCompassLabel = portalCompassLabel,
        CompassCard = compassCard,
        CompanionCard = companionCard,
        CompanionTitle = companionTitle,
        CompanionSub = companionSub,
        PartySizeApis = partySizeApis,
        BossBarApi = bossBarApi,
        InteractBtn = interactBtn,
        InteractApi = interactApi,
        SkillSlotApis = skillSlotApis,
        DashApi = dashApi,
    }

    HUD.Update(snap, view)
    return root
end

function HUD.Update(snapshot, viewState)
    local refs = HUD.Refs
    if not refs.Root or not snapshot then
        return
    end
    viewState = viewState or Store.GetView()

    if refs.LevelLabel then
        refs.LevelLabel.Text = "Lv. " .. tostring(snapshot.player.level)
    end
    if refs.PlayerNameLabel then
        local player = Players.LocalPlayer
        local classCfg = WorldConfig.Classes[snapshot.player.classId] or WorldConfig.Classes.SkyGuardian
        local lv = tonumber(snapshot.player.level) or 1
        local tierTag = lv &lt; 5 and "NOVICE (SƠ KHAI)" or (lv &lt; 15 and "ADVENTURER" or string.upper(classCfg.Name))
        refs.PlayerNameLabel.Text = ((player and player.DisplayName) or "Skyborn") .. "  •  " .. tierTag
    end
    if refs.FruitSlotApis and snapshot.fruits then
        local eqF = tostring(snapshot.fruits.equippedFruit or "GaleCore"):gsub("Core", "")
        local actSlot = tonumber(snapshot.fruits.activeSlot) or 2
        if refs.FruitSlotApis[2] then
            refs.FruitSlotApis[2]:Update({ label = "🍎 [2] " .. eqF })
        end
        for sIdx, sApi in pairs(refs.FruitSlotApis) do
            if sApi and sApi.SetVariant then
                sApi:SetVariant(sIdx == actSlot and "gold" or "secondary")
            end
        end
    end
    if refs.HPBarApi then
        refs.HPBarApi:Update({
            current = snapshot.vitals.hp,
            max = snapshot.vitals.maxHp,
        })
    end
    if refs.StaminaBarApi then
        refs.StaminaBarApi:Update({
            current = snapshot.vitals.stamina,
            max = snapshot.vitals.maxStamina,
        })
    end
    if refs.XPBarApi then
        refs.XPBarApi:Update({
            current = snapshot.player.exp,
            max = snapshot.player.expToNext,
            customText = string.format("EXP %s / %s", UIFactory.FormatNumber(snapshot.player.exp), UIFactory.FormatNumber(snapshot.player.expToNext)),
        })
    end
    if refs.ShieldLabel then
        local sh = tonumber(snapshot.vitals.shieldRemaining) or 0
        refs.ShieldLabel.Text = sh &gt; 0 and string.format("🛡 AEGIS BARRIER • %ds", math.ceil(sh)) or ""
    end
    if refs.QuestTrackerApi then
        refs.QuestTrackerApi:Update({
            activeQuest = snapshot.quest,
            collapsed = viewState.questTrackerCollapsed,
        })
    end
    if refs.RealmTitle and snapshot.world then
        local player = Players.LocalPlayer
        local wOrder = (player and player:GetAttribute("CurrentWorldOrder")) or 1
        local realmCfg = WorldConfig.RealmById[snapshot.world.current] or WorldConfig.RealmById.GoldenSky
        refs.RealmTitle.Text = string.format("◈  %s (W%d/20)", string.upper(realmCfg.Name), wOrder)
        if refs.PortalCompassLabel then
            local gateLbl = (player and player:GetAttribute("NextWorldGateLabel")) or "WORLD 1 ➡ WORLD 2"
            refs.PortalCompassLabel.Text = "🌀 " .. tostring(gateLbl)
        end
    end
    if refs.CompassCard and viewState.settings then
        refs.CompassCard.Visible = viewState.settings.showMinimap ~= false
    end
    if refs.CompanionTitle and refs.CompanionSub then
        local lv = tonumber(snapshot.player and snapshot.player.level) or 1
        local pSize = (snapshot.party and snapshot.party.partySize) or (lv &lt; 15 and "Solo" or "Duo")
        local activeCount = (pSize == "Solo" and 0) or (pSize == "Duo" and (lv &gt;= 15 and 1 or 0)) or (pSize == "Trio" and (lv &gt;= 30 and 2 or (lv &gt;= 15 and 1 or 0))) or (lv &gt;= 50 and 3 or (lv &gt;= 30 and 2 or (lv &gt;= 15 and 1 or 0)))
        refs.CompanionTitle.Text = string.format("🛡 ĐỒNG HÀNH: %s (%d/3)", string.upper(pSize), activeCount)
        local kTag = lv &gt;= 15 and "✓Kairo" or "🔒Kairo(Lv15)"
        local lTag = lv &gt;= 30 and "✓Lumen" or "🔒Lumen(Lv30)"
        local nTag = lv &gt;= 50 and "✓Nyx" or "🔒Nyx(Lv50)"
        refs.CompanionSub.Text = kTag .. " • " .. lTag .. " • " .. nTag
        if refs.PartySizeApis then
            for psId, psApi in pairs(refs.PartySizeApis) do
                if psApi and psApi.SetVariant then
                    psApi:SetVariant(psId == pSize and "gold" or "secondary")
                end
            end
        end
    end
    if refs.BossBarApi then
        refs.BossBarApi:Update(snapshot.raid or { active = false })
    end
    if refs.InteractBtn and refs.InteractApi then
        local prompt = viewState.interactPrompt
        refs.InteractBtn.Visible = prompt ~= nil
        if prompt then
            refs.InteractApi:Update({ label = "[E] • " .. tostring(prompt) })
        end
    end

    -- Cooldowns &amp; Level Locks
    local elapsed = math.max(0, os.clock() - (Store.LastServerSyncClock or os.clock()))
    if refs.SkillSlotApis then
        for _, slot in pairs(refs.SkillSlotApis) do
            local cfg = slot.Config
            local locked = snapshot.player.level &lt; (cfg.LevelReq or 1)
            local rawCd = snapshot.cooldowns and (snapshot.cooldowns[cfg.Id] or 0) or 0
            local remainingCd = math.max(0, rawCd - elapsed)
            slot.Api:Update({
                locked = locked,
                lockLabel = locked and ("Lv." .. tostring(cfg.LevelReq)) or nil,
                cooldown = remainingCd,
                maxCooldown = cfg.Cooldown or 6,
                outOfEnergy = (cfg.StaminaCost and snapshot.vitals.stamina &lt; cfg.StaminaCost) or false,
            })
        end
    end
    if refs.DashApi and snapshot.cooldowns then
        local dashCd = math.max(0, (snapshot.cooldowns.Dash or 0) - elapsed)
        refs.DashApi:Update({
            label = dashCd &gt; 0 and string.format("DASH %.1fs", dashCd) or "DASH • SHIFT",
        })
    end
end

function HUD.Cleanup()
    HUDController.Cleanup()
    HUD.Refs = {}
end

return HUD
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXF7F063BB80344E29A9F9C652F746B3B8"><Properties><string name="Name">Inventory</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Inventory &amp; 8-Slot Equipment Screen (Phase 3)
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Screens/Inventory.lua
-- Structure: Left 25% Player Stats, Center 35% 3D ViewportFrame + 8 Equipment Slots, Right 40% Filter/Search/ScrollingGrid/Tooltip.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))
local RarityConfig = require(Shared:WaitForChild("Config"):WaitForChild("RarityConfig"))
local WorldConfig = require(Shared:WaitForChild("Config"):WaitForChild("WorldConfig"))
local UIState = require(Shared:WaitForChild("Types"):WaitForChild("UIState"))

local UIFactory = require(script.Parent.Parent:WaitForChild("UIFactory"))
local Store = require(script.Parent.Parent:WaitForChild("Store"))
local ScreenRouter = require(script.Parent.Parent:WaitForChild("ScreenRouter"))
local PremiumPanel = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("PremiumPanel"))
local PremiumButton = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("PremiumButton"))
local ItemSlot = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("ItemSlot"))
local Tooltip = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("Tooltip"))
local InventoryController = require(script.Parent.Parent:WaitForChild("Controllers"):WaitForChild("InventoryController"))

local Inventory = {
    Refs = {},
}

local function buildSubScreenHeader(parent, activeScreenId, titleText)
    local colors = Theme.Colors
    local snap = Store.GetSnapshot()

    local header = PremiumPanel.Create(parent, {
        name = "TopHeader",
        position = UDim2.fromOffset(20, 14),
        size = UDim2.new(1, -40, 0, 58),
    })

    UIFactory.Label(header, {
        Name = "Brand",
        Text = "SKY&lt;font color='#F0F4FA'&gt;BREAK&lt;/font&gt;  •  " .. titleText,
        Position = UDim2.fromOffset(18, 0),
        Size = UDim2.fromOffset(310, 58),
        TextSize = 19,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
        RichText = true,
    })

    local tabsHolder = UIFactory.Create("Frame", header, {
        Name = "NavTabs",
        Position = UDim2.fromOffset(332, 9),
        Size = UDim2.new(1, -620, 0, 40),
        BackgroundTransparency = 1,
    })
    UIFactory.ListLayout(tabsHolder, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)

    local tabs = {
        { id = UIState.Screens.Inventory, label = "INVENTORY" },
        { id = UIState.Screens.Skills, label = "SKILLS" },
        { id = UIState.Screens.WorldMap, label = "WORLD MAP" },
        { id = UIState.Screens.QuestJournal, label = "QUESTS" },
        { id = UIState.Screens.Forge, label = "FORGE" },
        { id = UIState.Screens.Raid, label = "RAID" },
        { id = UIState.Screens.Settings, label = "SETTINGS" },
    }
    for idx, tab in ipairs(tabs) do
        PremiumButton.Create(tabsHolder, {
            name = tab.id .. "Tab",
            label = tab.label,
            variant = activeScreenId == tab.id and "primary" or "secondary",
            selected = activeScreenId == tab.id,
            size = UDim2.fromOffset(92, 36),
            textSize = 11,
            layoutOrder = idx,
            onActivated = function()
                ScreenRouter.Navigate(tab.id)
            end,
        })
    end

    UIFactory.Label(header, {
        Name = "CurrencySummary",
        Text = string.format("GOLD %s  •  SHARDS %s", UIFactory.FormatNumber(snap.currency.gold), UIFactory.FormatNumber(snap.currency.coreShards)),
        Position = UDim2.new(1, -280, 0, 0),
        Size = UDim2.fromOffset(220, 58),
        TextSize = 12,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
        XAlign = Enum.TextXAlignment.Right,
    })

    PremiumButton.Create(header, {
        name = "CloseButton",
        label = "×",
        variant = "secondary",
        position = UDim2.new(1, -50, 0, 10),
        size = UDim2.fromOffset(38, 38),
        textSize = 20,
        onActivated = function()
            ScreenRouter.Navigate(UIState.Screens.HUD)
        end,
    })

    return header
end

function Inventory.Build(parent, responsiveState)
    Inventory.Cleanup()
    local colors = Theme.Colors
    local snap = Store.GetSnapshot()
    local view = Store.GetView()

    local root = UIFactory.Create("Frame", parent, {
        Name = "InventoryScreen",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ZIndex = 2,
    })

    buildSubScreenHeader(root, UIState.Screens.Inventory, "INVENTORY &amp; EQUIPMENT")

    -- Column 1 (Left 25%): Player Combat Stats &amp; Attributes
    local leftPanel = PremiumPanel.Create(root, {
        name = "PlayerStats",
        title = "CHARACTER ATTRIBUTES",
        subtitle = "Server-calculated class &amp; gear stats",
        position = UDim2.fromOffset(20, 84),
        size = UDim2.new(0.24, -16, 1, -102),
    })

    local classCfg = WorldConfig.Classes[snap.player.classId] or WorldConfig.Classes.SkyGuardian
    local statsLabel = UIFactory.Label(leftPanel, {
        Name = "StatsBody",
        Text = "",
        Position = UDim2.fromOffset(16, 70),
        Size = UDim2.new(1, -32, 1, -140),
        TextSize = 14,
        TextColor = colors.TEXT_PRIMARY,
        YAlign = Enum.TextYAlignment.Top,
        RichText = true,
    })

    PremiumButton.Create(leftPanel, {
        name = "OpenForgeShortcut",
        label = "⚒  KAEL'S FORGE",
        variant = "gold",
        position = UDim2.new(0, 16, 1, -56),
        size = UDim2.new(1, -32, 0, 40),
        textSize = 13,
        onActivated = function()
            ScreenRouter.Navigate(UIState.Screens.Forge)
        end,
    })

    -- Column 2 (Center 34%): 3D ViewportFrame Avatar Preview + 8 Equipment Slots
    local centerPanel = PremiumPanel.Create(root, {
        name = "EquipmentPreview",
        title = "3D AVATAR &amp; 8 EQUIPMENT SLOTS",
        subtitle = classCfg.Name .. "  •  " .. (snap.player.gender or "Male"),
        position = UDim2.new(0.24, 12, 0, 84),
        size = UDim2.new(0.35, -16, 1, -102),
    })

    local viewport = UIFactory.Create("ViewportFrame", centerPanel, {
        Name = "CharacterPreview",
        Position = UDim2.new(0.5, -110, 0, 72),
        Size = UDim2.fromOffset(220, 340),
        BackgroundColor3 = colors.BG_900,
        BackgroundTransparency = 0.15,
        BorderSizePixel = 0,
        Ambient = Color3.fromRGB(185, 200, 224),
        LightColor = Color3.fromRGB(255, 236, 198),
        LightDirection = Vector3.new(-1, -1, -1),
    })
    UIFactory.Corner(viewport, Theme.Radius.Large)
    UIFactory.Stroke(viewport, colors.STROKE_STEEL, 1.2, 0.35)
    InventoryController.MountViewportPreview(viewport, viewport)

    -- Rotate Left / Right buttons for 3D Preview
    PremiumButton.Create(centerPanel, {
        name = "RotateLeft",
        label = "◄ ROTATE",
        variant = "secondary",
        position = UDim2.new(0.5, -110, 0, 420),
        size = UDim2.fromOffset(104, 34),
        textSize = 12,
        onActivated = function()
            InventoryController.UpdateCameraRotation(-math.rad(30))
        end,
    })
    PremiumButton.Create(centerPanel, {
        name = "RotateRight",
        label = "ROTATE ►",
        variant = "secondary",
        position = UDim2.new(0.5, 6, 0, 420),
        size = UDim2.fromOffset(104, 34),
        textSize = 12,
        onActivated = function()
            InventoryController.UpdateCameraRotation(math.rad(30))
        end,
    })

    -- 8 Canonical Equipment Slots (4 on left side of Viewport, 4 on right side)
    local equipSlotContainer = UIFactory.Create("Frame", centerPanel, {
        Name = "EquipmentSlots",
        Position = UDim2.fromOffset(12, 72),
        Size = UDim2.new(1, -24, 0, 384),
        BackgroundTransparency = 1,
    })

    -- Column 3 (Right 41%): Search, Filter Tabs, Scrolling Item Grid &amp; Tooltip Detail
    local rightPanel = PremiumPanel.Create(root, {
        name = "InventoryGrid",
        title = "CELESTIAL STORAGE",
        position = UDim2.new(0.59, 4, 0, 84),
        size = UDim2.new(0.41, -24, 0.62, -54),
    })

    local filterHolder = UIFactory.Create("Frame", rightPanel, {
        Name = "FilterTabs",
        Position = UDim2.fromOffset(14, 48),
        Size = UDim2.new(1, -28, 0, 32),
        BackgroundTransparency = 1,
    })
    UIFactory.ListLayout(filterHolder, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)

    local filters = { "All", "Weapons", "Armor", "Materials", "Quest" }
    for idx, fName in ipairs(filters) do
        PremiumButton.Create(filterHolder, {
            name = "Filter_" .. fName,
            label = string.upper(fName),
            variant = (view.inventoryFilter == fName) and "primary" or "secondary",
            selected = (view.inventoryFilter == fName),
            size = UDim2.fromOffset(86, 30),
            textSize = 11,
            layoutOrder = idx,
            onActivated = function()
                Store.SetView({ inventoryFilter = fName })
                Inventory.RefreshGrid()
            end,
        })
    end

    local searchBox = UIFactory.Create("TextBox", rightPanel, {
        Name = "Search",
        Position = UDim2.fromOffset(14, 86),
        Size = UDim2.new(0.68, -18, 0, 32),
        Text = view.searchQuery or "",
        PlaceholderText = "Search items by name or rarity...",
        Font = Theme.Fonts.Regular,
        TextSize = 13,
        TextColor3 = colors.TEXT_PRIMARY,
        PlaceholderColor3 = colors.TEXT_SECONDARY,
        BackgroundColor3 = colors.BG_900,
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    UIFactory.Corner(searchBox, Theme.Radius.Small)
    UIFactory.Stroke(searchBox, colors.STROKE_STEEL, 1, 0.35)
    UIFactory.Padding(searchBox, 0, 10, 0, 10)

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        Store.SetView({ searchQuery = searchBox.Text })
        Inventory.RefreshGrid()
    end)

    -- Sort Selector Button
    local sortModes = { "Rarity", "Level", "Name" }
    local _, sortBtnApi = PremiumButton.Create(rightPanel, {
        name = "SortButton",
        label = "SORT: " .. string.upper(view.inventorySort or "Rarity"),
        variant = "secondary",
        position = UDim2.new(0.68, 4, 0, 86),
        size = UDim2.new(0.32, -18, 0, 32),
        textSize = 11,
        onActivated = function()
            local cur = Store.GetView().inventorySort or "Rarity"
            local nextMode = "Rarity"
            for i, m in ipairs(sortModes) do
                if m == cur then
                    nextMode = sortModes[(i % #sortModes) + 1]
                    break
                end
            end
            Store.SetView({ inventorySort = nextMode })
            Inventory.RefreshGrid()
        end,
    })

    local gridScroll = UIFactory.Create("ScrollingFrame", rightPanel, {
        Name = "Slots",
        Position = UDim2.fromOffset(14, 126),
        Size = UDim2.new(1, -28, 1, -138),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 5,
        ScrollBarImageColor3 = colors.ACCENT_SAPPHIRE,
        CanvasSize = UDim2.fromOffset(0, 0),
    })

    -- Bottom-Right Item Tooltip &amp; Compare Card
    local _, tooltipApi = Tooltip.Create(root, {
        name = "ItemTooltip",
        position = UDim2.new(0.59, 4, 0.62, 38),
        size = UDim2.new(0.41, -24, 0.38, -56),
        onEquipToggle = function(itemId, isEq)
            InventoryController.RequestEquipToggle(itemId, isEq)
        end,
        onCompareToggle = function()
            local v = Store.GetView()
            Store.SetView({ compareMode = not v.compareMode })
            Inventory.RefreshTooltip()
        end,
    })

    Inventory.Refs = {
        Root = root,
        StatsLabel = statsLabel,
        EquipSlotContainer = equipSlotContainer,
        GridScroll = gridScroll,
        SortBtnApi = sortBtnApi,
        TooltipApi = tooltipApi,
    }

    Inventory.RefreshAll()
    return root
end

function Inventory.RefreshStats()
    local refs = Inventory.Refs
    if not refs.StatsLabel then
        return
    end
    local snap = Store.GetSnapshot()
    local classCfg = WorldConfig.Classes[snap.player.classId] or WorldConfig.Classes.SkyGuardian
    local lvl = snap.player.level or 1
    local mult = classCfg.BaseMultipliers or { HP = 1, ATK = 1, DEF = 1, Speed = 18 }

    local totalHP = math.floor((120 + 18 * (lvl - 1)) * mult.HP)
    local totalATK = math.floor((12 + 2 * (lvl - 1)) * mult.ATK)
    local totalDEF = math.floor((4 + lvl - 1) * mult.DEF)
    local totalCRIT = 5

    for _, itemId in pairs(snap.equipped or {}) do
        local cfg = RarityConfig.GetItem(itemId)
        if cfg and cfg.Stats then
            totalHP += (cfg.Stats.HP or 0)
            totalATK += (cfg.Stats.ATK or 0)
            totalDEF += (cfg.Stats.DEF or 0)
            totalCRIT += (cfg.Stats.CRIT or 0)
        end
    end
    if not snap.isDemoMode then
        totalHP = snap.vitals.maxHp or totalHP
        totalATK = snap.player.atk or totalATK
        totalDEF = snap.player.def or totalDEF
        totalCRIT = snap.player.critRate or totalCRIT
    end

    refs.StatsLabel.Text = string.format(
        "&lt;font color='#E4B863'&gt;&lt;b&gt;%s  •  Lv. %d&lt;/b&gt;&lt;/font&gt;\n%s\n\n"
            .. "&lt;b&gt;MAX HP&lt;/b&gt;         %s\n"
            .. "&lt;b&gt;ATTACK&lt;/b&gt;         %s\n"
            .. "&lt;b&gt;DEFENSE&lt;/b&gt;        %s\n"
            .. "&lt;b&gt;CRIT RATE&lt;/b&gt;      %d%%\n"
            .. "&lt;b&gt;MOVE SPEED&lt;/b&gt;     %d\n"
            .. "&lt;b&gt;MAX ENERGY&lt;/b&gt;     %d\n\n"
            .. "&lt;font color='#A8B9D1'&gt;&lt;b&gt;CURRENCIES&lt;/b&gt;&lt;/font&gt;\n"
            .. "Gold: &lt;b&gt;%s&lt;/b&gt;\nCore Shards: &lt;b&gt;%s&lt;/b&gt;\nVoid Essence: &lt;b&gt;%s&lt;/b&gt;",
        string.upper(classCfg.Name),
        lvl,
        classCfg.Role,
        UIFactory.FormatNumber(totalHP),
        UIFactory.FormatNumber(totalATK),
        UIFactory.FormatNumber(totalDEF),
        totalCRIT,
        mult.Speed or 18,
        snap.vitals.maxEnergy or 100,
        UIFactory.FormatNumber(snap.currency.gold),
        UIFactory.FormatNumber(snap.currency.coreShards),
        UIFactory.FormatNumber(snap.currency.voidEssence)
    )
end

function Inventory.RefreshEquipmentSlots()
    local refs = Inventory.Refs
    local holder = refs.EquipSlotContainer
    if not holder then
        return
    end
    for _, child in ipairs(holder:GetChildren()) do
        child:Destroy()
    end

    local snap = Store.GetSnapshot()
    local view = Store.GetView()

    for idx, slotDef in ipairs(RarityConfig.EquipmentSlots) do
        local isLeft = idx &lt;= 4
        local row = ((idx - 1) % 4)
        local pos = isLeft and UDim2.fromOffset(4, row * 94) or UDim2.new(1, -86, 0, row * 94)
        local equippedItemId = snap.equipped and snap.equipped[slotDef.Id] or nil

        ItemSlot.Create(holder, {
            name = "EquipSlot_" .. slotDef.Id,
            itemId = equippedItemId,
            slotLabel = slotDef.Name,
            equipped = equippedItemId ~= nil,
            selected = equippedItemId ~= nil and view.selectedItemId == equippedItemId,
            position = pos,
            size = UDim2.fromOffset(82, 82),
            onSelect = function(clickedId)
                if clickedId then
                    Store.SetView({ selectedItemId = clickedId })
                    Inventory.RefreshAll()
                end
            end,
        })
    end
end

function Inventory.RefreshGrid()
    local refs = Inventory.Refs
    local scroll = refs.GridScroll
    if not scroll then
        return
    end
    for _, child in ipairs(scroll:GetChildren()) do
        if child:IsA("GuiObject") then
            child:Destroy()
        end
    end

    local view = Store.GetView()
    if refs.SortBtnApi then
        refs.SortBtnApi:Update({ label = "SORT: " .. string.upper(view.inventorySort or "Rarity") })
    end

    local items = InventoryController.GetFilteredInventory()
    local cols = 5
    local cell = 84
    local gap = 8
    local totalSlots = math.max(#items, cols * 3)

    for i = 1, totalSlots do
        local entry = items[i]
        local col = (i - 1) % cols
        local row = math.floor((i - 1) / cols)
        ItemSlot.Create(scroll, {
            name = "Slot" .. i,
            itemId = entry and entry.itemId or nil,
            count = entry and entry.count or 0,
            upgrade = entry and entry.upgrade or 0,
            equipped = entry and entry.equipped or false,
            selected = entry and (view.selectedItemId == entry.itemId) or false,
            position = UDim2.fromOffset(col * (cell + gap), row * (cell + gap)),
            size = UDim2.fromOffset(cell, cell),
            onSelect = function(clickedId)
                if clickedId then
                    Store.SetView({ selectedItemId = clickedId })
                    Inventory.RefreshGrid()
                    Inventory.RefreshTooltip()
                end
            end,
        })
    end

    local rows = math.ceil(totalSlots / cols)
    scroll.CanvasSize = UDim2.fromOffset(0, rows * (cell + gap) + 8)
    Inventory.RefreshTooltip()
end

function Inventory.RefreshTooltip()
    local refs = Inventory.Refs
    if not refs.TooltipApi then
        return
    end
    local snap = Store.GetSnapshot()
    local view = Store.GetView()
    local selectedId = view.selectedItemId

    local foundEntry = nil
    for _, entry in ipairs(snap.inventory or {}) do
        if entry.itemId == selectedId then
            foundEntry = entry
            break
        end
    end

    local cfg = selectedId and RarityConfig.GetItem(selectedId) or nil
    local compareItem = nil
    if view.compareMode and cfg and cfg.Slot and snap.equipped then
        local eqId = snap.equipped[cfg.Slot]
        if eqId and eqId ~= selectedId then
            compareItem = RarityConfig.GetItem(eqId)
        end
    end

    refs.TooltipApi:Update({
        itemId = selectedId,
        count = foundEntry and foundEntry.count or 0,
        upgrade = foundEntry and foundEntry.upgrade or 0,
        equipped = (cfg and cfg.Slot and snap.equipped and snap.equipped[cfg.Slot] == selectedId) or (foundEntry and foundEntry.equipped == true),
        compareMode = view.compareMode == true,
        compareItem = compareItem,
    })
end

function Inventory.RefreshAll()
    Inventory.RefreshStats()
    Inventory.RefreshEquipmentSlots()
    Inventory.RefreshGrid()
end

function Inventory.Update()
    if Inventory.Refs.Root then
        Inventory.RefreshAll()
    end
end

function Inventory.Cleanup()
    InventoryController.CleanupViewport()
    Inventory.Refs = {}
end

return Inventory
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6F6E40B92647413FB3ED11217D8D0965"><Properties><string name="Name">MainMenu</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Screen 1: Main Menu (Section 05, 07, 09, 11, 13)
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Screens/MainMenu.lua
-- Features:
--   * LogoGroup with LogoBase + LogoGlow ambient breathing loop (2.4s Sine InOut)
--   * CorePulse 4x4 Sprite Sheet animation (SpritePlayer.Play)
--   * Staggered CTA entrance (0.05s per button) + PlayButton UIScale/UIStroke micro-interactions
--   * Realm Select &amp; Live Character Class Selector

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))
local WorldConfig = require(Shared:WaitForChild("Config"):WaitForChild("WorldConfig"))
local UIState = require(Shared:WaitForChild("Types"):WaitForChild("UIState"))
local AssetManifest = require(Shared:WaitForChild("AssetManifest"))
local SpritePlayer = require(Shared:WaitForChild("SpritePlayer"))
local UIAnimator = require(Shared:WaitForChild("UIAnimator"))

local UIFactory = require(script.Parent.Parent:WaitForChild("UIFactory"))
local Store = require(script.Parent.Parent:WaitForChild("Store"))
local ScreenRouter = require(script.Parent.Parent:WaitForChild("ScreenRouter"))
local Animations = require(script.Parent.Parent:WaitForChild("Animations"))
local PremiumPanel = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("PremiumPanel"))
local PremiumButton = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("PremiumButton"))
local PartyController = require(script.Parent.Parent:WaitForChild("Controllers"):WaitForChild("PartyController"))

local MainMenu = {
    Refs = {},
}

function MainMenu.Build(parent, responsiveState)
    MainMenu.Cleanup()
    local colors = Theme.Colors
    local snap = Store.GetSnapshot()
    local isPortrait = responsiveState and responsiveState.IsPortrait

    local root = UIFactory.Create("Frame", parent, {
        Name = "MainMenu",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
    })

    -- Left Column: LogoGroup, Tagline, Save Status, Primary CTAs (Staggered Entrance)
    local leftCard = PremiumPanel.Create(root, {
        name = "HeroMenuCard",
        title = "CELESTIAL COMMAND",
        subtitle = "Fragments of the Core • Main Menu",
        position = UDim2.fromOffset(0, 0),
        size = isPortrait and UDim2.new(1, 0, 0.54, -8) or UDim2.new(0.45, -8, 1, 0),
    })

    -- LogoGroup (LogoBase + LogoGlow)
    local logoGroup = UIFactory.Create("Frame", leftCard, {
        Name = "LogoGroup",
        Position = UDim2.fromOffset(18, 56),
        Size = UDim2.new(1, -36, 0, 68),
        BackgroundTransparency = 1,
    })

    local logoGlow = UIFactory.Create("Frame", logoGroup, {
        Name = "LogoGlow",
        Position = UDim2.fromOffset(-4, -4),
        Size = UDim2.fromOffset(56, 56),
        BackgroundColor3 = colors.ACCENT_ICE or colors.ACCENT_SAPPHIRE,
        BackgroundTransparency = 0.65,
        BorderSizePixel = 0,
    })
    UIFactory.PillCorner(logoGlow)

    local logoBase = UIFactory.Create("Frame", logoGroup, {
        Name = "LogoBase",
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.fromOffset(48, 48),
        BackgroundColor3 = colors.BG_900,
        BorderSizePixel = 0,
    })
    UIFactory.PillCorner(logoBase)
    UIFactory.Stroke(logoBase, colors.ACCENT_GOLD, 2.0, 0.1)
    UIFactory.Icon(logoBase, "Star", UDim2.new(0.5, -18, 0.5, -18), 36, colors.ACCENT_GOLD)

    local titleBanner = UIFactory.Label(logoGroup, {
        Name = "TitleBanner",
        Text = "SKYBREAK",
        Position = UDim2.fromOffset(62, -2),
        Size = UDim2.new(1, -66, 0, 38),
        TextSize = 32,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
    })
    if Animations.PulseGlow then
        Animations.PulseGlow(titleBanner, "Menu", "TextTransparency", 0.0, 0.14)
        Animations.PulseGlow(logoGlow, "Menu", "BackgroundTransparency", 0.48, 0.82)
    end

    UIFactory.Label(logoGroup, {
        Name = "LoreQuote",
        Text = "“When the sky shattered, the world did not end — it learned how to float.”",
        Position = UDim2.fromOffset(62, 36),
        Size = UDim2.new(1, -66, 0, 28),
        TextSize = 12,
        TextColor = colors.ACCENT_ICE or colors.TEXT_SECONDARY,
    })

    local statusPill = UIFactory.Create("Frame", leftCard, {
        Name = "StatusBanner",
        Position = UDim2.fromOffset(18, 130),
        Size = UDim2.new(1, -36, 0, 52),
        BackgroundColor3 = colors.BG_900,
        BorderSizePixel = 0,
    })
    UIFactory.Corner(statusPill, Theme.Radius.Medium)
    UIFactory.Stroke(statusPill, colors.ACCENT_SAPPHIRE, 1, 0.35)

    local statusLabel = UIFactory.Label(statusPill, {
        Name = "StatusText",
        Text = string.format(
            "STATUS: %s\nSkyborn Lv.%d  •  Class: %s  •  Gold: %s",
            snap.saveStatus or "Connected",
            snap.player.level or 1,
            snap.player.classId or "SkyGuardian",
            UIFactory.FormatNumber(snap.currency and snap.currency.gold or 0)
        ),
        Position = UDim2.fromOffset(12, 4),
        Size = UDim2.new(1, -24, 1, -8),
        TextSize = 12,
        TextColor = colors.TEXT_SECONDARY,
    })

    -- ButtonColumn (PlayButton, ContinueButton, RealmSelect, SettingsButton)
    local buttonColumn = UIFactory.Create("Frame", leftCard, {
        Name = "ButtonColumn",
        Position = UDim2.fromOffset(18, 190),
        Size = UDim2.new(1, -36, 0, 148),
        BackgroundTransparency = 1,
    })

    local playBtn = PremiumButton.Create(buttonColumn, {
        name = "PlayButton",
        label = "▶  PLAY / CONTINUE SKY REALM [ESC]",
        variant = "gold",
        position = UDim2.fromOffset(0, 0),
        size = UDim2.new(1, 0, 0, 46),
        textSize = 15,
        scope = "Menu",
        onActivated = function()
            ScreenRouter.Navigate(UIState.Screens.HUD, { replace = true })
        end,
    })

    local mapBtn = PremiumButton.Create(buttonColumn, {
        name = "RealmSelectButton",
        label = "REALM SELECT (WORLD MAP)",
        variant = "primary",
        position = UDim2.fromOffset(0, 54),
        size = UDim2.new(0.5, -6, 0, 40),
        textSize = 12,
        scope = "Menu",
        onActivated = function()
            ScreenRouter.Navigate(UIState.Screens.WorldMap)
        end,
    })

    local raidBtn = PremiumButton.Create(buttonColumn, {
        name = "RaidLobbyButton",
        label = "CELESTIAL RAID LOBBY",
        variant = "primary",
        position = UDim2.new(0.5, 6, 0, 54),
        size = UDim2.new(0.5, -6, 0, 40),
        textSize = 12,
        scope = "Menu",
        onActivated = function()
            ScreenRouter.Navigate(UIState.Screens.Raid)
        end,
    })

    local settingsBtn = PremiumButton.Create(buttonColumn, {
        name = "SettingsButton",
        label = "⚙  SETTINGS &amp; ACCESSIBILITY",
        variant = "secondary",
        position = UDim2.fromOffset(0, 102),
        size = UDim2.new(0.58, -6, 0, 38),
        textSize = 12,
        scope = "Menu",
        onActivated = function()
            ScreenRouter.Navigate(UIState.Screens.Settings)
        end,
    })

    local invBtn = PremiumButton.Create(buttonColumn, {
        name = "InventoryButton",
        label = "🎒 INVENTORY &amp; FORGE",
        variant = "secondary",
        position = UDim2.new(0.58, 6, 0, 102),
        size = UDim2.new(0.42, -6, 0, 38),
        textSize = 12,
        scope = "Menu",
        onActivated = function()
            ScreenRouter.Navigate(UIState.Screens.Inventory)
        end,
    })

    -- Section 11: Staggered CTA entrance (0.05s per button)
    local ctaButtons = { playBtn, mapBtn, raidBtn, settingsBtn, invBtn }
    for idx, btnInstance in ipairs(ctaButtons) do
        local sc = btnInstance and btnInstance:FindFirstChildOfClass("UIScale")
        if sc and not UIAnimator.ReducedMotion then
            sc.Scale = 0.90
            task.delay((idx - 1) * 0.05, function()
                if sc and sc.Parent then
                    UIAnimator.Tween(sc, { Scale = 1.0 }, 0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                end
            end)
        end
    end

    -- Class Archetype Selector
    UIFactory.Label(leftCard, {
        Name = "ClassHeader",
        Text = "CHOOSE COMBAT ARCHETYPE",
        Position = UDim2.fromOffset(18, 344),
        Size = UDim2.new(1, -36, 0, 20),
        TextSize = 12,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
    })

    local classRow = UIFactory.Create("Frame", leftCard, {
        Name = "ClassSelectorRow",
        Position = UDim2.fromOffset(18, 368),
        Size = UDim2.new(1, -36, 0, 42),
        BackgroundTransparency = 1,
    })
    UIFactory.ListLayout(classRow, Enum.FillDirection.Horizontal, 8)

    local classBtns = {}
    local classList = WorldConfig.OrderedClasses or { "SkyGuardian", "ThunderStriker", "ArcaneMage" }
    for idx, classId in ipairs(classList) do
        local cfg = WorldConfig.Classes[classId]
        if cfg then
            local _, api = PremiumButton.Create(classRow, {
                name = "Select_" .. classId,
                label = cfg.Name,
                variant = snap.player.classId == classId and "primary" or "secondary",
                selected = snap.player.classId == classId,
                size = UDim2.new(0.333, -6, 1, 0),
                textSize = 12,
                layoutOrder = idx,
                scope = "Menu",
                onActivated = function()
                    PartyController.RequestClassOrGenderChange(classId, snap.player.gender or "Male")
                end,
            })
            classBtns[classId] = api
        end
    end

    -- Right Column: CorePulse 4x4 Sprite Sheet Hero FX + Realm Gateway Cards
    local rightCard = PremiumPanel.Create(root, {
        name = "RealmGatewayCard",
        title = "FLOATING ARCHIPELAGO • CORE PULSE &amp; REALMS",
        subtitle = "Live 4x4 Sprite Sheet Core Pulse &amp; Fast Travel Gateways",
        position = isPortrait and UDim2.new(0, 0, 0.54, 8) or UDim2.new(0.45, 8, 0, 0),
        size = isPortrait and UDim2.new(1, 0, 0.46, -8) or UDim2.new(0.55, -8, 1, 0),
    })

    -- Section 09 &amp; Section 13: CorePulse 4x4 Sprite Sheet FX badge in top-right of RealmGatewayCard
    local corePulseBadge = UIFactory.Create("Frame", rightCard, {
        Name = "CorePulseContainer",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -18, 0, 8),
        Size = UDim2.fromOffset(48, 48),
        BackgroundTransparency = 1,
        ZIndex = 6,
    })

    local corePulseImage = UIFactory.Create("ImageLabel", corePulseBadge, {
        Name = "CorePulse",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(46, 46),
        BackgroundTransparency = 1,
        ZIndex = 7,
    })
    SpritePlayer.Play(corePulseImage, AssetManifest.CorePulseAtlas, 4, 4, 256, 256, 12, 16)

    local realmList = UIFactory.Create("ScrollingFrame", rightCard, {
        Name = "RealmList",
        Position = UDim2.fromOffset(16, 62),
        Size = UDim2.new(1, -32, 1, -78),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 5,
        ScrollBarImageColor3 = colors.ACCENT_SAPPHIRE,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.fromOffset(0, 0),
    })
    UIFactory.ListLayout(realmList, Enum.FillDirection.Vertical, 10)

    for idx, realm in ipairs(WorldConfig.Realms or {}) do
        local isCurrent = (snap.world and snap.world.current == realm.Id)
        local isUnlocked = (snap.world and snap.world.unlocked and snap.world.unlocked[realm.Id] == true) or realm.FastTravelUnlockedByDefault == true

        local card = UIFactory.Create("Frame", realmList, {
            Name = "Realm_" .. realm.Id,
            Size = UDim2.new(1, -6, 0, 102),
            BackgroundColor3 = colors.BG_900,
            BackgroundTransparency = 0.08,
            BorderSizePixel = 0,
            LayoutOrder = idx,
        })
        UIFactory.Corner(card, Theme.Radius.Medium)
        UIFactory.Stroke(card, isCurrent and colors.ACCENT_GOLD or (realm.AccentColor or colors.ACCENT_SAPPHIRE), isCurrent and 1.8 or 1.2, 0.2)

        UIFactory.Icon(card, "Map", UDim2.fromOffset(14, 16), 34, realm.AccentColor or colors.ACCENT_SAPPHIRE)

        UIFactory.Label(card, {
            Name = "Name",
            Text = string.format("%s  •  %s", string.upper(realm.Name or realm.Id), tostring(realm.LevelRange or "Lv. 1+")),
            Position = UDim2.fromOffset(60, 10),
            Size = UDim2.new(1, -190, 0, 22),
            TextSize = 15,
            TextColor = colors.TEXT_PRIMARY,
            Bold = true,
        })

        UIFactory.Label(card, {
            Name = "Sub",
            Text = tostring(realm.Chapter or realm.VietnameseName or "") .. " — " .. tostring(realm.Description or ""),
            Position = UDim2.fromOffset(60, 34),
            Size = UDim2.new(1, -190, 0, 56),
            TextSize = 12,
            TextColor = colors.TEXT_SECONDARY,
            YAlign = Enum.TextYAlignment.Top,
        })

        PremiumButton.Create(card, {
            name = "Enter_" .. realm.Id,
            label = isCurrent and "ACTIVE REALM" or (isUnlocked and "TRAVEL" or "LOCKED"),
            variant = isCurrent and "gold" or (isUnlocked and "primary" or "secondary"),
            disabled = not isUnlocked,
            position = UDim2.new(1, -122, 0.5, -19),
            size = UDim2.fromOffset(108, 38),
            textSize = 12,
            scope = "Menu",
            onActivated = function()
                Store.SetView({ selectedRealmId = realm.Id })
                ScreenRouter.Navigate(UIState.Screens.WorldMap)
            end,
        })
    end

    MainMenu.Refs = {
        Root = root,
        StatusLabel = statusLabel,
        ClassBtns = classBtns,
        CorePulseImage = corePulseImage,
    }

    return root
end

function MainMenu.Update(snapshot)
    local refs = MainMenu.Refs
    if not refs.Root or not snapshot then
        return
    end
    if refs.StatusLabel then
        refs.StatusLabel.Text = string.format(
            "STATUS: %s\nSkyborn Lv.%d  •  Class: %s  •  Gold: %s",
            snapshot.saveStatus or "Connected",
            snapshot.player.level or 1,
            snapshot.player.classId or "SkyGuardian",
            UIFactory.FormatNumber(snapshot.currency and snapshot.currency.gold or 0)
        )
    end
    if refs.ClassBtns then
        for classId, api in pairs(refs.ClassBtns) do
            api:SetSelected(snapshot.player.classId == classId)
        end
    end
end

function MainMenu.Cleanup()
    if MainMenu.Refs and MainMenu.Refs.CorePulseImage then
        SpritePlayer.Stop(MainMenu.Refs.CorePulseImage)
    end
    Animations.CleanupScope("Menu")
    MainMenu.Refs = {}
end

return MainMenu
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX1A2E8285E7A2416EBE47041EA44DB97F"><Properties><string name="Name">QuestJournal</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Quest Journal Screen (Phase 4)
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Screens/QuestJournal.lua
-- Categories: Main / Side / Daily / Boss Hunt. Synchronizes directly with HUD QuestTracker.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))
local WorldConfig = require(Shared:WaitForChild("Config"):WaitForChild("WorldConfig"))
local UIState = require(Shared:WaitForChild("Types"):WaitForChild("UIState"))

local UIFactory = require(script.Parent.Parent:WaitForChild("UIFactory"))
local Store = require(script.Parent.Parent:WaitForChild("Store"))
local ScreenRouter = require(script.Parent.Parent:WaitForChild("ScreenRouter"))
local PremiumPanel = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("PremiumPanel"))
local PremiumButton = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("PremiumButton"))
local QuestController = require(script.Parent.Parent:WaitForChild("Controllers"):WaitForChild("QuestController"))

local QuestJournal = {
    Refs = {},
}

function QuestJournal.Build(parent)
    QuestJournal.Cleanup()
    local colors = Theme.Colors
    local snap = Store.GetSnapshot()
    local view = Store.GetView()
    local activeCat = view.selectedQuestCategory or "Main"
    local selectedId = view.selectedQuestId or (snap.quest and snap.quest.activeId) or "Q01"

    local root = UIFactory.Create("Frame", parent, {
        Name = "QuestJournalScreen",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ZIndex = 2,
    })

    -- Header
    local header = PremiumPanel.Create(root, {
        name = "TopHeader",
        position = UDim2.fromOffset(20, 14),
        size = UDim2.new(1, -40, 0, 58),
    })
    UIFactory.Label(header, {
        Name = "Brand",
        Text = "SKY&lt;font color='#F0F4FA'&gt;BREAK&lt;/font&gt;  •  QUEST JOURNAL &amp; CHRONICLES",
        Position = UDim2.fromOffset(18, 0),
        Size = UDim2.fromOffset(520, 58),
        TextSize = 19,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
        RichText = true,
    })
    PremiumButton.Create(header, {
        name = "CloseButton",
        label = "BACK TO HUD [J]",
        variant = "secondary",
        position = UDim2.new(1, -172, 0, 10),
        size = UDim2.fromOffset(156, 38),
        textSize = 12,
        onActivated = function()
            ScreenRouter.Navigate(UIState.Screens.HUD)
        end,
    })

    -- Left Quest List Panel (42% width)
    local listPanel = PremiumPanel.Create(root, {
        name = "QuestListPanel",
        title = "QUEST ARCHIVE",
        position = UDim2.fromOffset(20, 84),
        size = UDim2.new(0.42, -16, 1, -102),
    })

    local catTabs = UIFactory.Create("Frame", listPanel, {
        Name = "CategoryTabs",
        Position = UDim2.fromOffset(14, 48),
        Size = UDim2.new(1, -28, 0, 34),
        BackgroundTransparency = 1,
    })
    UIFactory.ListLayout(catTabs, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)

    local categories = {
        { id = "Main", label = "MAIN STORY" },
        { id = "Side", label = "SIDE" },
        { id = "Daily", label = "DAILY" },
        { id = "BossHunt", label = "BOSS HUNTS" },
    }
    for idx, cat in ipairs(categories) do
        PremiumButton.Create(catTabs, {
            name = "Cat_" .. cat.id,
            label = cat.label,
            variant = (activeCat == cat.id) and "primary" or "secondary",
            selected = (activeCat == cat.id),
            size = UDim2.fromOffset(118, 32),
            textSize = 11,
            layoutOrder = idx,
            onActivated = function()
                local filtered = QuestController.GetQuestsByCategory(cat.id)
                local firstId = filtered[1] and filtered[1].config.Id or selectedId
                Store.SetView({
                    selectedQuestCategory = cat.id,
                    selectedQuestId = firstId,
                })
                ScreenRouter.Navigate(UIState.Screens.QuestJournal, { forceRebuild = true, replace = true })
            end,
        })
    end

    local questScroll = UIFactory.Create("ScrollingFrame", listPanel, {
        Name = "QuestScroll",
        Position = UDim2.fromOffset(14, 92),
        Size = UDim2.new(1, -28, 1, -106),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 5,
        ScrollBarImageColor3 = colors.ACCENT_SAPPHIRE,
    })
    UIFactory.ListLayout(questScroll, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top)

    local questsInCat = QuestController.GetQuestsByCategory(activeCat)
    local selectedQuestEntry = questsInCat[1]

    for idx, entry in ipairs(questsInCat) do
        local q = entry.config
        if q.Id == selectedId then
            selectedQuestEntry = entry
        end
        local isSelected = (q.Id == selectedId)
        local badgeText = entry.isTracked and "TRACKING" or string.upper(entry.status)

        local btn, _ = PremiumButton.Create(questScroll, {
            name = "QuestItem_" .. q.Id,
            label = string.format("%s  •  %s  [%s]", q.Id, q.Name, badgeText),
            variant = isSelected and "primary" or "secondary",
            selected = isSelected,
            size = UDim2.new(1, -8, 0, 52),
            textSize = 13,
            layoutOrder = idx,
            onActivated = function()
                Store.SetView({ selectedQuestId = q.Id })
                ScreenRouter.Navigate(UIState.Screens.QuestJournal, { forceRebuild = true, replace = true })
            end,
        })
        btn.LayoutOrder = idx
    end
    questScroll.CanvasSize = UDim2.fromOffset(0, #questsInCat * 60 + 12)

    -- Right Quest Inspector Panel (58% width)
    local detailPanel = PremiumPanel.Create(root, {
        name = "QuestJournal",
        variant = "gold",
        title = selectedQuestEntry and (selectedQuestEntry.config.Id .. " • " .. string.upper(selectedQuestEntry.config.Name)) or "SELECT A QUEST",
        subtitle = selectedQuestEntry and string.format("Realm: %s  •  Recommended Level: %d", selectedQuestEntry.config.RealmId, selectedQuestEntry.config.LevelReq or 1) or "",
        position = UDim2.new(0.42, 16, 0, 84),
        size = UDim2.new(0.58, -36, 1, -102),
    })

    if selectedQuestEntry then
        local q = selectedQuestEntry.config
        local objLines = {}
        local isLiveActive = (snap.quest and snap.quest.activeId == q.Id)
        if isLiveActive and snap.quest.objectives then
            for _, o in ipairs(snap.quest.objectives) do
                local done = (o.current or 0) &gt;= (o.target or 1)
                table.insert(objLines, string.format("%s %s   &lt;b&gt;%d / %d&lt;/b&gt;", done and "✓" or "○", o.label, o.current or 0, o.target or 1))
            end
        else
            for _, o in ipairs(q.Objectives or {}) do
                table.insert(objLines, string.format("○ %s   &lt;b&gt;0 / %d&lt;/b&gt;", o.Label, o.Target or 1))
            end
        end

        local rewards = q.Rewards or {}
        local rewardParts = {}
        if (rewards.EXP or 0) &gt; 0 then
            table.insert(rewardParts, "+" .. UIFactory.FormatNumber(rewards.EXP) .. " EXP")
        end
        if (rewards.Gold or 0) &gt; 0 then
            table.insert(rewardParts, "+" .. UIFactory.FormatNumber(rewards.Gold) .. " Gold")
        end
        if (rewards.CoreShards or 0) &gt; 0 then
            table.insert(rewardParts, "+" .. UIFactory.FormatNumber(rewards.CoreShards) .. " Core Shards")
        end
        for _, itemReward in ipairs(rewards.Items or {}) do
            table.insert(rewardParts, string.format("%s x%d", itemReward.Id, itemReward.Count or 1))
        end

        UIFactory.Label(detailPanel, {
            Name = "Content",
            Text = string.format(
                "%s\n\n&lt;font color='#E4B863'&gt;&lt;b&gt;OBJECTIVES&lt;/b&gt;&lt;/font&gt;\n%s\n\n&lt;font color='#40AAFF'&gt;&lt;b&gt;COMPLETION REWARDS (SERVER GRANTED)&lt;/b&gt;&lt;/font&gt;\n%s",
                q.Description or "",
                table.concat(objLines, "\n"),
                table.concat(rewardParts, "   •   ")
            ),
            Position = UDim2.fromOffset(18, 72),
            Size = UDim2.new(1, -36, 1, -152),
            TextSize = 15,
            TextColor = colors.TEXT_PRIMARY,
            YAlign = Enum.TextYAlignment.Top,
            RichText = true,
        })

        PremiumButton.Create(detailPanel, {
            name = "TrackQuestButton",
            label = selectedQuestEntry.isTracked and "✓  CURRENTLY TRACKED ON HUD" or "TRACK QUEST ON HUD",
            variant = selectedQuestEntry.isTracked and "gold" or "primary",
            position = UDim2.new(0, 18, 1, -64),
            size = UDim2.new(0.54, -24, 0, 44),
            textSize = 13,
            onActivated = function()
                QuestController.TrackQuest(q.Id)
                ScreenRouter.Navigate(UIState.Screens.QuestJournal, { forceRebuild = true, replace = true })
            end,
        })

        PremiumButton.Create(detailPanel, {
            name = "DialoguePreviewButton",
            label = "LORE DIALOGUE",
            variant = "secondary",
            position = UDim2.new(0.54, 6, 1, -64),
            size = UDim2.new(0.46, -24, 0, 44),
            textSize = 13,
            onActivated = function()
                QuestController.OpenDialogue(
                    "LYRA • SKY HUB",
                    q.Description,
                    "Lorekeeper of the Core • " .. q.Id,
                    q.Id
                )
            end,
        })
    end

    QuestJournal.Refs = { Root = root }
    return root
end

function QuestJournal.Update() end

function QuestJournal.Cleanup()
    QuestJournal.Refs = {}
end

return QuestJournal
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX672D9F46ACAA458AA02AAB85C21EE1A3"><Properties><string name="Name">Raid</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Boss &amp; Raid Encounter Screen (Phase 5)
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Screens/Raid.lua
-- Canonical Bosses: Aureon Sentinel (3 phases + 2 Pylons), Noxar (3 combat phases + Purification), Veyr (4 phases + 4 Anchors).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))
local WorldConfig = require(Shared:WaitForChild("Config"):WaitForChild("WorldConfig"))
local UIState = require(Shared:WaitForChild("Types"):WaitForChild("UIState"))

local UIFactory = require(script.Parent.Parent:WaitForChild("UIFactory"))
local Store = require(script.Parent.Parent:WaitForChild("Store"))
local ScreenRouter = require(script.Parent.Parent:WaitForChild("ScreenRouter"))
local PremiumPanel = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("PremiumPanel"))
local PremiumButton = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("PremiumButton"))
local RaidPhase = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("RaidPhase"))
local PartyController = require(script.Parent.Parent:WaitForChild("Controllers"):WaitForChild("PartyController"))

local Raid = {
    Refs = {},
}

function Raid.Build(parent)
    Raid.Cleanup()
    local colors = Theme.Colors
    local view = Store.GetView()
    local selectedRaidId = view.selectedRaidId or "Veyr"
    local raidCfg = WorldConfig.Raids[selectedRaidId] or WorldConfig.Raids.Veyr

    local root = UIFactory.Create("Frame", parent, {
        Name = "RaidScreen",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ZIndex = 2,
    })

    -- Top Header
    local header = PremiumPanel.Create(root, {
        name = "TopHeader",
        position = UDim2.fromOffset(20, 14),
        size = UDim2.new(1, -40, 0, 58),
    })
    UIFactory.Label(header, {
        Name = "Brand",
        Text = "SKY&lt;font color='#F0F4FA'&gt;BREAK&lt;/font&gt;  •  CO-OP RAID &amp; BOSS COMMAND",
        Position = UDim2.fromOffset(18, 0),
        Size = UDim2.fromOffset(520, 58),
        TextSize = 19,
        TextColor = colors.ACCENT_GOLD,
        Bold = true,
        RichText = true,
    })
    PremiumButton.Create(header, {
        name = "CloseButton",
        label = "BACK TO HUD [P]",
        variant = "secondary",
        position = UDim2.new(1, -172, 0, 10),
        size = UDim2.fromOffset(156, 38),
        textSize = 12,
        onActivated = function()
            ScreenRouter.Navigate(UIState.Screens.HUD)
        end,
    })

    -- Raid Selector Row (Aureon Sentinel / Noxar / Veyr)
    local selectorRow = UIFactory.Create("Frame", root, {
        Name = "RaidSelectorRow",
        Position = UDim2.fromOffset(20, 82),
        Size = UDim2.new(1, -40, 0, 48),
        BackgroundTransparency = 1,
    })
    UIFactory.ListLayout(selectorRow, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)

    for idx, rid in ipairs(WorldConfig.OrderedRaids) do
        local rCfg = WorldConfig.Raids[rid]
        local isSel = (rid == selectedRaidId)
        PremiumButton.Create(selectorRow, {
            name = "SelectRaid_" .. rid,
            label = string.format("%s  (Lv.%d • %d Phases%s)", rCfg.Name, rCfg.LevelReq, rCfg.MaxPhases, rCfg.HasPurification and " + Purification" or ""),
            variant = isSel and "gold" or "secondary",
            selected = isSel,
            size = UDim2.fromOffset(416, 44),
            textSize = 13,
            layoutOrder = idx,
            onActivated = function()
                Store.SetView({ selectedRaidId = rid })
                ScreenRouter.Navigate(UIState.Screens.Raid, { forceRebuild = true, replace = true })
            end,
        })
    end

    -- Live RaidPhase Component Preview Banner
    local _, raidPreviewApi = RaidPhase.Create(root, {
        name = "RaidHeaderPreview",
        anchorPoint = Vector2.new(0, 0),
        position = UDim2.fromOffset(20, 140),
        size = UDim2.new(1, -40, 0, 114),
        bossName = raidCfg.Name .. "  •  " .. string.upper(raidCfg.Title),
        bossHp = raidCfg.MaxHP,
        bossMaxHp = raidCfg.MaxHP,
        visible = true,
    })
    raidPreviewApi:Update({
        active = true,
        bossName = raidCfg.Name .. "  •  " .. string.upper(raidCfg.Title),
        phase = 1,
        maxPhases = raidCfg.MaxPhases,
        phaseTitle = raidCfg.Phases[1] and raidCfg.Phases[1].Name or "PHASE 1",
        bossHp = raidCfg.MaxHP,
        bossMaxHp = raidCfg.MaxHP,
        breakGauge = 35,
        warningText = raidCfg.HasPurification
            and "3 COMBAT PHASES + FINAL CORE PURIFICATION RITUAL"
            or "CO-OP RAID (1–6 PLAYERS) • NON-INTRUSIVE COMBAT TELEGRAPHS",
    })

    -- Left Column (54%): Phase Breakdown &amp; Mechanics
    local phasesPanel = PremiumPanel.Create(root, {
        name = "PhasesBreakdown",
        title = "PHASE MECHANICS &amp; TELEGRAPHS",
        subtitle = raidCfg.HasPurification and "3 Combat Phases followed by Core Purification Finisher" or (tostring(raidCfg.MaxPhases) .. " Escalating Ascension Phases"),
        position = UDim2.fromOffset(20, 266),
        size = UDim2.new(0.54, -16, 1, -284),
    })

    local phaseList = UIFactory.Create("Frame", phasesPanel, {
        Name = "PhaseCards",
        Position = UDim2.fromOffset(16, 66),
        Size = UDim2.new(1, -32, 1, -134),
        BackgroundTransparency = 1,
    })
    UIFactory.ListLayout(phaseList, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top)

    for idx, pInfo in ipairs(raidCfg.Phases) do
        local pCard = UIFactory.Create("Frame", phaseList, {
            Name = "Phase_" .. idx,
            Size = UDim2.new(1, 0, 0, 68),
            BackgroundColor3 = colors.BG_900,
            BorderSizePixel = 0,
            LayoutOrder = idx,
        })
        UIFactory.Corner(pCard, Theme.Radius.Small)
        UIFactory.Stroke(pCard, pInfo.Threshold == "FINISHER" and colors.VOID_PURPLE or colors.STROKE_STEEL, 1.2, 0.3)

        UIFactory.Label(pCard, {
            Name = "Title",
            Text = string.format("PHASE %d: %s  (%s)", pInfo.Phase, pInfo.Name, pInfo.Threshold),
            Position = UDim2.fromOffset(12, 6),
            Size = UDim2.new(1, -140, 0, 20),
            TextSize = 13,
            TextColor = pInfo.Threshold == "FINISHER" and colors.VOID_PURPLE or colors.ACCENT_GOLD,
            Bold = true,
        })

        UIFactory.Label(pCard, {
            Name = "Mechanic",
            Text = pInfo.Mechanic,
            Position = UDim2.fromOffset(12, 28),
            Size = UDim2.new(1, -140, 0, 34),
            TextSize = 12,
            TextColor = colors.TEXT_SECONDARY,
            YAlign = Enum.TextYAlignment.Top,
        })

        PremiumButton.Create(pCard, {
            name = "SimPhase_" .. idx,
            label = "PREVIEW P" .. idx,
            variant = "secondary",
            position = UDim2.new(1, -118, 0.5, -17),
            size = UDim2.fromOffset(106, 34),
            textSize = 11,
            onActivated = function()
                raidPreviewApi:Update({
                    active = true,
                    bossName = raidCfg.Name,
                    phase = math.min(idx, raidCfg.MaxPhases),
                    maxPhases = raidCfg.MaxPhases,
                    phaseTitle = pInfo.Name,
                    bossHp = math.floor(raidCfg.MaxHP * math.max(0.08, 1 - (idx - 1) * 0.28)),
                    bossMaxHp = raidCfg.MaxHP,
                    breakGauge = idx * 24,
                    purificationReady = (pInfo.Threshold == "FINISHER"),
                    shield = (selectedRaidId == "AureonSentinel" and idx == 2),
                })
            end,
        })
    end

    PremiumButton.Create(phasesPanel, {
        name = "ShowCombatHUDButton",
        label = "▶  TEST BOSS BAR ON LIVE COMBAT HUD",
        variant = "primary",
        position = UDim2.new(0, 16, 1, -54),
        size = UDim2.new(1, -32, 0, 42),
        textSize = 13,
        onActivated = function()
            PartyController.SimulateBossPhase(selectedRaidId, 1)
            ScreenRouter.Navigate(UIState.Screens.HUD)
        end,
    })

    -- Right Column (46%): 4 Celestial Anchors / Sanctuary Pillars &amp; Raid Objectives
    local rightPanel = PremiumPanel.Create(root, {
        name = "AnchorsAndObjectives",
        variant = "gold",
        title = (#raidCfg.Anchors &gt; 0) and "CELESTIAL ANCHORS &amp; RAID OBJECTIVES" or "ARENA PYLONS &amp; RAID OBJECTIVES",
        subtitle = "Protect critical conduits while maintaining party formation",
        position = UDim2.new(0.54, 14, 0, 266),
        size = UDim2.new(0.46, -34, 1, -284),
    })

    local anchorsHolder = UIFactory.Create("Frame", rightPanel, {
        Name = "AnchorsGrid",
        Position = UDim2.fromOffset(16, 68),
        Size = UDim2.new(1, -32, 0, 156),
        BackgroundTransparency = 1,
    })
    UIFactory.GridLayout(anchorsHolder, UDim2.new(0.48, 0, 0, 68), UDim2.fromOffset(10, 10))

    local anchorList = #raidCfg.Anchors &gt; 0 and raidCfg.Anchors or {
        { Id = "PylonWest", Name = "West Energy Pylon (-24)", Status = "Phase 2 Shield Conduit", Integrity = 100 },
        { Id = "PylonEast", Name = "East Energy Pylon (+24)", Status = "Phase 2 Shield Conduit", Integrity = 100 },
    }

    for idx, anc in ipairs(anchorList) do
        local aCard = UIFactory.Create("Frame", anchorsHolder, {
            Name = anc.Id,
            BackgroundColor3 = colors.BG_900,
            BorderSizePixel = 0,
            LayoutOrder = idx,
        })
        UIFactory.Corner(aCard, Theme.Radius.Small)
        local warn = anc.Integrity &lt; 85
        UIFactory.Stroke(aCard, warn and colors.ACCENT_GOLD or colors.SUCCESS, 1.2, 0.25)

        UIFactory.Icon(aCard, "Anchor", UDim2.fromOffset(10, 12), 24, warn and colors.ACCENT_GOLD or colors.ACCENT_SAPPHIRE)
        UIFactory.Label(aCard, {
            Name = "AnchorName",
            Text = anc.Name,
            Position = UDim2.fromOffset(40, 8),
            Size = UDim2.new(1, -48, 0, 20),
            TextSize = 12,
            TextColor = colors.TEXT_PRIMARY,
            Bold = true,
        })
        UIFactory.Label(aCard, {
            Name = "AnchorStatus",
            Text = string.format("%s  •  %d%%", anc.Status, anc.Integrity),
            Position = UDim2.fromOffset(40, 32),
            Size = UDim2.new(1, -48, 0, 20),
            TextSize = 11,
            TextColor = warn and colors.ACCENT_GOLD or colors.SUCCESS,
            Bold = true,
        })
    end

    local objBullets = {}
    for _, o in ipairs(raidCfg.Objectives or {}) do
        table.insert(objBullets, "• " .. o)
    end

    UIFactory.Label(rightPanel, {
        Name = "ObjectivesText",
        Text = "&lt;font color='#E4B863'&gt;&lt;b&gt;RAID CHECKLIST&lt;/b&gt;&lt;/font&gt;\n" .. table.concat(objBullets, "\n"),
        Position = UDim2.fromOffset(16, 236),
        Size = UDim2.new(1, -32, 1, -304),
        TextSize = 13,
        TextColor = colors.TEXT_PRIMARY,
        YAlign = Enum.TextYAlignment.Top,
        RichText = true,
    })

    PremiumButton.Create(rightPanel, {
        name = "TravelToBossRealm",
        label = "⚔ WARP &amp; START BOSS RUSH (" .. string.upper(selectedRaidId) .. ")",
        variant = "gold",
        position = UDim2.new(0, 16, 1, -54),
        size = UDim2.new(1, -32, 0, 42),
        textSize = 13,
        onActivated = function()
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            if remotes and remotes:FindFirstChild("EquipmentRequest") then
                remotes.EquipmentRequest:FireServer({ action = "StartBossRush", bossId = selectedRaidId })
            else
                PartyController.RequestFastTravel(raidCfg.RealmId)
            end
            ScreenRouter.Navigate(UIState.Screens.HUD)
        end,
    })

    Raid.Refs = { Root = root }
    return root
end

function Raid.Update() end

function Raid.Cleanup()
    Raid.Refs = {}
end

return Raid
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2CEDD014421749A8B76BC04461E7C1D8"><Properties><string name="Name">Settings</string><ProtectedString name="Source">-- SKYBREAK: Fragments of the Core — Screen 9: Settings &amp; Accessibility (Section 11 &amp; Section 14)
-- Location: StarterPlayer/StarterPlayerScripts/SkybreakClient/UI/Screens/Settings.lua
-- Provides live toggles for Reduced Motion, FX Quality (Low / Medium / High), Minimap Visibility,
-- Text Scale (90% / 100% / 115%), Responsive Layout Override (Auto / Desktop / Mobile), and Volume controls.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("SkybreakShared")
local Theme = require(Shared:WaitForChild("Config"):WaitForChild("Theme"))

local UIFactory = require(script.Parent.Parent:WaitForChild("UIFactory"))
local Store = require(script.Parent.Parent:WaitForChild("Store"))
local Animations = require(script.Parent.Parent:WaitForChild("Animations"))
local PremiumPanel = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("PremiumPanel"))
local PremiumButton = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("PremiumButton"))

local Settings = {
    Refs = {},
}

function Settings.Build(parent, responsiveState)
    Settings.Cleanup()
    local colors = Theme.Colors
    local view = Store.GetView()
    local s = view.settings or {}
    local isPortrait = responsiveState and responsiveState.IsPortrait

    local root = UIFactory.Create("Frame", parent, {
        Name = "SettingsScreen",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
    })

    -- Left Column: Accessibility, Motion &amp; HUD Display
    local leftCard = PremiumPanel.Create(root, {
        name = "AccessibilityCard",
        title = "ACCESSIBILITY, MOTION &amp; VFX",
        subtitle = "Reduced Motion, FX Quality &amp; Responsive Layout",
        position = UDim2.fromOffset(0, 0),
        size = isPortrait and UDim2.new(1, 0, 0.54, -8) or UDim2.new(0.5, -8, 1, 0),
    })

    local listLeft = UIFactory.Create("Frame", leftCard, {
        Name = "List",
        Position = UDim2.fromOffset(18, 62),
        Size = UDim2.new(1, -36, 1, -78),
        BackgroundTransparency = 1,
    })
    UIFactory.ListLayout(listLeft, Enum.FillDirection.Vertical, 10)

    local function createToggleRow(order, title, desc, isOn, onToggle)
        local row = UIFactory.Create("Frame", listLeft, {
            Name = "Toggle_" .. order,
            Size = UDim2.new(1, 0, 0, 62),
            BackgroundColor3 = colors.BG_900,
            BorderSizePixel = 0,
            LayoutOrder = order,
        })
        UIFactory.Corner(row, Theme.Radius.Medium)
        UIFactory.Stroke(row, isOn and colors.ACCENT_GOLD or colors.STROKE_STEEL, 1.2, 0.25)

        UIFactory.Label(row, {
            Name = "Title",
            Text = title,
            Position = UDim2.fromOffset(14, 8),
            Size = UDim2.new(1, -140, 0, 20),
            TextSize = 14,
            TextColor = colors.TEXT_PRIMARY,
            Bold = true,
