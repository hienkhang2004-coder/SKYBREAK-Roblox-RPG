    </Properties>
  <Item class="ScreenGui" referent="RBX5BDED960A81D49619D77031DCDC2EEA9"><Properties><string name="Name">SkybreakGui</string><bool name="ResetOnSpawn">false</bool><bool name="IgnoreGuiInset">true</bool><bool name="Enabled">false</bool></Properties><Item class="CanvasGroup" referent="RBXC7A471A47FA84F9B918EEE6C40F2B942"><Properties><string name="Name">MainMenu</string></Properties><Item class="Frame" referent="RBX921CB153F3494E4680BBC1A9AD30A930"><Properties><string name="Name">LogoGroup</string></Properties><Item class="ImageLabel" referent="RBX47147B8B6843404997667C56A618A7E7"><Properties><string name="Name">LogoBase</string></Properties></Item><Item class="ImageLabel" referent="RBX7E5A789EC67140608FE78086F7B3EA76"><Properties><string name="Name">LogoGlow</string></Properties></Item></Item><Item class="ImageLabel" referent="RBXEBE9DE6D38114B1B8C72131FB50A0947"><Properties><string name="Name">CorePulse</string></Properties></Item><Item class="Frame" referent="RBX940B5F9BD79D4450B77C97FFC9826A40"><Properties><string name="Name">ButtonColumn</string></Properties><Item class="ImageButton" referent="RBX31476C516A144084805BB5249859A057"><Properties><string name="Name">PlayButton</string></Properties><Item class="UIScale" referent="RBXD92E383305134D11A14D4EDBA525BA33"><Properties><string name="Name">UIScale</string></Properties></Item><Item class="UIStroke" referent="RBXB26A8F160C6A4AD9A367386D069473E3"><Properties><string name="Name">UIStroke</string></Properties></Item></Item><Item class="ImageButton" referent="RBX9B621E3484F74EE2ABF5565F53E53F65"><Properties><string name="Name">ContinueButton</string></Properties></Item><Item class="ImageButton" referent="RBXE38225C8B1234109915B1065034551DF"><Properties><string name="Name">RealmSelectButton</string></Properties></Item><Item class="ImageButton" referent="RBXD0C20A80878A41E1B2C74FFBCA41FD53"><Properties><string name="Name">SettingsButton</string></Properties></Item></Item></Item><Item class="Frame" referent="RBXD7D49864C6894A71974B7E2DBEA90024"><Properties><string name="Name">CombatHUD</string></Properties><Item class="Frame" referent="RBX0A700C6A49F74EB1A2471BA1E971CE7F"><Properties><string name="Name">VitalsCard</string></Properties><Item class="Frame" referent="RBX5A14DCF57C484EBCB25449E6F32E370E"><Properties><string name="Name">HPBar</string></Properties></Item><Item class="Frame" referent="RBX99A2C08FF7E546DE93F659D348C1A0AD"><Properties><string name="Name">EnergyBar</string></Properties></Item><Item class="Frame" referent="RBXD6756648383B4D8EB5CF37085FAE4462"><Properties><string name="Name">EXPBar</string></Properties></Item></Item><Item class="Frame" referent="RBX0B94E536B0D64CB9866CD7B03F6F8021"><Properties><string name="Name">QuestTracker</string></Properties></Item><Item class="Frame" referent="RBX5CFF2D20B4D74A39BA338C3CEBEC95C3"><Properties><string name="Name">MinimapCard</string></Properties></Item><Item class="Frame" referent="RBX8518F45108714C3D8F5BF18595F2A110"><Properties><string name="Name">SkillHotbar</string></Properties><Item class="ImageButton" referent="RBX2CB45268255B4B7FA27A7FFFEF769758"><Properties><string name="Name">Slot1</string></Properties></Item><Item class="ImageButton" referent="RBX8115D161C96A4D97B3EED5EC127F989A"><Properties><string name="Name">Slot2</string></Properties></Item><Item class="ImageButton" referent="RBX689CF3FB82A14202826D7080FB679B6D"><Properties><string name="Name">Slot3</string></Properties></Item><Item class="ImageButton" referent="RBX13DDF7DB02724642A1A8C6F2C5ACB6B3"><Properties><string name="Name">DodgeSlot</string></Properties></Item><Item class="ImageButton" referent="RBX19254D4A21C043D5BD1681243CC5D19F"><Properties><string name="Name">UltimateSlot</string></Properties><Item class="ImageLabel" referent="RBX9D9197EAE0584AF2BCFF23378745FC9A"><Properties><string name="Name">UltimateRing</string></Properties></Item></Item></Item><Item class="CanvasGroup" referent="RBX8805DEAFD42E4C3A9B98280064F2EDA5"><Properties><string name="Name">BossWarningBanner</string></Properties></Item></Item><Item class="CanvasGroup" referent="RBX85F098C95E2C4E15BACFD6C0F6D9D0C6"><Properties><string name="Name">InventoryPanel</string></Properties><Item class="Frame" referent="RBX089339AEC4BE457B850576387D166A73"><Properties><string name="Name">CharacterPreview</string></Properties><Item class="ViewportFrame" referent="RBX0D3C5F90EC51487BA917339B9EDC4158"><Properties><string name="Name">ViewportFrame</string></Properties><Item class="WorldModel" referent="RBX19FB3836B50241778EC94443DA67404D"><Properties><string name="Name">WorldModel</string></Properties></Item><Item class="Camera" referent="RBX2CF8089E9F104F2DAC86573E6E56D341"><Properties><string name="Name">PreviewCamera</string></Properties></Item></Item></Item><Item class="Frame" referent="RBXE7AAC776D20E45A2BF8550586D372829"><Properties><string name="Name">EquipSlots</string></Properties></Item><Item class="ScrollingFrame" referent="RBXB186089EBF184395845DF53647B1CF01"><Properties><string name="Name">ItemGrid</string></Properties></Item><Item class="CanvasGroup" referent="RBX351535F5079A472CBFF4BA61B6381541"><Properties><string name="Name">TooltipCard</string></Properties></Item></Item><Item class="CanvasGroup" referent="RBX599C95807E1E4AEEB823286B668CF358"><Properties><string name="Name">SkillsPanel</string></Properties><Item class="Frame" referent="RBX1426A8820F7C49959B531D7A1A92F24B"><Properties><string name="Name">ClassTabs</string></Properties></Item><Item class="Frame" referent="RBXC3A5BEF8DEE34553BD98CA2657F7BB36"><Properties><string name="Name">NodeCanvas</string></Properties></Item><Item class="Frame" referent="RBX6C38F44CA77C4880962A2DB89A632CE5"><Properties><string name="Name">SkillDetailCard</string></Properties></Item></Item><Item class="CanvasGroup" referent="RBX6F10DECAA6CB402FA8F2D6984F8C90ED"><Properties><string name="Name">WorldMapPanel</string></Properties><Item class="Frame" referent="RBXC0A67F81DDB043EC93764F1CE7200765"><Properties><string name="Name">MapCanvas</string></Properties></Item><Item class="Frame" referent="RBX00C45FF2363E4A1B9D9E345284349E26"><Properties><string name="Name">RegionDetailCard</string></Properties></Item><Item class="ImageButton" referent="RBX0EBE623E42E04B10A9E4C21A5CC8B518"><Properties><string name="Name">FastTravelButton</string></Properties></Item></Item><Item class="CanvasGroup" referent="RBX65EDBDDD15234C6B8561E5F9832D14AE"><Properties><string name="Name">ForgePanel</string></Properties><Item class="Frame" referent="RBX93F13D3E47D7481D946F20616AE2F1DE"><Properties><string name="Name">WeaponPreview</string></Properties><Item class="ViewportFrame" referent="RBX1574F7B32C034E3D93629D9E7AD67EBF"><Properties><string name="Name">ViewportFrame</string></Properties><Item class="WorldModel" referent="RBX64E8F55859FD40229C03F4CCCDE7552F"><Properties><string name="Name">WorldModel</string></Properties></Item><Item class="Camera" referent="RBXB79004077951404DB2C377285C11AC83"><Properties><string name="Name">PreviewCamera</string></Properties></Item></Item></Item><Item class="Frame" referent="RBX5FA9E23448CB4C2F8853F65314C4F887"><Properties><string name="Name">MaterialSlots</string></Properties></Item><Item class="ImageButton" referent="RBXD7EF8FBDDA1546FAB9F6C28228E1E46E"><Properties><string name="Name">CraftButton</string></Properties></Item></Item><Item class="CanvasGroup" referent="RBXC3A0CF50CA3E46E2922CAA1DD4FED05A"><Properties><string name="Name">DialoguePanel</string></Properties></Item><Item class="CanvasGroup" referent="RBX0A88189F83034F638A8FBA2B3F41DD4A"><Properties><string name="Name">RaidHUD</string></Properties></Item><Item class="CanvasGroup" referent="RBX81EC0CC515BC458BB2961CCC8A1EB905"><Properties><string name="Name">SettingsPanel</string></Properties></Item></Item></Item>
  <Item class="ServerStorage" referent="RBX15">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
  <Item class="Folder" referent="RBXF0E0C7DA55E540A6AA019BC5F56C2D7A"><Properties><string name="Name">SkybornMeshSources</string></Properties><Item class="ModuleScript" referent="RBXA68F588850CA4615A7FFD23721EB2A89"><Properties><string name="Name">Importer</string><ProtectedString name="Source">-- Native import of evaluated Blender meshes. Staged only, never replaces a live prefab.
local Asset=game:GetService('AssetService')
local M={}
local function cf(a) return CFrame.new(table.unpack(a)) end
local function v(a) return Vector3.new(a[1],a[2],a[3]) end
local function baked(editable)
    local status,content=Asset:CreateDataModelContentAsync(Content.fromObject(editable))
    assert(status==Enum.CreateContentResult.Success,tostring(status))
    return content
end
local function srgb(x) return x&lt;=.0031308 and x*12.92 or 1.055*x^(1/2.4)-.055 end
local function image4(r,g,b,a)
    local im=Asset:CreateEditableImage({Size=Vector2.one})
    local bytes=buffer.create(4)
    for i,n in ipairs({r,g,b,a or 1}) do buffer.writeu8(bytes,i-1,math.clamp(math.floor(n*255+.5),0,255)) end
    im:WritePixelsBuffer(Vector2.zero,Vector2.one,bytes)
    return im
end
function M.Begin(data)
    local storage=game:GetService('ServerStorage')
    local folder=storage:FindFirstChild('SkybornStaging')
    if not folder then folder=Instance.new('Folder');folder.Name='SkybornStaging';folder.Parent=storage end
    local name=data.gender..'_'..data.preset
    assert(not folder:FindFirstChild(name),'Staging model already exists: '..name)
    local model=Instance.new('Model');model.Name=name
    model:SetAttribute('SourceSHA256',data.source_sha256)
    model:SetAttribute('Gender',data.gender);model:SetAttribute('OutfitStage',data.preset)
    model:SetAttribute('ImportStatus','Building');model:SetAttribute('SourceHeight',data.height_m)
    local root=Instance.new('Part');root.Name='RootPart';root.Size=Vector3.one*.1
    root.Transparency=1;root.Anchored=true;root.CanCollide=false;root.CanQuery=false;root.CanTouch=false
    root.Parent=model;model.PrimaryPart=root;model.WorldPivot=CFrame.identity
    local nodes={}
    for _,b in data.bones do
        local bone=Instance.new('Bone');bone.Name=b.name;bone.CFrame=cf(b['local'])
        bone.Parent=b.parent and assert(nodes[b.parent],b.parent) or root;nodes[b.name]=bone
    end
    model.Parent=folder
    return name
end
function M.Mesh(name,data,bones)
    local model=assert(game.ServerStorage.SkybornStaging:FindFirstChild(name),name)
    assert(not model:FindFirstChild(data.name),'Duplicate mesh '..data.name)
    local low=Vector3.new(math.huge,math.huge,math.huge);local high=-low
    for _,xyz in data.vertices do local p=v(xyz);low=low:Min(p);high=high:Max(p) end
    local center=(low+high)/2
    local e=assert(Asset:CreateEditableMesh(),'EditableMesh allocation failed')
    local boneids={}
    for _,b in bones do
        boneids[b.name]=e:AddBone({Name=b.name,CFrame=CFrame.new(-center)*cf(b.bind_world),Virtual=false,ParentId=b.parent and boneids[b.parent] or nil})
    end
    local ids={}
    for i,xyz in data.vertices do
        local id=e:AddVertex(v(xyz)-center);ids[i]=id
        local joints,weights={},{}
        for _,pair in data.weights[i] do table.insert(joints,assert(boneids[pair[1]]));table.insert(weights,pair[2]) end
        e:SetVertexBones(id,joints);e:SetVertexBoneWeights(id,weights)
        if i%1000==0 then task.wait() end
    end
    local uv=e:AddUV(Vector2.new(.5,.5))
    local normals={}
    for i,t in data.triangles do
        local face=e:AddTriangle(ids[t[1]+1],ids[t[2]+1],ids[t[3]+1])
        local ns={}
        for j,xyz in data.normals[i] do
            local key=table.concat(xyz,',');local id=normals[key]
            if not id then id=e:AddNormal(v(xyz));normals[key]=id end;ns[j]=id
        end
        e:SetFaceNormals(face,ns);e:SetFaceUVs(face,{uv,uv,uv})
        if i%1000==0 then task.wait() end
    end
    local content=baked(e)
    local part=Asset:CreateMeshPartAsync(content,{CollisionFidelity=Enum.CollisionFidelity.Box})
    part.Name=data.name;part.CFrame=CFrame.new(center);part.Anchored=true
    part.CanCollide=false;part.CanTouch=false;part.CanQuery=false;part.Massless=true
    part:SetAttribute('SourceVertices',#data.vertices);part:SetAttribute('SourceTriangles',#data.triangles)
    part:SetAttribute('EquipmentRole',data.role);part:SetAttribute('BlenderMaterial',data.material.name)
    part:SetAttribute('SourceParts',table.concat(data.source_parts,';'))
    local mat=data.material;local color=mat.color_linear
    part:SetAttribute('SkybornMaterialJSON',game.HttpService:JSONEncode(mat))
    if mat.emission_strength&gt;0 then
        local em=mat.emission_linear
        part.Color=Color3.new(srgb(em[1]),srgb(em[2]),srgb(em[3]));part.Material=Enum.Material.Neon
    elseif game:GetService('RunService'):IsRunning() then
        -- Persistent input values replicate; each client builds its local editable PBR maps.
        -- Map Content setters themselves are Studio-plugin-only.
        part.Color=Color3.new(srgb(color[1]),srgb(color[2]),srgb(color[3]))
        part.Material=mat.metalness&gt;.5 and Enum.Material.Metal or Enum.Material.SmoothPlastic
    else
        M.Materials=M.Materials or {}
        local key=game:GetService('HttpService'):JSONEncode(mat)
        if not M.Materials[key] then
            local col=image4(srgb(color[1]),srgb(color[2]),srgb(color[3]),color[4])
            local rough=image4(mat.roughness,mat.roughness,mat.roughness)
            local metal=image4(mat.metalness,mat.metalness,mat.metalness)
            local sa=Asset:CreateSurfaceAppearanceAsync({ColorMap=Content.fromObject(col),RoughnessMap=Content.fromObject(rough),MetalnessMap=Content.fromObject(metal)})
            sa.ColorMapContent=baked(col);sa.RoughnessMapContent=baked(rough);sa.MetalnessMapContent=baked(metal)
            col:Destroy();rough:Destroy();metal:Destroy();M.Materials[key]=sa
        end
        M.Materials[key]:Clone().Parent=part;part.Color=Color3.new(1,1,1);part.Material=Enum.Material.SmoothPlastic
    end
    part.Transparency=1-color[4]*(mat.alpha or 1)
    part.Parent=model;e:Destroy()
    return {name=part.Name,skinned=part.HasSkinnedMesh,vertices=#ids,triangles=#data.triangles,size={part.Size.X,part.Size.Y,part.Size.Z},content=tostring(part.MeshContent)}
end
function M.Finish(name,expected)
    local model=assert(game.ServerStorage.SkybornStaging:FindFirstChild(name))
    local meshes,bones,vertices,triangles=0,0,0,0
    for _,o in model:GetDescendants() do
        if o:IsA('Bone') then bones+=1 end
        if o:IsA('MeshPart') then
            assert(o.HasSkinnedMesh,o.Name);meshes+=1;vertices+=o:GetAttribute('SourceVertices');triangles+=o:GetAttribute('SourceTriangles')
            local w=Instance.new('WeldConstraint');w.Part0=model.PrimaryPart;w.Part1=o;w.Parent=o
        end
    end
    assert(meshes==expected and bones==19,'Incomplete imported model')
    model:SetAttribute('ImportStatus','ImportedPendingVisualPersistenceQA')
    return {name=name,meshes=meshes,bones=bones,vertices=vertices,triangles=triangles}
end
return M
</ProtectedString></Properties></Item></Item></Item>
  <Item class="Lighting" referent="RBX16">
