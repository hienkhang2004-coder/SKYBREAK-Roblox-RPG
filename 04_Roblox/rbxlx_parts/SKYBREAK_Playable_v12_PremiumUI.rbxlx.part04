  <Item class="ServerScriptService" referent="RBX5">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX6">
      <Properties>
        <string name="Name">ServerBootstrap</string>
        <ProtectedString name="Source">local rs=game:GetService("ReplicatedStorage")
local remotes=rs:FindFirstChild("Remotes") or Instance.new("Folder",rs) remotes.Name="Remotes"
for _,name in ipairs({"CombatRequest","AbilityRequest","InteractRequest","EquipmentRequest","StateUpdate","CombatFX","AppearanceRequest"}) do
    if not remotes:FindFirstChild(name) then local event=Instance.new("RemoteEvent") event.Name=name event.Parent=remotes end
end
require(script.Parent.Services.SkybornMeshService).Start()
require(script.Parent.Services.GameService).Start()

require(script.Parent.Services.EnvironmentService).Apply("GoldenSky")
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Folder" referent="RBX7">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX8">
        <Properties>
          <string name="Name">GameService</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local Debris=game:GetService("Debris")
local TweenService=game:GetService("TweenService")
local RunService=game:GetService("RunService")
local C=require(game.ReplicatedStorage.Shared.Config)
local D=require(script.Parent.PlayerDataService)
local W=require(script.Parent.WorldService)
local Cosmetics=require(script.Parent.CosmeticService)
local G={Runtime={},Enemies={},Boss=nil,Preparing=false,ResetAt=0,Chests={},Shrines={},JumpPads={},WorldPortals={}}
local R=game.ReplicatedStorage.Remotes
if not R:FindFirstChild("CombatEvent") then
	local ce=Instance.new("RemoteEvent")
	ce.Name="CombatEvent"
	ce.Parent=R
