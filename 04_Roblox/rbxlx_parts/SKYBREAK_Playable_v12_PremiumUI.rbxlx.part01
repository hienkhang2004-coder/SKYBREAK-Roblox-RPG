C.FastTravel = {}
C.FastTravelOrder = {}
for _, isl in ipairs(islandList) do
    C.FastTravel[isl.Id] = isl
    table.insert(C.FastTravelOrder, isl.Id)
end
C.Islands = setmetatable(islandList, {
    __index = function(_, k)
        return C.FastTravel[k]
    end,
})

