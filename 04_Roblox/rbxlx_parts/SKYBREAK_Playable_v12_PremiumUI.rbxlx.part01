local recipeById = {}
for _, r in ipairs(recipeList) do
    recipeById[r.Id] = r
end
C.ForgeRecipes = setmetatable(recipeList, {
    __index = function(_, k)
        return recipeById[k]
    end
})

-- Sequential Main Storyline Quests (Q01 -&gt; Q14) across all 8 Realms (Lv. 1 -&gt; Lv. 2550 MAX).
