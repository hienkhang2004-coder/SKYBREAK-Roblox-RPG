      <Item class="ModuleScript" referent="RBXDA0BAEE83F3F41B3BAD433AF449A9194">
        <Properties>
          <string name="Name">RealmEnvironment</string>
          <ProtectedString name="Source">local E={}
local goldenSky={lf="rbxassetid://125580929564532",up="rbxassetid://127430124985900",bk="rbxassetid://134226231755373",ft="rbxassetid://93641632642731",rt="rbxassetid://139087821108688",dn="rbxassetid://94264818636230"}
local frozenSky={bk="rbxassetid://130166325051175",lf="rbxassetid://134595860932390",up="rbxassetid://76551248708701",dn="rbxassetid://73836580094387",ft="rbxassetid://121870448069569",rt="rbxassetid://88459308214078"}
local shadowSky={ft="rbxassetid://139181899969965",bk="rbxassetid://80772803029327",up="rbxassetid://137756491511210",lf="rbxassetid://111204609743343",dn="rbxassetid://70710544916823",rt="rbxassetid://100462189328496"}
E.Skyboxes={
GoldenSky=goldenSky,
FrozenCyber=frozenSky,
ShadowRealm=shadowSky,
VerdantCrown=goldenSky,
EmberforgeWastes=shadowSky,
AbyssalTides=frozenSky,
ChronosBastion=goldenSky,
VeilsEnd=shadowSky,
}
local presets={
GoldenSky={Clock=14.2,Brightness=2.25,Ambient=Color3.fromRGB(138,148,168),Outdoor=Color3.fromRGB(178,188,208),Fog=Color3.fromRGB(215,228,245),Decay=Color3.fromRGB(225,205,175),Density=.36,Haze=2.15,Offset=.20,Glare=.14,FogStart=135,FogEnd=450,Tint=Color3.fromRGB(255,250,242),Contrast=.05,Bloom=.04},
FrozenCyber={Clock=13.5,Brightness=2.05,Ambient=Color3.fromRGB(115,138,172),Outdoor=Color3.fromRGB(148,176,212),Fog=Color3.fromRGB(162,198,238),Decay=Color3.fromRGB(98,136,188),Density=.38,Haze=2.25,Offset=.22,Glare=.16,FogStart=125,FogEnd=430,Tint=Color3.fromRGB(235,246,255),Contrast=.05,Bloom=.04},
ShadowRealm={Clock=15.0,Brightness=1.95,Ambient=Color3.fromRGB(122,92,138),Outdoor=Color3.fromRGB(156,118,172),Fog=Color3.fromRGB(148,96,152),Decay=Color3.fromRGB(88,52,98),Density=.39,Haze=2.30,Offset=.22,Glare=.15,FogStart=120,FogEnd=420,Tint=Color3.fromRGB(248,232,255),Contrast=.05,Bloom=.04},
VerdantCrown={Clock=14.0,Brightness=2.15,Ambient=Color3.fromRGB(118,152,136),Outdoor=Color3.fromRGB(158,192,174),Fog=Color3.fromRGB(198,232,214),Decay=Color3.fromRGB(150,196,170),Density=.36,Haze=2.15,Offset=.20,Glare=.14,FogStart=135,FogEnd=450,Tint=Color3.fromRGB(242,255,246),Contrast=.04,Bloom=.04},
EmberforgeWastes={Clock=15.5,Brightness=2.10,Ambient=Color3.fromRGB(152,118,108),Outdoor=Color3.fromRGB(192,148,134),Fog=Color3.fromRGB(216,154,132),Decay=Color3.fromRGB(154,94,74),Density=.38,Haze=2.25,Offset=.22,Glare=.16,FogStart=125,FogEnd=430,Tint=Color3.fromRGB(255,238,226),Contrast=.05,Bloom=.04},
AbyssalTides={Clock=13.8,Brightness=2.05,Ambient=Color3.fromRGB(108,142,168),Outdoor=Color3.fromRGB(142,178,208),Fog=Color3.fromRGB(158,202,236),Decay=Color3.fromRGB(94,142,188),Density=.38,Haze=2.25,Offset=.22,Glare=.15,FogStart=125,FogEnd=430,Tint=Color3.fromRGB(232,248,255),Contrast=.05,Bloom=.04},
ChronosBastion={Clock=14.5,Brightness=2.15,Ambient=Color3.fromRGB(138,134,162),Outdoor=Color3.fromRGB(178,172,202),Fog=Color3.fromRGB(212,206,238),Decay=Color3.fromRGB(168,154,202),Density=.36,Haze=2.15,Offset=.20,Glare=.14,FogStart=135,FogEnd=450,Tint=Color3.fromRGB(248,244,255),Contrast=.04,Bloom=.04},
VeilsEnd={Clock=15.2,Brightness=1.95,Ambient=Color3.fromRGB(128,102,152),Outdoor=Color3.fromRGB(164,132,192),Fog=Color3.fromRGB(154,118,188),Decay=Color3.fromRGB(96,68,132),Density=.39,Haze=2.30,Offset=.22,Glare=.16,FogStart=120,FogEnd=420,Tint=Color3.fromRGB(244,230,255),Contrast=.05,Bloom=.04},
}
function E.Apply(name)
 local p=presets[name] or presets.GoldenSky local images=E.Skyboxes[name] or E.Skyboxes.GoldenSky
 local lighting=game:GetService("Lighting")
 for _,child in ipairs(lighting:GetChildren()) do
  if (child:IsA("BloomEffect") and child.Name~="SkybreakBloom") or (child:IsA("ColorCorrectionEffect") and child.Name~="SkybreakGrade") or (child:IsA("DepthOfFieldEffect") and child.Name~="SkybreakDistanceDOF") or child:IsA("ColorGradingEffect") or child:IsA("SunRaysEffect") then
   if child:IsA("PostEffect") then child.Enabled=false end
   child:Destroy()
  end
 end
 local sky=lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky",lighting) sky.Name="SKYBREAK_RealmSky"
 sky.SkyboxFt=images.ft sky.SkyboxBk=images.bk sky.SkyboxLf=images.lf sky.SkyboxRt=images.rt sky.SkyboxUp=images.up sky.SkyboxDn=images.dn
 sky.CelestialBodiesShown=true sky.StarCount=0
 lighting.ClockTime=p.Clock lighting.Brightness=p.Brightness lighting.Ambient=p.Ambient lighting.OutdoorAmbient=p.Outdoor
 lighting.EnvironmentDiffuseScale=.75 lighting.EnvironmentSpecularScale=.50 lighting.ExposureCompensation=.12 lighting.ShadowSoftness=.25
 lighting.FogColor=p.Fog lighting.FogStart=p.FogStart or 135 lighting.FogEnd=p.FogEnd or 450
 local atmosphere=lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere",lighting)
 atmosphere.Color=p.Fog atmosphere.Decay=p.Decay atmosphere.Density=p.Density or .37 atmosphere.Offset=p.Offset or .20 atmosphere.Haze=p.Haze or 2.2 atmosphere.Glare=p.Glare or .14
 local dof=lighting:FindFirstChild("SkybreakDistanceDOF") or Instance.new("DepthOfFieldEffect",lighting)
 dof.Name="SkybreakDistanceDOF" dof.Enabled=true dof.FarIntensity=.26 dof.FocusDistance=140 dof.InFocusRadius=160 dof.NearIntensity=0
 local grade=lighting:FindFirstChild("SkybreakGrade") or Instance.new("ColorCorrectionEffect",lighting) grade.Name="SkybreakGrade" grade.Brightness=.04 grade.TintColor=p.Tint grade.Contrast=p.Contrast grade.Saturation=.12
 local bloom=lighting:FindFirstChild("SkybreakBloom") or Instance.new("BloomEffect",lighting) bloom.Name="SkybreakBloom" bloom.Intensity=p.Bloom bloom.Size=18 bloom.Threshold=2.4
 lighting:SetAttribute("SkybreakEnvironment",name)
 return name
end
return E
</ProtectedString>
        </Properties>
      </Item>
    </Item>
