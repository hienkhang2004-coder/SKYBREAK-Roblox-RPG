        Objectives={{Kind="Kill", Target="CryonPrime", Count=1, Label="Đánh bại Boss Cryon Prime"}}},

    -- CHƯƠNG 3: SHADOW REALM (Lv. 20 - 30)
    {Id="Q09", Name="Quân Đoàn Bóng Đêm", Realm="ShadowRealm", Level=19, XP=7500, Gold=3500, CoreShards=600,
        Text="Bước qua cổng Hư Không vào Shadow Realm. Hãy thanh trừng 3 Void Marauder và 2 Kỵ Sĩ Hắc Ám Abyssal Dreadknight.",
        Objectives={{Kind="Kill", Target="VoidPirate", Count=3, Label="Hạ gục Void Marauder"}, {Kind="Kill", Target="AbyssalKnight", Count=2, Label="Hạ gục Abyssal Dreadknight"}}},
    {Id="Q10", Name="Săn Lùng Thủy Tổ Hư Không", Realm="ShadowRealm", Level=23, XP=9500, Gold=5000, CoreShards=750,
        Text="Tiến vào Vực Thẳm Leviathan (hoặc Điện Thờ Lõi) tại Shadow Realm và đánh bại Thủy Tổ ABYSSAL LEVIATHAN hoặc SOUL REAPER.",
        Objectives={{Kind="Kill", Target="AbyssalLeviathan", Count=1, Label="Đánh bại Abyssal Leviathan / Soul Reaper"}}},
    {Id="Q11", Name="Chúa Tể Hư Không (Boss Chương 3)", Realm="ShadowRealm", Level=26, XP=12500, Gold=7000, CoreShards=1000,
        Text="Đối mặt với NOXAR • THE VOID SOVEREIGN tại Đấu Trường Hắc Tinh. Phá hủy Void Singularity để đoạt lấy Song Kiếm Huyền Thoại!",
        Objectives={{Kind="Kill", Target="Noxar", Count=1, Label="Đánh bại Boss Noxar • Void Sovereign"}}},

    -- CHƯƠNG 4 - 5: CÁC CÕI GIỚI THƯỢNG CỔ &amp; CHUNG CUỘC (Lv. 30 - 100)
    {Id="Q12", Name="Thức Tỉnh Nguyên Tố Cổ Đại (Chương 4)", Realm="VerdantCrown", Level=30, XP=18000, Gold=10000, CoreShards=1400,
        Text="Dịch chuyển tới Verdant Crown và Emberforge Wastes để chinh phục Đại Cổ Thụ SYLVARIS cùng Titan Lửa IGNIVAR.",
        Objectives={{Kind="Kill", Target="Sylvaris", Count=1, Label="Đánh bại Sylvaris (Verdant Crown)"}, {Kind="Kill", Target="Ignivar", Count=1, Label="Đánh bại Ignivar (Emberforge Wastes)"}}},
    {Id="Q13", Name="Vượt Qua Dòng Chảy Thời Gian (Chương 5)", Realm="ChronosBastion", Level=40, XP=28000, Gold=16000, CoreShards=2000,
        Text="Tiến vào Abyssal Tides và Chronos Bastion để đánh bại Thủy Hoàng NERITH và Pháp Vương Thời Gian AION.",
        Objectives={{Kind="Kill", Target="Nerith", Count=1, Label="Đánh bại Nerith (Abyssal Tides)"}, {Kind="Kill", Target="Aion", Count=1, Label="Đánh bại Aion (Chronos Bastion)"}}},
    {Id="Q14", Name="Đấng Kiến Tạo Đầu Tiên (Chung Cuộc)", Realm="VeilsEnd", Level=55, XP=50000, Gold=30000, CoreShards=3500,
        Text="Bước lên Đỉnh Phán Quyết tại Veil's End và đánh bại Boss tối thượng VEYR • ĐẤNG KIẾN TẠO ĐẦU TIÊN để thống nhất bầu trời!",
        Objectives={{Kind="Kill", Target="Veyr", Count=1, Label="Đánh bại Final Boss Veyr (Veil's End)"}}},
}

return C
</ProtectedString>
        </Properties>
      </Item>
    <Item class="ModuleScript" referent="RBX2469364D45774605B96DDFE21BFA5649"><Properties><string name="Name">RealmConfig</string><ProtectedString name="Source">-- World coordinates are separated; each client's environment follows CurrentRealm.
return {
    GoldenSky={Origin=Vector3.zero,Spawn=Vector3.new(-92,42,153),Available=true},
    FrozenCyber={Origin=Vector3.new(2500,0,0),Spawn=Vector3.new(2390,46,155),Available=true},
    ShadowRealm={Origin=Vector3.new(-2500,0,0),Spawn=Vector3.new(-2570,58,125),Available=true},
    VerdantCrown={Origin=Vector3.new(0,120,-2400),Spawn=Vector3.new(0,124,-2364),Available=true},
    EmberforgeWastes={Origin=Vector3.new(2400,120,-2400),Spawn=Vector3.new(2400,124,-2362),Available=true},
    AbyssalTides={Origin=Vector3.new(-2400,120,-2400),Spawn=Vector3.new(-2400,124,-2428),Available=true},
    ChronosBastion={Origin=Vector3.new(0,180,-4200),Spawn=Vector3.new(0,184,-4168),Available=true},
    VeilsEnd={Origin=Vector3.new(0,260,-5800),Spawn=Vector3.new(0,264,-5780),Available=true},
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXDA0BAEE83F3F41B3BAD433AF449A9194"><Properties><string name="Name">RealmEnvironment</string><ProtectedString name="Source">local E={}
local goldenSky={lf="rbxassetid://125580929564532",up="rbxassetid://127430124985900",bk="rbxassetid://134226231755373",ft="rbxassetid://93641632642731",rt="rbxassetid://139087821108688",dn="rbxassetid://94264818636230"}
local frozenSky={bk="rbxassetid://130166325051175",lf="rbxassetid://134595860932390",up="rbxassetid://76551248708701",dn="rbxassetid://73836580094387",ft="rbxassetid://121870448069569",rt="rbxassetid://88459308214078"}
local shadowSky={ft="rbxassetid://139181899969965",bk="rbxassetid://80772803029327",up="rbxassetid://137756491511210",lf="rbxassetid://111204609743343",dn="rbxassetid://70710544916823",rt="rbxassetid://100462189328496"}
E.Skyboxes={
GoldenSky=goldenSky,
FrozenCyber=frozenSky,
ShadowRealm=shadowSky,
VerdantCrown=goldenSky,
EmberforgeWastes=shadowSky,
AbyssalTides=frozenSky,
ChronosBastion=goldenSky,
VeilsEnd=shadowSky,
}
local presets={
GoldenSky={Clock=14.2,Brightness=2.25,Ambient=Color3.fromRGB(138,148,168),Outdoor=Color3.fromRGB(178,188,208),Fog=Color3.fromRGB(215,228,245),Decay=Color3.fromRGB(225,205,175),Density=.08,Haze=0,Tint=Color3.fromRGB(255,250,242),Contrast=.05,Bloom=.04},
FrozenCyber={Clock=13.5,Brightness=2.05,Ambient=Color3.fromRGB(115,138,172),Outdoor=Color3.fromRGB(148,176,212),Fog=Color3.fromRGB(162,198,238),Decay=Color3.fromRGB(98,136,188),Density=.09,Haze=0,Tint=Color3.fromRGB(235,246,255),Contrast=.05,Bloom=.04},
ShadowRealm={Clock=15.0,Brightness=1.95,Ambient=Color3.fromRGB(122,92,138),Outdoor=Color3.fromRGB(156,118,172),Fog=Color3.fromRGB(148,96,152),Decay=Color3.fromRGB(88,52,98),Density=.09,Haze=0,Tint=Color3.fromRGB(248,232,255),Contrast=.05,Bloom=.04},
VerdantCrown={Clock=14.0,Brightness=2.15,Ambient=Color3.fromRGB(118,152,136),Outdoor=Color3.fromRGB(158,192,174),Fog=Color3.fromRGB(198,232,214),Decay=Color3.fromRGB(150,196,170),Density=.08,Haze=0,Tint=Color3.fromRGB(242,255,246),Contrast=.04,Bloom=.04},
EmberforgeWastes={Clock=15.5,Brightness=2.10,Ambient=Color3.fromRGB(152,118,108),Outdoor=Color3.fromRGB(192,148,134),Fog=Color3.fromRGB(216,154,132),Decay=Color3.fromRGB(154,94,74),Density=.09,Haze=0,Tint=Color3.fromRGB(255,238,226),Contrast=.05,Bloom=.04},
AbyssalTides={Clock=13.8,Brightness=2.05,Ambient=Color3.fromRGB(108,142,168),Outdoor=Color3.fromRGB(142,178,208),Fog=Color3.fromRGB(158,202,236),Decay=Color3.fromRGB(94,142,188),Density=.09,Haze=0,Tint=Color3.fromRGB(232,248,255),Contrast=.05,Bloom=.04},
ChronosBastion={Clock=14.5,Brightness=2.15,Ambient=Color3.fromRGB(138,134,162),Outdoor=Color3.fromRGB(178,172,202),Fog=Color3.fromRGB(212,206,238),Decay=Color3.fromRGB(168,154,202),Density=.08,Haze=0,Tint=Color3.fromRGB(248,244,255),Contrast=.04,Bloom=.04},
VeilsEnd={Clock=15.2,Brightness=1.95,Ambient=Color3.fromRGB(128,102,152),Outdoor=Color3.fromRGB(164,132,192),Fog=Color3.fromRGB(154,118,188),Decay=Color3.fromRGB(96,68,132),Density=.09,Haze=0,Tint=Color3.fromRGB(244,230,255),Contrast=.05,Bloom=.04},
}
function E.Apply(name)
 local p=presets[name] or presets.GoldenSky local images=E.Skyboxes[name] or E.Skyboxes.GoldenSky
 local lighting=game:GetService("Lighting")
 for _,child in ipairs(lighting:GetChildren()) do
  if (child:IsA("BloomEffect") and child.Name~="SkybreakBloom") or (child:IsA("ColorCorrectionEffect") and child.Name~="SkybreakGrade") or child:IsA("ColorGradingEffect") or child:IsA("SunRaysEffect") then
   if child:IsA("PostEffect") then child.Enabled=false end
   child:Destroy()
  end
 end
 local sky=lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky",lighting) sky.Name="SKYBREAK_RealmSky"
 sky.SkyboxFt=images.ft sky.SkyboxBk=images.bk sky.SkyboxLf=images.lf sky.SkyboxRt=images.rt sky.SkyboxUp=images.up sky.SkyboxDn=images.dn
 sky.CelestialBodiesShown=true sky.StarCount=0
 lighting.ClockTime=p.Clock lighting.Brightness=p.Brightness lighting.Ambient=p.Ambient lighting.OutdoorAmbient=p.Outdoor
 lighting.EnvironmentDiffuseScale=.75 lighting.EnvironmentSpecularScale=.50 lighting.ExposureCompensation=.12 lighting.ShadowSoftness=.25
 local atmosphere=lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere",lighting)
 atmosphere.Color=p.Fog atmosphere.Decay=p.Decay atmosphere.Density=p.Density atmosphere.Offset=.10 atmosphere.Haze=p.Haze atmosphere.Glare=0
 local grade=lighting:FindFirstChild("SkybreakGrade") or Instance.new("ColorCorrectionEffect",lighting) grade.Name="SkybreakGrade" grade.Brightness=.04 grade.TintColor=p.Tint grade.Contrast=p.Contrast grade.Saturation=.12
 local bloom=lighting:FindFirstChild("SkybreakBloom") or Instance.new("BloomEffect",lighting) bloom.Name="SkybreakBloom" bloom.Intensity=p.Bloom bloom.Size=18 bloom.Threshold=2.4
 lighting:SetAttribute("SkybreakEnvironment",name)
 return name
end
return E
</ProtectedString></Properties></Item></Item>
